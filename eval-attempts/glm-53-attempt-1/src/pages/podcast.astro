---
import BaseLayout from '../layouts/BaseLayout.astro';
import PodcastEpisodeCard from '../components/PodcastEpisodeCard';
import NewsletterCta from '../components/NewsletterCta';
import { PODCAST_SHOWS, PODCAST_PLATFORMS } from '../data/site';

const platformIcons: Record<string, string> = {
  Spotify: 'M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm4.59 14.42a.75.75 0 0 1-1.03.25c-2.82-1.72-6.37-2.11-10.56-1.16a.75.75 0 1 1-.33-1.46c4.58-1.05 8.5-.6 11.67 1.34.35.22.46.68.25 1.03zm1.23-2.74a.94.94 0 0 1-1.29.31c-3.23-1.98-8.15-2.56-11.96-1.4a.94.94 0 1 1-.54-1.79c4.36-1.32 9.78-.68 13.49 1.59.44.27.58.85.3 1.29zm.11-2.86c-3.87-2.3-10.26-2.51-13.95-1.39a1.12 1.12 0 1 1-.65-2.15c4.23-1.28 11.27-1.03 15.72 1.6a1.12 1.12 0 0 1-1.12 1.94z',
  'Apple Podcasts':
    'M17.07 11.55c-.03-2.72 2.22-4.03 2.32-4.09-1.27-1.85-3.23-2.11-3.92-2.13-1.66-.17-3.24.98-4.08.98-.85 0-2.15-.96-3.54-.93-1.81.03-3.49 1.05-4.43 2.67-1.9 3.29-.48 8.16 1.36 10.83.9 1.3 1.98 2.75 3.39 2.7 1.36-.06 1.88-.88 3.52-.88 1.64 0 2.11.88 3.55.85 1.47-.03 2.4-1.33 3.29-2.64 1.04-1.51 1.47-2.98 1.5-3.06-.03-.02-2.89-1.11-2.96-4.3zM14.5 3.62c.75-.9 1.25-2.16 1.11-3.41-1.08.04-2.39.72-3.16 1.62-.69.8-1.29 2.08-1.13 3.31 1.21.09 2.44-.62 3.18-1.52z',
  'Google Podcasts':
    'M12 4.5a3.25 3.25 0 0 0-3.25 3.25v4a3.25 3.25 0 0 0 6.5 0v-4A3.25 3.25 0 0 0 12 4.5zm0 14.75a5.75 5.75 0 0 0 5.75-5.75h-2a3.75 3.75 0 0 1-7.5 0h-2A5.75 5.75 0 0 0 12 19.25z',
  RSS:
    'M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4.84 4.16a1 1 0 0 1 .01-2c7.94.07 14.4 6.53 14.47 14.47a1 1 0 1 1-2 .01c-.06-6.84-5.64-12.42-12.48-12.48zm.02 5.68a1 1 0 1 1-.02-2c4.82.04 8.75 3.97 8.79 8.79a1 1 0 1 1-2 .01c-.03-3.72-3.05-6.74-6.77-6.8z',
};
---

<BaseLayout
  title="Podcast"
  description="Słuchaj naszych podcastów o technologii, AI i programowaniu — Opanuj.AI Podcast i Przeprogramowani ft. Gość. Ponad 7800 słuchaczy na Spotify, Apple Podcasts i innych platformach."
  path="/podcast"
>
  <!-- Hero -->
  <section class="container-site pb-10 pt-16 sm:pt-24">
    <div class="mx-auto max-w-3xl text-center">
      <span class="badge">Podcasty</span>
      <h1
        class="mt-6 animate-fade-up font-display text-4xl font-bold leading-tight text-white sm:text-5xl"
      >
        Słuchaj nas o technologii, <span class="gradient-text">AI i programowaniu</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-slate-400 sm:text-lg">
        Dwa podcasty, tysiące słuchaczy i tematy, które naprawdę interesują
        programistów — od najnowszych modeli AI po dojrzewanie zawodowe w IT.
      </p>
    </div>
  </section>

  <!-- Programy -->
  {
    PODCAST_SHOWS.map((show) => (
      <section class="container-site py-10 sm:py-14" aria-label={show.name}>
        <div class="card relative overflow-hidden p-6 sm:p-8">
          <div
            class="orb -right-20 -top-20 h-56 w-56 bg-violet-500/15"
            aria-hidden="true"
          />
          <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center">
            <img
              src={show.cover}
              alt={`Okładka podcastu ${show.name}`}
              width="160"
              height="160"
              loading="lazy"
              class="h-28 w-28 shrink-0 rounded-2xl border border-white/10 object-cover shadow-glow sm:h-36 sm:w-36"
            />
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="font-display text-2xl font-bold text-white">{show.name}</h2>
                <span class="chip">{show.listeners}</span>
              </div>
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-400">
                {show.description}
              </p>
            </div>
          </div>

          <div class="relative mt-8 grid gap-3 md:grid-cols-2">
            {show.episodes.map((episode, index) => (
              <PodcastEpisodeCard episode={episode} index={index} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <!-- Platformy -->
  <section class="container-site py-12 sm:py-16" aria-label="Platformy podcastowe">
    <h2 class="text-center font-display text-2xl font-bold text-white sm:text-3xl">
      Jesteśmy na twojej <span class="gradient-text">ulubionej platformie</span>
    </h2>
    <div class="mx-auto mt-8 grid max-w-2xl grid-cols-2 gap-4 sm:grid-cols-4">
      {
        PODCAST_PLATFORMS.map((platform) => (
          <a
            href={platform.url}
            class="card card-hover flex flex-col items-center gap-3 p-5 text-center"
          >
            <svg
              class="h-7 w-7 text-violet-300"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={platformIcons[platform.name] ?? ''} />
            </svg>
            <span class="text-sm font-medium text-white">{platform.name}</span>
          </a>
        ))
      }
    </div>
  </section>

  <NewsletterCta />
</BaseLayout>
