---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading';
import StatsBand from '../components/StatsBand';
import BrandMarquee from '../components/BrandMarquee';
import NewsletterCta from '../components/NewsletterCta';
import { FOUNDERS, VALUES } from '../data/site';

const valueIcons: Record<string, string> = {
  telescope:
    'M11 4a3 3 0 0 1 3 3 3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1 3-3zm8.7 3.5.9.9-8.6 8.6-.9-.9 8.6-8.6zM6.5 14.5l3 3L4 23l-3-3 5.5-5.5z',
  tools:
    'M14.7 6.3a4.5 4.5 0 0 0-6.4 0L3 11.6a4.5 4.5 0 0 0 6.4 6.4l5.3-5.3a4.5 4.5 0 0 0 0-6.4zM9 15l-4-4m11-7 4 4-9 9-4-4 9-9z',
  users:
    'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M12 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0zm6 14v-2a4 4 0 0 0-3-3.87M15 3.13a4 4 0 0 1 0 7.75',
};
---

<BaseLayout
  title="O nas"
  description="Poznaj Przeprogramowanych — łączymy świat programowania, biznesu i rozwoju. Przemek Smyrdek i Marcin Czarkowski, twórcy kursów, podcastów i społeczności 15 tysięcy programistów."
  path="/o-nas"
>
  <!-- Hero -->
  <section class="container-site pb-12 pt-16 sm:pb-16 sm:pt-24">
    <div class="mx-auto max-w-3xl text-center">
      <span class="badge">O nas</span>
      <h1
        class="mt-6 animate-fade-up font-display text-4xl font-bold leading-tight text-white sm:text-5xl"
      >
        Łączymy świat <span class="gradient-text">programowania, biznesu</span> i rozwoju
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-slate-400 sm:text-lg">
        Przeprogramowani to miejsce, w którym programowanie spotyka się z rozwojem
        osobistym. Działamy od 2019 roku.
      </p>
    </div>
  </section>

  <!-- Założyciele -->
  <section class="container-site py-12 sm:py-16" aria-label="Założyciele">
    <div class="grid gap-6 lg:grid-cols-2">
      {
        FOUNDERS.map((founder) => (
          <article class="card card-hover relative overflow-hidden p-7 sm:p-8">
            <div class="orb -right-16 -top-16 h-40 w-40 bg-violet-500/20" aria-hidden="true" />
            <div class="relative flex flex-col gap-6 sm:flex-row sm:items-start">
              <div
                class={`flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br ${founder.gradient} font-display text-2xl font-bold text-white shadow-glow`}
                aria-hidden="true"
              >
                {founder.initials}
              </div>
              <div>
                <h2 class="font-display text-xl font-bold text-white">{founder.name}</h2>
                <p class="mt-0.5 text-sm font-medium text-violet-300">{founder.role}</p>
                <p class="mt-3 text-sm leading-relaxed text-slate-400">{founder.bio}</p>
                <a
                  href={founder.linkedin}
                  class="mt-5 inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-white/25 hover:bg-white/10"
                >
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45z" />
                  </svg>
                  LinkedIn
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Misja -->
  <section class="container-site py-12 sm:py-16" aria-label="Nasza misja">
    <SectionHeading
      eyebrow="Witaj na Przeprogramowanych!"
      title="Nasze podejście"
      description="Tworzymy treści, kursy i narzędzia, które pomagają programistom rozwijać się na wielu płaszczyznach. Od technicznych deep-dive'ów po rozmowy o karierze i rozwoju."
      align="center"
    />
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        VALUES.map((value) => (
          <article class="card card-hover p-6 sm:p-7">
            <span
              class="flex h-12 w-12 items-center justify-center rounded-xl border border-violet-400/20 bg-violet-500/10 text-violet-300"
              aria-hidden="true"
            >
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={valueIcons[value.icon] ?? ''} />
              </svg>
            </span>
            <h3 class="mt-5 font-display text-lg font-bold text-white">{value.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-slate-400">{value.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Statystyki -->
  <section class="container-site py-12 sm:py-16" aria-label="Przeprogramowani w liczbach">
    <div class="card p-8 sm:p-12">
      <StatsBand />
    </div>
  </section>

  <!-- Współpraca -->
  <section class="container-site py-12 sm:py-16" aria-label="Współpraca">
    <div class="card relative overflow-hidden p-8 text-center sm:p-12">
      <div class="orb -left-20 -top-20 h-64 w-64 bg-violet-600/20" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-xl">
        <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">
          Chcesz nawiązać współpracę?
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-400">
          Prowadzimy szkolenia i warsztaty dla zespołów oraz współpracujemy z
          firmami z całej branży technologicznej.
        </p>
        <a
          href="mailto:kontakt@przeprogramowani.pl"
          class="btn-primary mt-7"
        >
          kontakt@przeprogramowani.pl
        </a>
      </div>
    </div>
  </section>

  <!-- Zaufali nam -->
  <section class="py-12 sm:py-16" aria-label="Zaufali nam">
    <p class="container-site mb-8 text-center text-sm font-semibold uppercase tracking-widest text-slate-500">
      Zaufali nam
    </p>
    <BrandMarquee />
  </section>

  <NewsletterCta />
</BaseLayout>
