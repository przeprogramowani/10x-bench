SERVER_PID=$!
sleep 3
node -e "
const check = (html, needles) => {
  const missing = needles.filter(n => !html.includes(n));
  return missing;
};
(async () => {
  const tests = {
    '/': ['Szersze spojrzenie', 'Edukacja technologiczna w epoce AI', '10xDevs 4.0', 'Opanuj Frontend: AI Edition', 'Opanuj TypeScript', 'Plan mode to przeszłość', 'Wiktoria Sitko', 'Event Storming', 'Zaufali nam', 'Przeprogramowany'],
    '/o-nas': ['Przemek Smyrdek', 'Marcin Czarkowski', 'Witaj na Przeprogramowanych', 'SmartRecruiters', '7 lat', 'Autodesk'],
    '/podcast': ['Opanuj.AI Podcast', 'Przeprogramowani ft. Gość', 'Spotify', 'Apple Podcasts', 'Google Podcasts', 'RSS', 'AI-Native SDLC', 'Tomasz Ducin'],
    '/youtube': ['20,9 tys.', 'Subskrybuj kanał', 'GPT-5.6 Sol', 'Iluzja nauki', 'i.ytimg.com'],
  };
  let ok = true;
  for (const [path, needles] of Object.entries(tests)) {
    const res = await fetch('http://localhost:4391' + path);
    const html = await res.text();
    const missing = check(html, needles);
    if (res.status !== 200 || missing.length) { ok = false; console.log('FAIL', path, res.status, 'missing:', missing); }
    else console.log('PASS', path, '(' + needles.length + ' checks)');
  }
  process.exit(ok ? 0 : 1);
})();
"
RESULT=$?
kill $SERVER_PID 2>/dev/null
exit $RESULT
