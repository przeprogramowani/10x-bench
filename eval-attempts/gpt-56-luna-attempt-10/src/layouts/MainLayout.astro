---
import '../styles/global.css';
import MobileMenu from '../components/MobileMenu';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Przeprogramowani — Szersze spojrzenie na programowanie',
  description = 'Treści, kursy i rozmowy dla programistów, którzy chcą widzieć szerzej.',
} = Astro.props;

const links = [
  { label: 'O nas', href: '/o-nas' },
  { label: 'Podcast', href: '/podcast' },
  { label: 'YouTube', href: '/youtube' },
  { label: 'Kursy', href: '/#kursy' },
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23d9ff55'/%3E%3Ctext x='50' y='67' text-anchor='middle' font-size='56' font-family='Arial' font-weight='bold'%3E%26gt;%3C/text%3E%3C/svg%3E" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="bg-paper text-ink">
      <div class="relative z-50 bg-acid px-4 py-2 text-center font-mono text-[0.64rem] font-semibold uppercase tracking-[0.14em] sm:text-xs">
        <a href="https://10xdevs.pl" class="transition-opacity hover:opacity-60">Nowość: 10xDevs 4.0 — programuj z AI <span class="ml-2">Zobacz teraz ↗</span></a>
      </div>
      <header class="relative z-40 border-b border-ink/15 bg-paper">
        <div class="mx-auto flex max-w-[1440px] items-center justify-between px-4 py-4 sm:px-8 lg:px-12">
          <a href="/" class="group flex items-center gap-3" aria-label="Przeprogramowani, strona główna">
            <span class="flex h-9 w-9 items-center justify-center border border-ink bg-ink font-mono text-lg font-semibold text-acid transition-transform group-hover:-rotate-6">&gt;_</span>
            <span class="text-[0.78rem] font-bold tracking-[0.13em]">PRZEPROGRAMOWANI</span>
          </a>
          <nav class="hidden items-center gap-8 text-sm font-medium lg:flex" aria-label="Główna nawigacja">
            {links.map((link) => <a href={link.href} class="transition-colors hover:text-violet">{link.label}</a>)}
          </nav>
          <div class="flex items-center gap-3">
            <a href="https://przeprogramowani.substack.com" class="hidden text-sm font-medium underline decoration-ink/25 underline-offset-4 transition-colors hover:text-violet sm:inline">Newsletter</a>
            <a href="https://10xdevs.pl" class="hidden bg-ink px-4 py-2.5 text-xs font-semibold text-paper transition-colors hover:bg-violet hover:text-ink sm:inline">10xDevs ↗</a>
            <MobileMenu client:load links={links} />
          </div>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="bg-ink text-paper">
        <div class="mx-auto max-w-[1440px] px-4 py-14 sm:px-8 lg:px-12 lg:py-20">
          <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
            <div>
              <a href="/" class="flex items-center gap-3 text-lg font-bold"><span class="flex h-9 w-9 items-center justify-center bg-acid font-mono text-sm text-ink">&gt;_</span> PRZEPROGRAMOWANI</a>
              <p class="mt-6 max-w-xs text-sm leading-6 text-paper/60">Szersze spojrzenie na programowanie. Uczymy, rozmawiamy i budujemy rzeczy, które zostają na dłużej niż kolejny trend.</p>
            </div>
            <div>
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-paper/40">Odkrywaj</p>
              <div class="mt-5 flex flex-col gap-3 text-sm text-paper/75"><a href="/o-nas" class="transition-colors hover:text-acid">O nas</a><a href="/podcast" class="transition-colors hover:text-acid">Podcast</a><a href="/youtube" class="transition-colors hover:text-acid">YouTube</a><a href="/#kursy" class="transition-colors hover:text-acid">Kursy</a></div>
            </div>
            <div>
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-paper/40">Programy</p>
              <div class="mt-5 flex flex-col gap-3 text-sm text-paper/75"><a href="https://opanujfrontend.pl" class="transition-colors hover:text-acid">Opanuj Frontend</a><a href="https://opanujtypescript.pl" class="transition-colors hover:text-acid">Opanuj TypeScript</a><a href="https://10xdevs.pl" class="transition-colors hover:text-acid">10xDevs</a><a href="https://opanuj.ai" class="transition-colors hover:text-acid">Opanuj AI</a></div>
            </div>
            <div>
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-paper/40">Kontakt</p>
              <div class="mt-5 flex flex-col gap-3 text-sm text-paper/75"><a href="mailto:kontakt@przeprogramowani.pl" class="transition-colors hover:text-acid">kontakt@przeprogramowani.pl</a><a href="https://www.linkedin.com/company/przeprogramowani/" class="transition-colors hover:text-acid">LinkedIn ↗</a><a href="https://www.instagram.com/przeprogramowani/" class="transition-colors hover:text-acid">Instagram ↗</a></div>
            </div>
          </div>
          <div class="mt-16 flex flex-col justify-between gap-4 border-t border-paper/15 pt-6 font-mono text-[0.65rem] text-paper/40 sm:flex-row"><span>© 2026 Przeprogramowani.pl</span><span>Projektujemy naukę dla ludzi, nie dla algorytmów.</span></div>
        </div>
      </footer>
    </div>
  </body>
</html>
