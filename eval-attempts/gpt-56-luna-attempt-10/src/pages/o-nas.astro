---
import MainLayout from '../layouts/MainLayout.astro';

const people = [
  { name: 'Przemek Smyrdek', role: 'Co-founder, Przeprogramowani', image: 'https://przeprogramowani.pl/img/profiles/przemek.webp', text: 'Autor programów edukacyjnych, kursów i podcastów. Lead Engineer i Manager w DAZN i Cabify. Full-stack developer, prelegent i kontrybutor Open Source.' },
  { name: 'Marcin Czarkowski', role: 'Co-founder, Przeprogramowani', image: 'https://przeprogramowani.pl/img/profiles/marcin.webp', text: 'Lead techniczny Platformy Frontendowej w SmartRecruiters. Pasjonat neuronauki, TypeScriptu, Reacta i uczenia się opartego na praktyce.' },
];
---

<MainLayout title="O nas — Przeprogramowani" description="Poznaj Przeprogramowanych — łączymy świat programowania, biznesu i rozwoju.">
  <section class="bg-ink px-4 py-20 text-paper dark-grid sm:px-8 lg:px-12 lg:py-32"><div class="mx-auto max-w-[1440px]"><div class="eyebrow eyebrow-light">/ O nas</div><h1 class="mt-7 max-w-5xl text-[clamp(3.5rem,9vw,8rem)] font-semibold leading-[0.86] tracking-[-0.08em]">Łączymy świat<br /><span class="text-acid">programowania,</span><br />biznesu i rozwoju.</h1><p class="mt-10 max-w-xl text-lg leading-8 text-paper/60">Przeprogramowani to miejsce, w którym technologia spotyka się z ciekawością. Tworzymy treści, kursy i narzędzia, które pomagają patrzeć szerzej.</p></div></section>
  <section class="display-grid bg-paper px-4 py-20 sm:px-8 lg:px-12 lg:py-28"><div class="mx-auto max-w-[1440px]"><div class="grid gap-12 lg:grid-cols-[0.65fr_1.35fr] lg:gap-24"><div><div class="eyebrow">Nasza perspektywa</div><p class="mt-7 text-3xl font-medium leading-tight tracking-[-0.05em] sm:text-4xl">Najlepszy kod zaczyna się od dobrego pytania.</p></div><div class="max-w-3xl"><p class="text-xl leading-8 sm:text-2xl">Wierzymy, że rozwój programisty nie kończy się na znajomości narzędzi. Liczy się umiejętność rozumienia kontekstu, podejmowania decyzji i dowożenia wartości.</p><p class="mt-7 text-base leading-7 text-ink/55">Dlatego nie uczymy jednego frameworka na pamięć. Pokazujemy mechanizmy, praktyki i sposób myślenia, który przydaje się niezależnie od stacku. Od frontendowych fundamentów po świadome wykorzystanie generatywnego AI.</p></div></div><div class="mt-16 grid gap-5 sm:grid-cols-2">{people.map((person) => <article class="border border-ink bg-paper p-4"><img src={person.image} alt={person.name} class="aspect-[4/3] w-full object-cover object-top grayscale-[0.1]" loading="lazy" /><div class="px-2 pb-3 pt-5"><p class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-violet">{person.role}</p><h2 class="mt-2 text-2xl font-semibold tracking-[-0.04em]">{person.name}</h2><p class="mt-4 text-sm leading-6 text-ink/55">{person.text}</p><a href="https://www.linkedin.com" class="mt-5 inline-block text-sm font-semibold underlined-link">LinkedIn ↗</a></div></article>)}</div></div></section>
  <section class="bg-orange px-4 py-16 sm:px-8 lg:px-12 lg:py-20"><div class="mx-auto flex max-w-[1440px] flex-col justify-between gap-8 sm:flex-row sm:items-end"><div><div class="eyebrow">Dla kogo to robimy</div><h2 class="mt-5 max-w-2xl text-4xl font-semibold leading-[0.92] tracking-[-0.06em] sm:text-6xl">Dla ludzi, którzy chcą robić rzeczy dobrze.</h2></div><a href="/#kursy" class="inline-flex shrink-0 items-center gap-4 border border-ink bg-ink px-5 py-3.5 text-sm font-semibold text-paper hover:bg-paper hover:text-ink">Zobacz programy ↗</a></div></section>
</MainLayout>
