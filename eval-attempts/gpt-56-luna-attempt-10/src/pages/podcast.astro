---
import MainLayout from '../layouts/MainLayout.astro';

const shows = [
  { label: '01', name: 'Opanuj.AI Podcast', audience: 'Ponad 4000 słuchaczy', description: 'Comiesięczne podsumowanie najważniejszych wydarzeń ze świata AI.', accent: 'bg-acid' },
  { label: '02', name: 'Przeprogramowani ft. Gość', audience: 'Rozmowy dla głodnych wiedzy', description: 'Technologia, kariera, nauka i ludzie, którzy zmieniają sposób myślenia o pracy w IT.', accent: 'bg-violet' },
];

const episodes = [
  { title: 'BAN NA AI?! USA blokuje Anthropica i OpenAI', meta: 'Opanuj.AI · 01:21:53', image: 'https://i3.ytimg.com/vi/c5HVzK-tclM/maxresdefault.jpg' },
  { title: 'Byliśmy na Google I/O 2026 — wrażenia na gorąco!', meta: 'Opanuj.AI LIVE · 01:12:26', image: 'https://i3.ytimg.com/vi/B4t6w4QsD24/maxresdefault.jpg' },
  { title: 'GPT-5.5 VS Opus 4.7 — kto rządzi na scenie AI?', meta: 'Opanuj.AI · 00:47:22', image: 'https://i3.ytimg.com/vi/03y826SVjG0/maxresdefault.jpg' },
  { title: 'Programowanie w epoce AI z Claude Code, Cursorem i Copilotem', meta: 'Gość: Dawid Sibiński · 01:28:30', image: 'https://i3.ytimg.com/vi/S-iNbyLSisE/maxresdefault.jpg' },
];
---

<MainLayout title="Podcast — Przeprogramowani" description="Słuchaj podcastów Przeprogramowanych o technologii, AI i programowaniu.">
  <section class="bg-ink px-4 py-20 text-paper dark-grid sm:px-8 lg:px-12 lg:py-28"><div class="mx-auto grid max-w-[1440px] items-end gap-10 lg:grid-cols-[1fr_0.7fr]"><div><div class="eyebrow eyebrow-light">/ Podcast</div><h1 class="mt-7 max-w-4xl text-[clamp(3.5rem,9vw,8rem)] font-semibold leading-[0.86] tracking-[-0.08em]">Rozmowy, które<br /><span class="text-acid">zostają w głowie.</span></h1></div><p class="max-w-md text-base leading-7 text-paper/60">Słuchaj o technologii, AI i programowaniu. Bez skrótów, bez hype’u, z szerszym spojrzeniem.</p></div></section>
  <section class="display-grid bg-paper px-4 py-20 sm:px-8 lg:px-12 lg:py-28"><div class="mx-auto max-w-[1440px]"><div class="grid gap-5 lg:grid-cols-2">{shows.map((show) => <article class={`border border-ink ${show.accent} p-7 sm:p-10`}><div class="flex justify-between font-mono text-xs"><span>{show.label} / SHOW</span><span>Spotify ↗</span></div><h2 class="mt-20 text-4xl font-semibold leading-[0.9] tracking-[-0.06em] sm:text-5xl">{show.name}</h2><p class="mt-4 font-mono text-xs uppercase tracking-[0.1em] text-ink/55">{show.audience}</p><p class="mt-8 max-w-sm text-base leading-7 text-ink/65">{show.description}</p><a href="https://open.spotify.com/show/4qHUZJpeBK8Ij9e2wTVm2o" class="mt-12 inline-flex items-center gap-3 border-b border-ink pb-1 text-sm font-semibold">Posłuchaj teraz <span>↗</span></a></article>)}</div><div class="mt-24"><div class="flex flex-col justify-between gap-5 border-b border-ink/20 pb-7 sm:flex-row sm:items-end"><div><div class="eyebrow">Ostatnie odcinki</div><h2 class="mt-5 text-4xl font-semibold tracking-[-0.06em] sm:text-6xl">Wciśnij play.</h2></div><span class="font-mono text-xs text-ink/45">01 — 04 / ARCHIWUM</span></div><div class="mt-8 grid gap-5 sm:grid-cols-2">{episodes.map((episode, index) => <a href="https://podcasters.spotify.com/pod/show/opanujai" class="media-card group border border-ink bg-paper p-3"><div class="relative aspect-[16/9] overflow-hidden"><img src={episode.image} alt="" class="h-full w-full object-cover grayscale transition duration-500 group-hover:scale-105 group-hover:grayscale-0" loading="lazy" /><span class="absolute bottom-3 left-3 bg-acid px-2 py-1 font-mono text-[0.6rem] font-semibold text-ink">0{index + 1}</span></div><div class="flex items-start justify-between gap-5 p-3 pb-2"><div><p class="font-mono text-[0.62rem] uppercase tracking-[0.1em] text-violet">{episode.meta}</p><h3 class="mt-2 text-xl font-semibold leading-tight tracking-[-0.04em]">{episode.title}</h3></div><span class="text-xl text-ink/45 group-hover:text-violet">↗</span></div></a>)}</div></div></div></section>
  <section class="bg-orange px-4 py-16 sm:px-8 lg:px-12"><div class="mx-auto flex max-w-[1440px] flex-col justify-between gap-6 sm:flex-row sm:items-center"><p class="max-w-2xl text-2xl font-medium leading-tight tracking-[-0.04em] sm:text-3xl">Wolisz czytać? W newsletterze dostajesz 3–2–1 konkretnych rekomendacji.</p><a href="https://przeprogramowani.substack.com" class="shrink-0 border border-ink bg-ink px-5 py-3.5 text-sm font-semibold text-paper hover:bg-paper hover:text-ink">Zapisz się za darmo ↗</a></div></section>
</MainLayout>
