---
import MainLayout from '../layouts/MainLayout.astro';

const videos = [
  { title: 'Poznaj AI Workflow, które działa na produkcji', category: 'LIVE 10xDevs', duration: '1:08:12', image: 'https://i3.ytimg.com/vi/c5HVzK-tclM/maxresdefault.jpg', href: 'https://www.youtube.com/watch?v=c5HVzK-tclM' },
  { title: 'Darmowe AI na każdym Maku — Apple Foundational Models', category: 'Opanuj.AI', duration: '18:42', image: 'https://i3.ytimg.com/vi/B4t6w4QsD24/maxresdefault.jpg', href: 'https://www.youtube.com/watch?v=B4t6w4QsD24' },
  { title: 'Byliśmy na Google I/O 2026 — wrażenia na gorąco!', category: 'Opanuj.AI LIVE', duration: '42:19', image: 'https://i3.ytimg.com/vi/0JOszZXqKaM/maxresdefault.jpg', href: 'https://www.youtube.com/watch?v=0JOszZXqKaM' },
  { title: 'Byłem na Google I/O 2026. Nie tego się spodziewałem.', category: 'Przeprogramowani', duration: '25:06', image: 'https://i3.ytimg.com/vi/XgyH-HSzKRQ/maxresdefault.jpg', href: 'https://www.youtube.com/watch?v=XgyH-HSzKRQ' },
  { title: 'Jak wybrać najlepszego Agenta AI do programowania?', category: 'Przeprogramowani', duration: '22:05', image: 'https://i3.ytimg.com/vi/03y826SVjG0/maxresdefault.jpg', href: 'https://www.youtube.com/watch?v=03y826SVjG0' },
  { title: '5 Agent Skills do jakościowego programowania z AI', category: 'Claude Code LIVE DEMO', duration: '39:11', image: 'https://i3.ytimg.com/vi/S-iNbyLSisE/maxresdefault.jpg', href: 'https://www.youtube.com/watch?v=S-iNbyLSisE' },
];
---

<MainLayout title="YouTube — Przeprogramowani" description="Oglądaj najnowsze filmy Przeprogramowanych o programowaniu, frontendzie i AI.">
  <section class="bg-ink px-4 py-20 text-paper dark-grid sm:px-8 lg:px-12 lg:py-28"><div class="mx-auto flex max-w-[1440px] flex-col justify-between gap-10 lg:flex-row lg:items-end"><div><div class="eyebrow eyebrow-light">/ YouTube</div><h1 class="mt-7 max-w-4xl text-[clamp(3.5rem,9vw,8rem)] font-semibold leading-[0.86] tracking-[-0.08em]">Mniej scrollowania.<br /><span class="text-acid">Więcej rozumienia.</span></h1></div><div class="max-w-sm"><p class="text-base leading-7 text-paper/60">Techniczne deep-dive’y, rozmowy i live’y, które pomagają nadążyć za światem, bez gonienia za każdym trendem.</p><a href="https://www.youtube.com/c/przeprogramowani/videos" target="_blank" rel="noreferrer" class="mt-7 inline-flex items-center gap-3 border-b border-acid pb-1 text-sm font-semibold text-acid">Otwórz kanał <span>↗</span></a></div></div></section>
  <section class="display-grid bg-paper px-4 py-20 sm:px-8 lg:px-12 lg:py-28"><div class="mx-auto max-w-[1440px]"><div class="flex items-end justify-between border-b border-ink/20 pb-7"><div><div class="eyebrow">Najnowsze filmy</div><h2 class="mt-5 text-4xl font-semibold tracking-[-0.06em] sm:text-6xl">Oglądaj teraz.</h2></div><span class="hidden font-mono text-xs text-ink/45 sm:block">VIDEO / 2026</span></div><div class="mt-8 grid gap-x-5 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">{videos.map((video, index) => <a href={video.href} target="_blank" rel="noreferrer" class="media-card group"><div class="relative aspect-[16/10] overflow-hidden border border-ink"><img src={video.image} alt={video.title} class="h-full w-full object-cover grayscale transition duration-500 group-hover:scale-105 group-hover:grayscale-0" loading="lazy" /><span class="play-icon absolute bottom-4 left-4 flex h-11 w-11 items-center justify-center rounded-full border border-ink bg-paper text-xs">▶</span><span class="absolute right-3 top-3 bg-ink px-2 py-1 font-mono text-[0.6rem] text-acid">0{index + 1}</span></div><p class="mt-4 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-violet">{video.category} · {video.duration}</p><h3 class="mt-2 max-w-sm text-xl font-semibold leading-tight tracking-[-0.035em] group-hover:text-violet">{video.title}</h3></a>)}</div></div></section>
  <section class="bg-violet px-4 py-16 sm:px-8 lg:px-12"><div class="mx-auto grid max-w-[1440px] gap-8 lg:grid-cols-[1fr_auto] lg:items-center"><p class="max-w-3xl text-3xl font-semibold leading-[0.95] tracking-[-0.06em] sm:text-5xl">Subskrybuj, jeśli chcesz rozumieć nie tylko „co”, ale też „dlaczego”.</p><a href="https://www.youtube.com/c/przeprogramowani?sub_confirmation=1" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center border border-ink bg-ink px-6 py-4 text-sm font-semibold text-paper hover:bg-paper hover:text-ink">Subskrybuj kanał ↗</a></div></section>
</MainLayout>
