---
import type { Video } from "../data/videos";

type Props = {
  video: Video;
};

const { video } = Astro.props;
---

<article class="card group overflow-hidden">
  <a
    href={video.url}
    target="_blank"
    rel="noopener noreferrer"
    class="block"
    aria-label={`Obejrzyj na YouTube: ${video.title}`}
  >
    <div class="relative aspect-video overflow-hidden bg-surface-2">
      <img
        src={video.thumbnail}
        alt=""
        loading="lazy"
        width="480"
        height="360"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
      <span
        class="absolute inset-0 flex items-center justify-center bg-black/0 transition-colors duration-200 group-hover:bg-black/30"
        aria-hidden="true"
      >
        <span
          class="flex h-14 w-14 items-center justify-center rounded-full bg-youtube text-white shadow-lg transition-transform duration-200 group-hover:scale-110"
        >
          <svg class="ml-1 h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5.5v13l11-6.5-11-6.5z"></path>
          </svg>
        </span>
      </span>
    </div>
    <div class="p-4 sm:p-5">
      <h3
        class="text-sm font-semibold leading-snug text-text group-hover:text-accent-soft sm:text-base"
      >
        {video.title}
      </h3>
    </div>
  </a>
</article>
