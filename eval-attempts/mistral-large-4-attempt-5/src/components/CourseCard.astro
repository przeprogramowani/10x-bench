---
import type { Course } from "../data/courses";

type Props = {
  course: Course;
  featured?: boolean;
};

const { course, featured = false } = Astro.props;
---

<article
  class:list={[
    "card group relative flex flex-col overflow-hidden p-6 transition-all duration-200 hover:-translate-y-1 sm:p-8",
    featured && "border-accent/50 bg-surface-2",
  ]}
>
  {
    course.badge && (
      <span class="absolute right-4 top-4 rounded-full border border-accent/40 bg-accent/10 px-3 py-1 font-mono text-xs font-semibold uppercase tracking-widest text-accent-soft">
        {course.badge}
      </span>
    )
  }
  <p class="font-mono text-xs uppercase tracking-widest text-accent">
    {course.tag}
  </p>
  <h3
    class="mt-3 text-2xl font-bold tracking-tight text-text group-hover:text-accent-soft"
  >
    {course.name}
  </h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
    {course.description}
  </p>
  <ul class="mt-6 space-y-2.5">
    {
      course.highlights.slice(0, 3).map((highlight) => (
        <li class="flex items-start gap-2.5 text-sm text-muted">
          <svg
            class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span>{highlight}</span>
        </li>
      ))
    }
  </ul>
  <dl
    class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t border-border pt-5"
  >
    {
      course.stats.map((stat) => (
        <div>
          <dt class="sr-only">{stat.label}</dt>
          <dd class="font-display text-lg font-semibold text-text">
            {stat.value}
          </dd>
          <dd class="text-xs text-muted">{stat.label}</dd>
        </div>
      ))
    }
  </dl>
  {
    course.note && (
      <p class="mt-4 font-mono text-xs text-accent-soft">{course.note}</p>
    )
  }
  <a
    href={course.url}
    target="_blank"
    rel="noopener noreferrer"
    class="btn btn-primary mt-6 self-start"
  >
    Zobacz kurs
    <span aria-hidden="true">→</span>
  </a>
</article>
