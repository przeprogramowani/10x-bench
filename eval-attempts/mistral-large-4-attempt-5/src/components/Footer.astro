---
import { navLinks, site, socialLinks } from "../data/site";
import { courses } from "../data/courses";

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface/50">
  <div class="container py-12 md:py-16">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a
          href="/"
          class="flex items-center gap-2.5 font-display text-lg font-semibold"
        >
          <span
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent font-mono text-sm font-semibold text-ink"
            aria-hidden="true">&lt;/&gt;</span
          >
          <span>Przeprogramowani</span>
        </a>
        <p class="mt-4 max-w-sm text-sm text-muted">
          {site.tagline}. Kursy, podcasty i materiały edukacyjne dla ambitnych
          programistów.
        </p>
        <div class="mt-6 flex items-center gap-3">
          <a
            href={socialLinks.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-border text-muted transition-colors hover:border-youtube/60 hover:text-youtube"
            aria-label="YouTube"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12l-6.2 3.6z" />
            </svg>
          </a>
          <a
            href={socialLinks.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-border text-muted transition-colors hover:border-accent/60 hover:text-accent-soft"
            aria-label="Facebook"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4h-3V12h3V9.4c0-3 1.8-4.7 4.6-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.3l-.5 3.5h-2.8v8.4A12 12 0 0 0 24 12z" />
            </svg>
          </a>
          <a
            href={socialLinks.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-border text-muted transition-colors hover:border-accent/60 hover:text-accent-soft"
            aria-label="Instagram"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 2.2c-3.1 0-3.5 0-4.8.1-1.1.1-1.5.2-1.8.3-.4.2-.7.4-1 .7-.3.3-.5.6-.7 1-.1.3-.3.7-.3 1.8-.1 1.3-.1 1.7-.1 4.8s0 3.5.1 4.8c.1 1.1.2 1.5.3 1.8.2.4.4.7.7 1 .3.3.6.5 1 .7.3.1.7.3 1.8.3 1.3.1 1.7.1 4.8.1s3.5 0 4.8-.1c1.1-.1 1.5-.2 1.8-.3.4-.2.7-.4 1-.7.3-.3.5-.6.7-1 .1-.3.3-.7.3-1.8.1-1.3.1-1.7.1-4.8s0-3.5-.1-4.8c-.1-1.1-.2-1.5-.3-1.8-.2-.4-.4-.7-.7-1-.3-.3-.6-.5-1-.7-.3-.1-.7-.3-1.8-.3-1.3-.1-1.7-.1-4.8-.1zm0 3.7a5.9 5.9 0 1 1 0 11.8 5.9 5.9 0 0 1 0-11.8zm0 2.2a3.7 3.7 0 1 0 0 7.4 3.7 3.7 0 0 0 0-7.4zm6.2-2.5a1.4 1.4 0 1 1-2.8 0 1.4 1.4 0 0 1 2.8 0z" />
            </svg>
          </a>
          <a
            href={`mailto:${site.email}`}
            class="flex h-9 w-9 items-center justify-center rounded-lg border border-border text-muted transition-colors hover:border-accent/60 hover:text-accent-soft"
            aria-label="E-mail"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" />
            </svg>
          </a>
        </div>
      </div>

      <nav aria-label="Nawigacja w stopce">
        <h3 class="font-mono text-xs uppercase tracking-widest text-muted">
          Nawigacja
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-muted transition-colors hover:text-text"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Kursy w stopce">
        <h3 class="font-mono text-xs uppercase tracking-widest text-muted">
          Kursy
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            courses.map((course) => (
              <li>
                <a
                  href={course.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted transition-colors hover:text-text"
                >
                  {course.shortName}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={socialLinks.newsletter}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted transition-colors hover:text-text"
            >
              Newsletter
            </a>
          </li>
        </ul>
      </nav>

      <div>
        <h3 class="font-mono text-xs uppercase tracking-widest text-muted">
          Kontakt
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a
              href={`mailto:${site.email}`}
              class="text-muted transition-colors hover:text-text"
            >
              {site.email}
            </a>
          </li>
          <li class="text-muted">Polska · edukacja technologiczna</li>
          <li class="text-muted">Działamy od 2019 roku</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 text-sm text-muted sm:flex-row"
    >
      <p>© {year} {site.name} — {site.tagline}</p>
      <p class="font-mono text-xs">zbudowano z Astro, React i Tailwind</p>
    </div>
  </div>
</footer>
