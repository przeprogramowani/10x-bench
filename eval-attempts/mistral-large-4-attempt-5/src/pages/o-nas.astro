---
import Layout from "../layouts/Layout.astro";
import { site, stats, socialLinks } from "../data/site";
import { founders, contributors, values, mission, goal } from "../data/team";
---

<Layout
  title="O nas"
  description="Poznaj Przeprogramowanych — Przemka Smyrdka i Marcina Czarkowskiego. Łączymy świat programowania, biznesu i rozwoju."
>
  <!-- Nagłówek -->
  <section class="relative overflow-hidden">
    <div class="dot-grid absolute inset-0" aria-hidden="true"></div>
    <div class="container relative py-16 md:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">O nas</p>
        <h1
          class="mt-4 text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl"
        >
          Łączymy świat programowania, biznesu i rozwoju
        </h1>
        <p class="mt-6 text-base leading-relaxed text-muted sm:text-lg">
          {mission}
        </p>
        <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
          {goal}
        </p>
      </div>
    </div>
  </section>

  <!-- Założyciele -->
  <section class="container py-16 md:py-24">
    <div class="grid gap-6 md:grid-cols-2">
      {
        founders.map((founder) => (
          <article class="card flex flex-col p-6 sm:p-8">
            <div class="flex flex-col items-start gap-5 sm:flex-row">
              <img
                src={founder.photo}
                alt={`Zdjęcie: ${founder.name}`}
                width="112"
                height="112"
                loading="lazy"
                class="h-24 w-24 flex-shrink-0 rounded-2xl border border-border object-cover sm:h-28 sm:w-28"
              />
              <div>
                <h2 class="text-2xl font-bold tracking-tight">{founder.name}</h2>
                <p class="mt-1 text-sm text-accent-soft">{founder.role}</p>
                <span class="mt-3 inline-flex rounded-full border border-border bg-surface-2 px-3 py-1 font-mono text-xs text-muted">
                  Kurs: {founder.course}
                </span>
              </div>
            </div>
            <div class="mt-6 flex-1 space-y-4">
              {founder.bio.map((paragraph) => (
                <p class="text-sm leading-relaxed text-muted">{paragraph}</p>
              ))}
            </div>
            <div class="mt-6 border-t border-border pt-5">
              <a
                href={founder.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost btn-sm"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45z" />
                </svg>
                LinkedIn
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Wartości -->
  <section class="border-t border-border bg-surface/30">
    <div class="container py-16 md:py-24">
      <div class="max-w-2xl">
        <p class="eyebrow">Nasza filozofia</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl md:text-5xl">
          Więcej niż kodowanie
        </h2>
        <blockquote class="mt-6 border-l-2 border-accent pl-6 text-base leading-relaxed text-muted sm:text-lg">
          Współczesny świat nowych technologii to coś więcej niż kodowanie. Na
          styku biznesu i programowania najlepiej sprawdzają się osoby, które
          potrafią myśleć kreatywnie, rozwiązywać problemy, pracować w zespole
          i komunikować się z innymi.
        </blockquote>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          values.map((value, index) => (
            <article class="card p-6">
              <span class="font-mono text-sm font-semibold text-accent">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-3 text-lg font-semibold">{value.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                {value.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Współtwórcy + statystyki + kontakt -->
  <section class="container py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:items-center">
      <div>
        <p class="eyebrow">Społeczność</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Razem tworzymy więcej
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted">
          Nasze produkty i usługi współtworzą doświadczeni inżynierowie i
          pasjonaci edukacji:
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            contributors.map((name) => (
              <li class="rounded-full border border-border bg-surface px-4 py-1.5 text-sm text-muted">
                {name}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card p-8">
        <h3 class="text-2xl font-bold tracking-tight">Chcesz nawiązać współpracę?</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Szkolenia dla firm, warsztaty, wystąpienia i partnerstwa edukacyjne —
          porozmawiajmy.
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-6">
          {
            stats.slice(0, 2).map((stat) => (
              <div>
                <dd class="font-display text-2xl font-bold text-text">
                  {stat.value}
                </dd>
                <dt class="mt-1 text-xs leading-snug text-muted">{stat.label}</dt>
              </div>
            ))
          }
        </dl>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${site.email}`} class="btn btn-primary">
            Napisz do nas
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={socialLinks.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
          >
            YouTube
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
