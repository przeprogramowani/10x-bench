---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CourseCard from "../components/CourseCard.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import VideoCard from "../components/VideoCard.astro";
import NewsletterCta from "../components/NewsletterCta.astro";
import { site, stats, partners } from "../data/site";
import { courses } from "../data/courses";
import { podcastShows } from "../data/podcasts";
import { videos, youtubeChannel } from "../data/videos";

const featuredCourse = courses[0];
const latestVideos = videos.slice(0, 3);
---

<Layout title={site.title} description={site.description}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: site.name,
        url: site.url,
        description: site.description,
        inLanguage: "pl",
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Kursy Przeprogramowanych",
        itemListElement: courses.map((course, index) => ({
          "@type": "ListItem",
          position: index + 1,
          item: {
            "@type": "Course",
            name: course.name,
            description: course.description,
            url: course.url,
            provider: {
              "@type": "Organization",
              name: site.name,
              url: site.url,
            },
          },
        })),
      })}
    />
  </Fragment>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="dot-grid absolute inset-0" aria-hidden="true"></div>
    <div class="container relative py-16 md:py-24 lg:py-28">
      <div
        class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16"
      >
        <div>
          <p class="eyebrow">Przeprogramowani · edukacja technologiczna</p>
          <h1
            class="mt-4 text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl"
          >
            Szersze spojrzenie na
            <span class="text-gradient"> programowanie</span>.
          </h1>
          <p
            class="mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-lg"
          >
            Kursy, podcasty i materiały dla ambitnych programistów. Łączymy
            świat programowania, biznesu i rozwoju — od technicznych
            deep-dive'ów po świadomą pracę z AI.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/kursy" class="btn btn-primary">
              Poznaj kursy
              <span aria-hidden="true">→</span>
            </a>
            <a href="/podcast" class="btn btn-ghost">Posłuchaj podcastu</a>
          </div>
          <p class="mt-6 font-mono text-xs text-muted">
            7 lat na rynku edukacji technologicznej · Polska społeczność
            devów
          </p>
        </div>

        <!-- 10xDevs — flagowy kurs w hero -->
        <div class="relative">
          <div
            class="absolute -inset-4 rounded-3xl bg-accent/10 blur-2xl"
            aria-hidden="true"
          >
          </div>
          <div
            class="card relative overflow-hidden border-accent/40 bg-surface-2 shadow-2 shadow-black/40"
          >
            <div class="terminal-bar">
              <span class="dot bg-[#ff5f57]" aria-hidden="true"></span>
              <span class="dot bg-[#febc2e]" aria-hidden="true"></span>
              <span class="dot bg-[#28c840]" aria-hidden="true"></span>
              <span class="ml-2">~/10xdevs — programuj z AI</span>
            </div>
            <div class="p-6 sm:p-8">
              <div class="flex flex-wrap items-center gap-2">
                <span
                  class="rounded-full border border-accent/40 bg-accent/10 px-3 py-1 font-mono text-xs font-semibold uppercase tracking-widest text-accent-soft"
                >
                  Bestseller
                </span>
                <span class="font-mono text-xs uppercase tracking-widest text-muted"
                  >10xDevs 4.0</span
                >
              </div>
              <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
                10xDevs — Programuj z AI
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">
                Nowe oblicze programowania z wykorzystaniem generatywnego AI.
                Techniki i narzędzia pozwalające świadomie stosować AI w całym
                cyklu wytwarzania oprogramowania.
              </p>
              <dl class="mt-6 grid grid-cols-3 gap-4">
                {
                  featuredCourse.stats.map((stat) => (
                    <div>
                      <dd class="font-display text-xl font-semibold text-text sm:text-2xl">
                        {stat.value}
                      </dd>
                      <dt class="mt-0.5 text-xs leading-snug text-muted">
                        {stat.label}
                      </dt>
                    </div>
                  ))
                }
              </dl>
              <a
                href={featuredCourse.url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary mt-6 w-full sm:w-auto"
              >
                Zobacz 10xDevs
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Statystyki -->
  <section class="border-y border-border bg-surface/40">
    <div class="container py-10 md:py-14">
      <dl
        class="grid grid-cols-2 gap-8 md:grid-cols-4 md:gap-6"
      >
        {
          stats.map((stat) => (
            <div class="text-center md:text-left">
              <dd class="font-display text-3xl font-bold tracking-tight text-text sm:text-4xl">
                {stat.value}
              </dd>
              <dt class="mt-2 text-sm leading-snug text-muted">{stat.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Kursy -->
  <section id="kursy" class="container py-16 md:py-24 scroll-mt-24">
    <SectionHeading
      eyebrow="Kursy"
      title="Edukacja technologiczna w epoce AI"
      description="Topowe programy edukacyjne dla ambitnych programistów — praktyczna wiedza, code review i mentoring prowadzących."
    />
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        courses.map((course, index) => (
          <CourseCard course={course} featured={index === 0} />
        ))
      }
    </div>
    <div class="mt-10 text-center">
      <a href="/kursy" class="btn btn-ghost">
        Zobacz wszystkie kursy
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- Podcasty -->
  <section class="border-t border-border bg-surface/30">
    <div class="container py-16 md:py-24">
      <SectionHeading
        eyebrow="Podcast"
        title="Słuchaj naszych podcastów"
        description="Rozmowy o technologii, AI i programowaniu — oraz comiesięczne podsumowanie najważniejszych wydarzeń ze świata AI."
      />
      <div class="grid gap-6 lg:grid-cols-2">
        {
          podcastShows.map((show) => (
            <section class="card flex flex-col p-6 sm:p-8">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <h3 class="text-2xl font-bold tracking-tight">{show.name}</h3>
                  <p class="mt-1 text-sm text-muted">{show.tagline}</p>
                </div>
                <span class="rounded-full border border-border bg-surface-2 px-3 py-1 font-mono text-xs text-muted">
                  {show.listeners}
                </span>
              </div>
              <div class="mt-6 flex-1 space-y-4">
                {show.episodes.slice(0, 3).map((episode) => (
                  <EpisodeCard episode={episode} showName={show.name} />
                ))}
              </div>
              <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-5">
                <div class="flex flex-wrap gap-3 text-sm">
                  <a
                    href={show.spotifyShowUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-spotify hover:underline"
                  >
                    Spotify
                  </a>
                  <a
                    href={show.appleUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-apple hover:underline"
                  >
                    Apple Podcasts
                  </a>
                  <a
                    href={show.rssUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-rss hover:underline"
                  >
                    RSS
                  </a>
                </div>
                <a
                  href="/podcast"
                  class="text-sm font-semibold text-accent-soft hover:underline"
                >
                  Wszystkie odcinki →
                </a>
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <!-- YouTube -->
  <section class="container py-16 md:py-24">
    <SectionHeading
      eyebrow="YouTube"
      title="Rozwój nowoczesnego programisty"
      description={youtubeChannel.description}
    />
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {latestVideos.map((video) => <VideoCard video={video} />)}
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href="/youtube" class="btn btn-ghost">Wszystkie filmy na stronie</a>
      <a
        href={youtubeChannel.url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        Subskrybuj kanał {youtubeChannel.handle}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- Zaufali nam -->
  <section class="border-t border-border">
    <div class="container py-12 md:py-16">
      <p
        class="text-center font-mono text-xs uppercase tracking-widest text-muted"
      >
        Zaufali nam
      </p>
      <ul
        class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-3"
      >
        {
          partners.map((partner) => (
            <li class="font-display text-sm font-medium text-muted/80 sm:text-base">
              {partner}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <NewsletterCta />
</Layout>
