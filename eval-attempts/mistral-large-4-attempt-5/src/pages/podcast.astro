---
import Layout from "../layouts/Layout.astro";
import PodcastTabs from "../components/react/PodcastTabs";
import { podcastShows, formatDate } from "../data/podcasts";

const platforms = [
  {
    name: "Spotify",
    color: "text-spotify",
    href: podcastShows.map((show) => ({ label: show.name, url: show.spotifyShowUrl })),
    icon: `<path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.6 0 12 0zm5.5 17.3c-.2.4-.7.5-1 .3-2.9-1.8-6.5-2.2-10.8-1.2-.4.1-.8-.2-.9-.6-.1-.4.2-.8.6-.9 4.7-1.1 8.7-.6 11.9 1.4.3.2.4.7.2 1zm1.5-3.3c-.3.4-.8.6-1.3.3-3.3-2-8.3-2.6-12.2-1.4-.5.1-1-.1-1.2-.6-.1-.5.1-1 .6-1.2 4.4-1.3 9.9-.7 13.7 1.6.5.3.6.9.4 1.3zm.1-3.4C15.2 8.2 8.7 8 5 9.1c-.6.2-1.2-.2-1.4-.7-.2-.6.2-1.2.7-1.4 4.3-1.3 11.4-1 15.9 1.6.5.3.7 1 .4 1.5-.3.5-1 .7-1.5.4z" />`,
  },
  {
    name: "Apple Podcasts",
    color: "text-apple",
    href: podcastShows.map((show) => ({ label: show.name, url: show.appleUrl })),
    icon: `<path d="M12 0a12 12 0 0 0-4.6 23.2c-.3-2.6.6-4.4 1.9-5.9 1.2-1.4 2.6-2.7 2.6-5A6.9 6.9 0 0 0 12 0zm0 3.4a3.5 3.5 0 0 1 3.5 3.5c0 1.7-1 2.7-2 3.9-1 1.1-1.9 2.1-1.7 3.7a2.8 2.8 0 1 1-5.6 0h-.1a6.9 6.9 0 0 1 3.9-6.6zM8.4 18.4a3.6 3.6 0 1 0 7.2 0 3.6 3.6 0 0 0-7.2 0z" />`,
  },
  {
    name: "RSS",
    color: "text-rss",
    href: podcastShows.map((show) => ({ label: show.name, url: show.rssUrl })),
    icon: `<path d="M4 4a16 16 0 0 1 16 16h-3A13 13 0 0 0 4 7V4zm0 6a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7v-3zm2.5 7.5A2.5 2.5 0 1 1 4 20a2.5 2.5 0 0 1 2.5-2.5z" />`,
  },
];

const tabsData = podcastShows.map((show) => ({
  id: show.id,
  name: show.name,
  episodes: show.episodes.map((episode) => ({
    id: episode.id,
    title: episode.title,
    date: episode.date,
    dateLabel: formatDate(episode.date),
    duration: episode.duration,
    description: episode.description,
    spotifyUrl: episode.spotifyUrl,
  })),
}));
---

<Layout
  title="Podcast"
  description="Podcasty Przeprogramowanych — Przeprogramowani ft. Gość i Opanuj.AI Podcast. Najnowsze odcinki na Spotify, Apple Podcasts i RSS."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        podcastShows.map((show) => ({
          "@context": "https://schema.org",
          "@type": "PodcastSeries",
          name: show.name,
          description: show.description,
          url: show.spotifyShowUrl,
          webFeed: show.rssUrl,
          author: {
            "@type": "Organization",
            name: "Przeprogramowani",
            url: "https://przeprogramowani.pl",
          },
        }))
      )}
    />
  </Fragment>

  <!-- Nagłówek -->
  <section class="relative overflow-hidden">
    <div class="dot-grid absolute inset-0" aria-hidden="true"></div>
    <div class="container relative py-16 md:py-24">
      <div class="max-w-3xl">
        <p class="eyebrow">Podcast</p>
        <h1
          class="mt-4 text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl"
        >
          Słuchaj naszych podcastów
        </h1>
        <p class="mt-6 text-base leading-relaxed text-muted sm:text-lg">
          Rozmowy o technologii, AI i programowaniu oraz comiesięczne
          podsumowanie najważniejszych wydarzeń ze świata AI. Prowadzą Przemek
          Smyrdek i Marcin Czarkowski.
        </p>
      </div>
    </div>
  </section>

  <!-- Platformy -->
  <section class="container pb-4">
    <h2 class="sr-only">Gdzie słuchać</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {
        platforms.map((platform) => (
          <div class="card p-6">
            <div class="flex items-center gap-3">
              <span
                class:list={[
                  "flex h-10 w-10 items-center justify-center rounded-xl bg-surface-2",
                  platform.color,
                ]}
              >
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  set:html={platform.icon}
                />
              </span>
              <h3 class="font-display text-lg font-semibold">{platform.name}</h3>
            </div>
            <ul class="mt-4 space-y-2 text-sm">
              {platform.href.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted underline-offset-4 transition-colors hover:text-text hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Odcinki -->
  <section class="container py-16 md:py-24">
    {
      podcastShows.map((show) => (
        <div class="mb-10">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
                {show.name}
              </h2>
              <p class="mt-1 text-sm text-muted">{show.tagline}</p>
            </div>
            <span class="rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs text-muted">
              {show.listeners}
            </span>
          </div>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted">
            {show.description}
          </p>
        </div>
      ))
    }

    <PodcastTabs shows={tabsData} client:load />

    <p class="mt-10 text-center text-sm text-muted">
      Nie korzystasz ze Spotify? Odcinki znajdziesz też w Apple Podcasts i
      przez RSS — linki powyżej.
    </p>
  </section>
</Layout>
