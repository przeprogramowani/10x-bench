---
import Layout from '../layouts/Layout.astro';
import { podcastEpisodes } from '../data/site';
---
<Layout title="Podcast — Przeprogramowani" description="Słuchaj naszych podcastów o technologii, AI i programowaniu">
  <section class="py-20 sm:py-28">
    <div class="container-page">
      <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
        <a href="/" class="hover:text-primary-600 transition-colors">Strona główna</a>
        <span>/</span>
        <span class="text-gray-900 font-medium">Podcast</span>
      </nav>

      <div class="max-w-3xl mb-16">
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 tracking-tight mb-4">Podcasty</h1>
        <p class="text-xl text-gray-600">
          Słuchaj naszych podcastów o technologii, AI i programowaniu
        </p>
      </div>

      <div class="space-y-16">
        {[podcastEpisodes.opanujAI, podcastEpisodes.ftGosc].map((podcast) => (
          <div key={podcast.title}>
            <div class="flex items-center gap-4 mb-8">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary-500 to-accent-500 
                          flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                </svg>
              </div>
              <div>
                <h2 class="text-2xl font-bold text-gray-900">{podcast.title}</h2>
                <p class="text-gray-500">{podcast.description}</p>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
              {podcast.episodes.map((ep, i) => (
                <a
                  key={i}
                  href={ep.href}
                  class="card p-5 hover:-translate-y-0.5 group"
                >
                  <div class="flex items-start justify-between gap-4 mb-3">
                    <span class="text-xs font-mono text-gray-400">{ep.duration}</span>
                    <div class="w-8 h-8 rounded-full bg-primary-50 flex items-center justify-center
                                group-hover:bg-primary-100 transition-colors shrink-0">
                      <svg class="w-4 h-4 text-primary-600 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </div>
                  </div>
                  <h3 class="text-sm font-semibold text-gray-900 group-hover:text-primary-600 transition-colors leading-snug">
                    {ep.title}
                  </h3>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 text-center py-12 bg-gray-50 rounded-2xl">
        <p class="text-lg font-semibold text-gray-900 mb-6">
          Jesteśmy na twojej ulubionej platformie
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          {[
            { name: 'Apple Podcasts', href: 'https://podcasts.apple.com/pl/podcast/przeprogramowani/id1508387250' },
            { name: 'Spotify', href: 'https://open.spotify.com/show/4qHUZJpeBK8Ij9e2wTVm2o' },
            { name: 'Google Podcasts', href: 'https://podcasts.google.com/feed/aHR0cHM6Ly9hbmNob3IuZm0vcy8yMjU0NGI3Yy9wb2RjYXN0L3Jzcw' },
            { name: 'RSS', href: 'https://anchor.fm/s/22544b7c/podcast/rss' },
          ].map((p) => (
            <a
              key={p.name}
              href={p.href}
              class="px-6 py-3 bg-white rounded-xl border border-gray-200 text-sm font-medium
                     text-gray-700 hover:border-primary-300 hover:text-primary-600 transition-all shadow-sm"
            >
              {p.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
