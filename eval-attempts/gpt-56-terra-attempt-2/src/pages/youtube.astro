---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

const videos = [
  ["Darmowe AI na każdym Maku - jak działa Apple Foundational Models na macOS 27", "B4t6w4QsD24", "Opanuj.AI"],
  ["Byliśmy na Google I/O 2026 - wrażenia na gorąco! | Opanuj.AI LIVE", "0JOszZXqKaM", "Opanuj.AI LIVE"],
  ["Byłem na Google I/O 2026. Nie tego się spodziewałem.", "XgyH-HSzKRQ", "Google I/O 2026"],
  ["Jak wybrać najlepszego Agenta AI do programowania?", "03y826SVjG0", "10xDevs"],
  ["5 Agent Skills do jakościowego programowania z AI - Claude Code LIVE DEMO", "S-iNbyLSisE", "Claude Code"],
  ["Poznaj AI Workflow, które działa na produkcji - LIVE 10xDevs", "c5HVzK-tclM", "10xDevs LIVE"],
];
---

<BaseLayout title="YouTube | Przeprogramowani" description="Najnowsze filmy Przeprogramowani na YouTube.">
  <section class="youtube-page">
    <div class="shell">
      <div class="youtube-lead"><div><span class="eyebrow eyebrow-light">Przeprogramowani na YouTube</span><h1>Technologia<br />bez <em>szumu.</em></h1></div><p>Rozkładamy nowe narzędzia, praktyki i wydarzenia technologiczne na czynniki pierwsze. Bez marketingowego filtra.</p></div>
      <article class="youtube-feature">
        <a class="feature-thumb" href="https://www.youtube.com/watch?v=c5HVzK-tclM" target="_blank" rel="noreferrer"><img src="https://i3.ytimg.com/vi/c5HVzK-tclM/maxresdefault.jpg" alt="Poznaj AI Workflow, które działa na produkcji" /><span class="play-button"><Icon name="play" size={16} /></span></a>
        <div class="feature-info"><span class="eyebrow">Ostatnio na kanale</span><h2>Poznaj AI Workflow, które działa na produkcji</h2><p>Live 10xDevs o budowaniu powtarzalnego procesu pracy z agentami AI, od pomysłu aż do wdrożenia.</p><a class="text-link" href="https://www.youtube.com/watch?v=c5HVzK-tclM" target="_blank" rel="noreferrer">Obejrzyj odcinek <Icon name="arrow" size={17} /></a></div>
      </article>
      <h2 class="youtube-section-title">Najnowsze materiały</h2>
      <div class="video-grid">
        {videos.map(([title, id, category]) => <a class="video-card" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noreferrer"><div class="video-thumb"><img src={`https://i3.ytimg.com/vi/${id}/maxresdefault.jpg`} alt="" loading="lazy" /><span class="play-button"><Icon name="play" size={16} /></span></div><h3>{title}</h3><span>{category}</span></a>)}
      </div>
    </div>
  </section>
</BaseLayout>
