---
import Layout from '../layouts/Layout.astro';

const videos = [
  ['Poznaj AI Workflow, które działa na produkcji - LIVE 10xDevs', 'c5HVzK-tclM', 'LIVE 10xDevs'],
  ['Darmowe AI na każdym Maku - jak działa Apple Foundational Models', 'B4t6w4QsD24', 'Opanuj.AI'],
  ['Byliśmy na Google I/O 2026 - wrażenia na gorąco!', '0JOszZXqKaM', 'Opanuj.AI LIVE'],
  ['Byłem na Google I/O 2026. Nie tego się spodziewałem.', 'XgyH-HSzKRQ', 'Przeprogramowani'],
  ['Jak wybrać najlepszego Agenta AI do programowania?', '03y826SVjG0', 'Praktyka'],
  ['5 Agent Skills do jakościowego programowania z AI', 'S-iNbyLSisE', 'Claude Code LIVE DEMO']
];
---

<Layout title="YouTube — Przeprogramowani.pl" description="Najnowsze filmy o programowaniu, AI i rozwoju.">
  <main>
    <section class="relative overflow-hidden bg-ink py-24 text-paper sm:py-32"><div class="absolute bottom-[-130px] right-[-40px] h-[410px] w-[410px] rounded-full border-[42px] border-mint/10"></div><div class="container-shell relative"><p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-mint">/ youtube</p><div class="mt-8 flex flex-col justify-between gap-10 lg:flex-row lg:items-end"><h1 class="font-display text-[clamp(3.8rem,8vw,7.6rem)] font-semibold leading-[0.86] tracking-[-0.08em]">Oglądaj.<br /><span class="text-mint">Myśl szerzej.</span></h1><div class="max-w-[410px]"><p class="text-base leading-7 text-paper/60">Nowe technologie, praktyczne tutoriale i rozmowy z ludźmi, którzy tworzą przyszłość — bez zbędnego hype’u.</p><a href="https://youtube.com/c/przeprogramowani/videos" target="_blank" rel="noreferrer" class="mt-6 inline-flex items-center gap-2 rounded-full bg-mint px-5 py-3 text-sm font-bold text-ink transition hover:bg-lime">Subskrybuj kanał <span>↗</span></a></div></div></div></section>

    <section class="container-shell py-24 sm:py-32"><div class="flex items-end justify-between gap-8"><div><p class="eyebrow">/ najnowsze filmy</p><h2 class="mt-5 font-display text-4xl font-semibold tracking-[-0.07em] sm:text-6xl">Ostatnio<br /><span class="text-forest/45">na kanale.</span></h2></div><p class="hidden max-w-[250px] text-sm leading-6 text-ink/55 sm:block">Wybierz temat, który przyda Ci się w pracy już dziś.</p></div><div class="mt-14 grid gap-x-5 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">{videos.map((video, index) => (<a href={`https://www.youtube.com/watch?v=${video[1]}`} target="_blank" rel="noreferrer" class={`group ${index === 0 ? 'sm:col-span-2 lg:col-span-2' : ''}`}><div class={`relative overflow-hidden rounded-[20px] bg-forest ${index === 0 ? 'aspect-[1.8]' : 'aspect-[1.7]'}`}><img src={`https://i3.ytimg.com/vi/${video[1]}/maxresdefault.jpg`} alt={video[0]} loading={index < 2 ? 'eager' : 'lazy'} class="h-full w-full object-cover transition duration-500 group-hover:scale-105 group-hover:opacity-75" /><span class="absolute left-5 top-5 flex h-10 w-10 items-center justify-center rounded-full bg-mint text-ink"><svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><path d="m5 3 5 4-5 4V3Z"/></svg></span><span class="absolute bottom-5 right-5 font-mono text-[10px] font-semibold tracking-widest text-paper/80">0{index + 1}</span></div><p class="mt-5 font-mono text-[10px] uppercase tracking-[0.14em] text-ink/45">{video[2]}</p><h3 class={`mt-2 max-w-[530px] font-display font-semibold leading-tight tracking-[-0.05em] transition group-hover:text-forest/60 ${index === 0 ? 'text-2xl sm:text-3xl' : 'text-xl'}`}>{video[0]}</h3></a>))}</div></section>

    <section class="container-shell pb-24 sm:pb-32"><div class="grid gap-5 md:grid-cols-[1.15fr_0.85fr]"><div class="rounded-[24px] bg-mint p-8 sm:p-10"><p class="eyebrow">/ masz temat?</p><h2 class="mt-16 max-w-[480px] font-display text-4xl font-semibold leading-[0.94] tracking-[-0.07em] sm:text-5xl">Powiedz nam,<br />czego chcesz<br /><span class="text-forest/50">posłuchać.</span></h2><a href="mailto:kontakt@przeprogramowani.pl" class="mt-9 inline-flex items-center gap-2 font-mono text-[10px] font-semibold uppercase tracking-[0.15em] underline decoration-ink/25 underline-offset-8">Napisz do nas ↗</a></div><div class="rounded-[24px] bg-forest p-8 text-paper sm:p-10"><p class="font-mono text-[10px] uppercase tracking-[0.18em] text-mint">/ kanał</p><p class="mt-16 font-display text-6xl font-semibold leading-none tracking-[-0.08em]">40k<span class="text-mint">+</span></p><p class="mt-4 max-w-[180px] text-sm leading-6 text-paper/55">osób ogląda z nami świat technologii.</p><a href="https://youtube.com/c/przeprogramowani" target="_blank" rel="noreferrer" class="mt-9 inline-flex items-center gap-2 rounded-full border border-paper/25 px-5 py-3 text-sm font-semibold transition hover:border-paper hover:bg-paper hover:text-ink">Otwórz YouTube ↗</a></div></div></section>
  </main>
</Layout>
