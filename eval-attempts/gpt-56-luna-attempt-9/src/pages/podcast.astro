---
import Layout from '../layouts/Layout.astro';

const shows = [
  {
    label: 'OPANUJ.AI PODCAST',
    listeners: 'ponad 4000 słuchaczy',
    intro: 'Comiesięczne podsumowanie najważniejszych wydarzeń ze świata AI.',
    image: 'https://d3t3ozftmdmh3i.cloudfront.net/production/podcast_uploaded_nologo/37949556/37949556-1685638211267-077987255082e.jpg',
    episodes: [
      ['BAN NA AI?! USA BLOKUJE ANTHROPICA i OPEN AI', '01:21:53', 'https://podcasters.spotify.com/pod/show/opanujai'],
      ['Byliśmy na Google I/O 2026 — wrażenia na gorąco!', '01:12:26', 'https://podcasters.spotify.com/pod/show/opanujai'],
      ['GPT-5.5 VS Opus 4.7 — kto rządzi na scenie AI?', '00:47:22', 'https://podcasters.spotify.com/pod/show/opanujai'],
      ['TEGO AI NIE POTRAFI — ARC-AGI-3 i koniec epoki SaaS', '01:39:33', 'https://podcasters.spotify.com/pod/show/opanujai']
    ]
  },
  {
    label: 'PRZEPROGRAMOWANI FT. GOŚĆ',
    listeners: 'ponad 3800 słuchaczy',
    intro: 'Rozmowy dla głodnych wiedzy — o kodzie, karierze i pracy, która ma sens.',
    image: 'https://d3t3ozftmdmh3i.cloudfront.net/staging/podcast_uploaded_nologo/1988530/1988530-1700599022827-301b808b3e021.jpg',
    episodes: [
      ['Programista vs. Angielski: Od strachu do sukcesu', '00:33:45', 'https://podcasters.spotify.com/pod/show/przeprogramowani'],
      ['O dojrzewaniu zawodowym programisty', '00:45:56', 'https://podcasters.spotify.com/pod/show/przeprogramowani'],
      ['Architektura frontendu: Co naprawdę ma znaczenie?', '01:16:44', 'https://podcasters.spotify.com/pod/show/przeprogramowani'],
      ['Co nowego w TypeScript? Zmiany w języku', '01:36:34', 'https://podcasters.spotify.com/pod/show/przeprogramowani']
    ]
  }
];
---

<Layout title="Podcast — Przeprogramowani.pl" description="Podcasty o technologii, AI, programowaniu i rozwoju.">
  <main>
    <section class="relative overflow-hidden bg-forest py-24 text-paper sm:py-32"><div class="absolute -right-16 -top-20 h-80 w-80 rounded-full border-[35px] border-mint/10"></div><div class="container-shell relative"><p class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-mint">/ podcast</p><div class="mt-8 grid gap-8 lg:grid-cols-[1fr_0.7fr] lg:items-end"><h1 class="font-display text-[clamp(3.7rem,8vw,7.5rem)] font-semibold leading-[0.86] tracking-[-0.08em]">Dobre pytania.<br /><span class="text-mint">Lepsze rozmowy.</span></h1><p class="max-w-[390px] text-base leading-7 text-paper/60">Słuchaj o technologii, AI i programowaniu. Z praktykami, którzy mają coś do powiedzenia — nie tylko do sprzedania.</p></div></div></section>

    <section class="container-shell py-24 sm:py-32">
      <div class="flex items-end justify-between gap-6"><div><p class="eyebrow">/ ostatnie odcinki</p><h2 class="mt-5 font-display text-4xl font-semibold tracking-[-0.07em] sm:text-6xl">Włącz i<br /><span class="text-forest/45">słuchaj.</span></h2></div><div class="hidden items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-ink/45 sm:flex"><span class="h-2 w-2 rounded-full bg-mint"></span> aktualizowane na bieżąco</div></div>
      <div class="mt-16 space-y-20">
        {shows.map((show) => (
          <section>
            <div class="grid gap-8 border-b border-line pb-8 lg:grid-cols-[270px_1fr] lg:items-end"><div><div class="aspect-square overflow-hidden rounded-[20px] bg-mint"><img src={show.image} alt={show.label} loading="lazy" class="h-full w-full object-cover mix-blend-multiply opacity-85" /></div></div><div><p class="font-mono text-[10px] font-semibold uppercase tracking-[0.18em] text-forest/60">{show.label}</p><h3 class="mt-3 font-display text-3xl font-semibold tracking-[-0.06em] sm:text-4xl">{show.listeners}</h3><p class="mt-3 max-w-[430px] text-sm leading-6 text-ink/60">{show.intro}</p><a href={show.episodes[0][2]} target="_blank" rel="noreferrer" class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink px-5 py-3 text-sm font-bold text-paper transition hover:bg-forest">Otwórz podcast <span>↗</span></a></div></div>
            <div class="divide-y divide-line">{show.episodes.map((episode, index) => (<a href={episode[2]} target="_blank" rel="noreferrer" class="group grid gap-3 py-5 transition hover:px-3 sm:grid-cols-[48px_1fr_auto] sm:items-center"><span class="font-mono text-xs text-ink/35">0{index + 1}</span><span><span class="block font-display text-lg font-semibold tracking-[-0.04em] transition group-hover:text-forest/60">{episode[0]}</span><span class="mt-1 block font-mono text-[9px] uppercase tracking-[0.15em] text-ink/40">Przeprogramowani · odcinek</span></span><span class="flex items-center justify-between gap-5 font-mono text-[10px] text-ink/45 sm:justify-end"><span>{episode[1]}</span><span class="flex h-8 w-8 items-center justify-center rounded-full border border-ink/15 text-ink transition group-hover:border-ink group-hover:bg-ink group-hover:text-paper">↗</span></span></a>))}</div>
          </section>
        ))}
      </div>
    </section>

    <section class="border-y border-line bg-[#e9eee7] py-20"><div class="container-shell flex flex-col justify-between gap-7 sm:flex-row sm:items-center"><div><p class="eyebrow">/ gdzie słuchać</p><h2 class="mt-4 font-display text-3xl font-semibold tracking-[-0.06em]">Jesteśmy na Twojej<br />ulubionej platformie.</h2></div><div class="flex flex-wrap gap-2"><a href="https://open.spotify.com/show/4qHUZJpeBK8Ij9e2wTVm2o" target="_blank" rel="noreferrer" class="outline-button">Spotify ↗</a><a href="https://podcasts.apple.com/pl/podcast/przeprogramowani/id1508387250" target="_blank" rel="noreferrer" class="outline-button">Apple Podcasts ↗</a></div></div></section>
  </main>
</Layout>
