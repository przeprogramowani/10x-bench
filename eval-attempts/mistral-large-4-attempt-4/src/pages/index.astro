---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Courses from "../components/Courses.astro";
import Newsletter from "../components/Newsletter.astro";
import { site, stats } from "../data/site";
import podcasts from "../data/podcasts.json";
import videos from "../data/videos.json";

const latestEpisodes = podcasts.flatMap((p) =>
  p.episodes.slice(0, 2).map((e) => ({ ...e, podcast: p.name })),
);
const latestVideos = videos.slice(0, 3);
---

<Layout title={site.title} description={site.description} canonicalPath="/">
  <Hero />

  <section class="border-y border-white/10 bg-dark/40">
    <div class="container-page grid grid-cols-2 gap-6 py-10 lg:grid-cols-4">
      {stats.map((s) => (
        <div class="text-center">
          <p class="font-heading text-3xl font-extrabold text-turquoise">{s.value}</p>
          <p class="mt-1 text-sm text-muted">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <Courses />

  <section class="container-page py-16 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-main">Podcast</p>
        <h2 class="mt-2 font-heading text-3xl font-bold">Rozmowy dla głodnych wiedzy</h2>
        <p class="mt-3 text-muted">
          Dwa podcasty: Przeprogramowani ft. Gość oraz Opanuj.AI — nowinki techniczne ze świata programowania i AI.
        </p>
        <ol class="mt-6 space-y-3">
          {latestEpisodes.map((episode) => (
            <li>
              <a
                href={episode.url}
                target="_blank"
                rel="noopener noreferrer"
                class="block rounded-xl border border-white/10 p-4 text-sm transition-colors hover:border-main/50 hover:bg-white/5"
              >
                <span class="line-clamp-2 font-medium">{episode.title}</span>
                <span class="mt-1 block text-xs text-muted">
                  {episode.podcast} · {episode.publishedLabel}
                </span>
              </a>
            </li>
          ))}
        </ol>
        <a href="/podcast" class="mt-6 inline-flex items-center gap-2 font-semibold text-turquoise hover:underline">
          Wszystkie odcinki podcastów →
        </a>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-main">YouTube</p>
        <h2 class="mt-2 font-heading text-3xl font-bold">Najnowsze filmy</h2>
        <p class="mt-3 text-muted">
          Livy, demo day i materiały edukacyjne — razem z kanałem Overment docieramy do ponad 40 000 programistów.
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {latestVideos.map((video) => (
            <a
              href={video.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block overflow-hidden rounded-xl border border-white/10 transition-colors hover:border-turquoise/50"
            >
              <img
                src={video.thumbnailUrl}
                alt={`Miniatura: ${video.title}`}
                class="aspect-video w-full object-cover"
                width="320"
                height="180"
                loading="lazy"
              />
              <p class="line-clamp-2 p-3 text-xs font-medium leading-snug group-hover:text-turquoise">{video.title}</p>
            </a>
          ))}
        </div>
        <a href="/youtube" class="mt-6 inline-flex items-center gap-2 font-semibold text-turquoise hover:underline">
          Wszystkie filmy na YouTube →
        </a>
      </div>
    </div>
  </section>

  <Newsletter />
</Layout>
