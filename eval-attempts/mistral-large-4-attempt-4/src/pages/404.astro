---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Nie znaleziono strony" canonicalPath="/404" noindex={true}>
  <section class="container-page flex flex-col items-center py-24 text-center lg:py-32">
    <p class="font-mono text-7xl font-extrabold text-main">404</p>
    <h1 class="mt-4 font-heading text-3xl font-bold">Nie znaleziono strony</h1>
    <p class="mt-3 max-w-md text-muted">
      Strona, której szukasz, nie istnieje lub została przeniesiona. Wróć na stronę główną i znajdź to, czego potrzebujesz.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-xl bg-main px-6 py-3 font-semibold text-white transition-colors hover:bg-main-hover"
    >
      Wróć na stronę główną
    </a>
  </section>
</Layout>
