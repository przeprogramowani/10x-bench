---
import { Mail } from "lucide-react";
import { site } from "../data/site";
---

<section class="container-page py-16 lg:py-24">
  <div class="card relative overflow-hidden border-turquoise/20 p-8 sm:p-12">
    <div class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-turquoise/10 blur-3xl"></div>
    <div class="grid items-center gap-8 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-turquoise">
          <Mail size={16} aria-hidden="true" />
          Przeprogramowany Newsletter
        </p>
        <h2 class="mt-3 font-heading text-3xl font-bold sm:text-4xl">Co piątek prosto na Twoją skrzynkę</h2>
        <p class="mt-3 max-w-xl text-muted">
          Format 3-2-1: trzy rekomendacje techniczne, dwie rekomendacje rozwojowe i jeden bonus — zawsze konkret, bez
          lania wody.
        </p>
      </div>
      <div class="lg:justify-self-end">
        <a
          href={site.socials.newsletter}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-turquoise px-6 py-4 text-base font-bold text-surface transition-colors hover:bg-turquoise/90 lg:w-auto"
        >
          <Mail size={20} aria-hidden="true" />
          Zapisz się do newslettera
        </a>
      </div>
    </div>
  </div>
</section>
