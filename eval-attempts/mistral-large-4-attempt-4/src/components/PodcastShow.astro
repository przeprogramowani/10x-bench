---
import { Clock, ExternalLink, Rss } from "lucide-react";

interface Episode {
  title: string;
  description: string;
  url: string;
  publishedAt: string;
  publishedLabel: string;
  duration: string;
}

interface Props {
  name: string;
  title: string;
  tagline: string;
  description: string;
  coverUrl: string;
  platforms: {
    spotify: string;
    apple: string;
    rss: string;
    anchor: string;
  };
  episodes: Episode[];
}

const { name, title, tagline, description, coverUrl, platforms, episodes } = Astro.props;

const platformLinks = [
  { label: "Spotify", href: platforms.spotify, icon: "/img/podcast/podcast-spotify.png" },
  { label: "Apple Podcasts", href: platforms.apple, icon: "/img/podcast/podcast-apple.png" },
  { label: "RSS", href: platforms.rss, icon: "/img/podcast/podcast-rss.png" },
];
---

<article class="card overflow-hidden">
  <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[280px_1fr]">
    <div>
      <img
        src={coverUrl}
        alt={`Okładka podcastu ${name}`}
        class="aspect-square w-full rounded-2xl object-cover shadow-lg"
        width="280"
        height="280"
        loading="lazy"
      />
    </div>
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-turquoise">{title}</p>
      <h3 class="mt-1 font-heading text-3xl font-bold">{name}</h3>
      <p class="mt-2 text-lg font-medium text-main">{tagline}</p>
      <p class="mt-3 text-sm text-muted">{description}</p>

      <ul class="mt-6 flex flex-wrap items-center gap-3" aria-label={`Platformy podcastu ${name}`}>
        {platformLinks.map((p) => (
          <li>
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-turquoise/50 hover:text-turquoise"
            >
              <img src={p.icon} alt="" aria-hidden="true" class="h-5 w-5 rounded-sm" width="20" height="20" />
              {p.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={platforms.anchor}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-turquoise/50 hover:text-turquoise"
          >
            <Rss size={18} aria-hidden="true" />
            Anchor.fm
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10 px-6 pb-6 sm:px-8">
    <h4 class="mb-4 mt-6 font-heading text-lg font-semibold">Ostatnie odcinki</h4>
    <ol class="space-y-3">
      {episodes.map((episode) => (
        <li>
          <a
            href={episode.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start gap-4 rounded-xl border border-transparent p-3 transition-colors hover:border-white/10 hover:bg-white/5"
          >
            <span
              class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-main/15 text-main"
              aria-hidden="true"
            >
              <ExternalLink size={16} />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-medium leading-snug group-hover:text-turquoise">{episode.title}</span>
              <span class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted">
                <time datetime={episode.publishedAt}>{episode.publishedLabel}</time>
                {episode.duration && (
                  <span class="inline-flex items-center gap-1">
                    <Clock size={12} aria-hidden="true" />
                    {episode.duration}
                  </span>
                )}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</article>
