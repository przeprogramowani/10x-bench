---
import { ArrowRight } from "lucide-react";
import type { Course } from "../data/courses";
import { courses, moreCourses } from "../data/courses";

interface Props {
  heading?: string;
  subheading?: string;
  showAll?: boolean;
}

const {
  heading = "Nasze kursy",
  subheading = "Programy szkoleniowe prowadzone przez seniorów z realnym doświadczeniem produktowym",
  showAll = true,
} = Astro.props;

const accentClasses: Record<Course["accent"], string> = {
  main: "from-main/20 to-main/5 hover:border-main/50",
  turquoise: "from-turquoise/20 to-turquoise/5 hover:border-turquoise/50",
  sky: "from-sky-500/20 to-sky-500/5 hover:border-sky-400/50",
  pink: "from-pink-500/20 to-pink-500/5 hover:border-pink-400/50",
  cyan: "from-cyan-500/20 to-cyan-500/5 hover:border-cyan-400/50",
};

const accentText: Record<Course["accent"], string> = {
  main: "text-main",
  turquoise: "text-turquoise",
  sky: "text-sky-300",
  pink: "text-pink-300",
  cyan: "text-cyan-300",
};
---

<section id="kursy" class="container-page scroll-mt-20 py-16 lg:py-24">
  <div class="max-w-2xl">
    <h2 class="font-heading text-3xl font-bold sm:text-4xl">{heading}</h2>
    <p class="mt-3 text-lg text-muted">{subheading}</p>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {courses.map((course) => (
      <article
        class={`card group flex flex-col overflow-hidden bg-gradient-to-b transition-colors ${accentClasses[course.accent]}`}
      >
        <div class="relative aspect-video overflow-hidden">
          <img
            src={course.imageUrl}
            alt={`Kurs ${course.name}`}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            width="640"
            height="360"
            loading="lazy"
          />
          {course.meta && (
            <span class="absolute left-4 top-4 rounded-full bg-surface/85 px-3 py-1 text-xs font-semibold text-ink backdrop-blur">
              {course.meta}
            </span>
          )}
        </div>
        <div class="flex flex-1 flex-col p-6">
          <p class={`text-xs font-bold uppercase tracking-wider ${accentText[course.accent]}`}>{course.label}</p>
          <h3 class="mt-1 font-heading text-2xl font-bold">{course.name}</h3>
          <p class="mt-2 flex-1 text-sm text-muted">{course.description}</p>
          <a
            href={course.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`mt-5 inline-flex items-center gap-2 text-sm font-semibold transition-colors ${accentText[course.accent]} hover:underline`}
          >
            {course.ctaText}
            <ArrowRight size={16} aria-hidden="true" className="transition-transform group-hover:translate-x-1" />
          </a>
        </div>
      </article>
    ))}
  </div>

  {showAll && (
    <div class="mt-12">
      <h3 class="font-heading text-xl font-semibold">Pozostałe programy</h3>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {moreCourses.map((course) => (
          <article class={`card flex items-start gap-4 p-5 transition-colors ${accentClasses[course.accent]}`}>
            <img
              src={course.imageUrl}
              alt=""
              aria-hidden="true"
              class="h-14 w-14 shrink-0 rounded-xl object-cover"
              width="56"
              height="56"
              loading="lazy"
            />
            <div>
              <h4 class="font-heading text-lg font-bold">{course.name}</h4>
              <p class="mt-1 text-sm text-muted">{course.description}</p>
              {course.meta && <p class="mt-2 text-xs font-semibold text-turquoise">{course.meta}</p>}
              <a
                href={course.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-ink hover:text-turquoise"
              >
                {course.ctaText}
                <ArrowRight size={14} aria-hidden="true" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  )}
</section>
