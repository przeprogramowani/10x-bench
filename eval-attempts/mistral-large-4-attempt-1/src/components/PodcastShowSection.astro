---
import type { PodcastShow } from "@/data/podcasts";

interface Props {
  show: PodcastShow;
}

const { show } = Astro.props;

const platformButtons = [
  {
    label: "Spotify",
    href: show.platforms.spotify,
    icon: `<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.5 17.3c-.2.36-.66.47-1.02.25-2.8-1.7-6.3-2.1-10.45-1.15-.4.1-.8-.16-.9-.56-.1-.4.16-.8.56-.9 4.53-1.03 8.42-.58 11.56 1.33.36.2.47.66.25 1.02zm1.47-3.27c-.28.45-.86.6-1.3.32-3.2-1.97-8.08-2.54-11.86-1.39-.5.15-1.04-.13-1.2-.63-.15-.5.13-1.04.64-1.2 4.32-1.31 9.7-.67 13.4 1.58.44.27.58.86.3 1.3zm.13-3.4C15.3 8.35 8.94 8.14 5.28 9.25c-.6.18-1.24-.16-1.42-.76-.18-.6.16-1.24.76-1.42 4.2-1.27 11.18-1.03 15.6 1.6.54.32.72 1.02.4 1.56-.32.53-1.02.7-1.56.4z"/></svg>`,
  },
  {
    label: "Apple Podcasts",
    href: show.platforms.apple,
    icon: `<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="6"/><path d="M12 18h.01"/></svg>`,
  },
  ...(show.platforms.google
    ? [
        {
          label: "Google Podcasts",
          href: show.platforms.google,
          icon: `<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/></svg>`,
        },
      ]
    : []),
  {
    label: "RSS",
    href: show.platforms.rss,
    icon: `<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor"/></svg>`,
  },
];
---

<article class="card p-6 lg:p-10" aria-labelledby={`show-${show.id}`}>
  <div class="grid gap-10 lg:grid-cols-[280px_1fr]">
    <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
      <img
        src={show.cover}
        alt={`Okładka podcastu ${show.name}`}
        width={280}
        height={280}
        loading="lazy"
        class="aspect-square w-full max-w-[280px] rounded-2xl border border-slate-800 object-cover shadow-2xl shadow-black/50"
      />
      <h2 id={`show-${show.id}`} class="mt-5 font-display text-2xl font-bold text-white">
        {show.name}
      </h2>
      <p class="mt-1 inline-flex items-center gap-2 text-sm font-medium text-violet-400">
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path>
        </svg>
        {show.listeners}
      </p>
      <p class="mt-3 text-sm leading-relaxed text-slate-400">{show.description}</p>
      <div class="mt-5 flex flex-wrap justify-center gap-2 lg:justify-start">
        {
          platformButtons.map((button) => (
            <a
              href={button.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-800/60 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-violet-500/60 hover:text-white"
            >
              <Fragment set:html={button.icon} />
              {button.label}
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400">
        Ostatnie odcinki
      </h3>
      <ul class="mt-4 space-y-3">
        {
          show.episodes.map((episode) => (
            <li>
              <a
                href={episode.url}
                target="_blank"
                rel="noopener noreferrer"
                class="card group flex items-start gap-4 p-4 transition hover:border-violet-500/50 hover:bg-slate-900/80"
              >
                <span class="mt-0.5 inline-flex shrink-0 items-center rounded-lg bg-slate-800 px-2.5 py-1 font-mono text-xs font-medium text-slate-300">
                  {episode.duration}
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold leading-snug text-slate-100 transition group-hover:text-violet-300">
                    {episode.title}
                  </span>
                  <span class="mt-1 line-clamp-2 text-xs leading-relaxed text-slate-400">
                    {episode.description}
                  </span>
                  <span class="mt-1.5 inline-flex items-center gap-1 text-xs font-medium text-violet-400">
                    Posłuchaj
                    <svg
                      class="h-3 w-3"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17 17 7M8 7h9v9" />
                    </svg>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</article>
