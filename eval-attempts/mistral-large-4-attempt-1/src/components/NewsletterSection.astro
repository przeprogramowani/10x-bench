---
import { newsletterUrl } from "@/data/site";

const format321 = [
  { value: "3", label: "rekomendacje techniczne" },
  { value: "2", label: "rekomendacje rozwojowe" },
  { value: "1", label: "bonus — niespodzianka" },
];
---

<section id="newsletter" class="scroll-mt-24 py-20 lg:py-28" aria-labelledby="newsletter-title">
  <div class="container-page">
    <div class="card relative overflow-hidden p-8 lg:p-12">
      <div class="orb -right-24 -top-24 h-72 w-72 bg-fuchsia-600" aria-hidden="true"></div>
      <div class="orb -bottom-24 -left-24 h-72 w-72 bg-violet-700" aria-hidden="true"></div>
      <div class="relative grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="eyebrow">Newsletter</p>
          <h2
            id="newsletter-title"
            class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl"
          >
            Przeprogramowany <span class="gradient-text">Newsletter</span>
          </h2>
          <p class="mt-4 text-base leading-relaxed text-slate-300">
            Co tydzień w piątek otrzymasz porcję wartościowych treści w formacie 3-2-1.
            Nie przegapisz też nowości od Przeprogramowanych i ofert specjalnych.
          </p>
          <ul class="mt-6 space-y-3">
            {
              format321.map((item) => (
                <li class="flex items-center gap-3">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500 to-fuchsia-500 font-display text-lg font-bold text-white">
                    {item.value}
                  </span>
                  <span class="text-sm text-slate-300">{item.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex flex-col items-center gap-4 text-center lg:items-start lg:text-left">
          <p class="text-sm text-slate-400">
            Dołącz do tysięcy programistów, którzy co piątek zaczynają tydzień od dawki
            wartościowej wiedzy.
          </p>
          <a
            href={newsletterUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary w-full lg:w-auto"
          >
            Zapisz się za darmo
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <p class="text-xs text-slate-500">Wysyłamy tylko wartościowe treści. Zero spamu.</p>
        </div>
      </div>
    </div>
  </div>
</section>
