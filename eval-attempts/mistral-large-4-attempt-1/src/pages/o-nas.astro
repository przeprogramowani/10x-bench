---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import TrustedBy from "@/components/TrustedBy.astro";
import { site, newsletterUrl, youtubeChannelUrl } from "@/data/site";
import { team, stats } from "@/data/team";

const whatWeDo = [
  {
    title: "Podcasty",
    description: "Opanuj.AI Podcast i Przeprogramowani ft. Gość — rozmowy o technologii, AI i rozwoju.",
    href: "/podcast",
    cta: "Posłuchaj odcinków",
    icon: `<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/></svg>`,
  },
  {
    title: "YouTube",
    description: "Materiały edukacyjne, live'y i kulisy projektów — ponad setka filmów na kanale.",
    href: "/youtube",
    cta: "Zobacz filmy",
    icon: `<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3V9z"/></svg>`,
  },
  {
    title: "Kursy",
    description: "10xDevs, Opanuj Frontend i Opanuj TypeScript — programy, które zmieniają sposób pracy.",
    href: "/#kursy",
    cta: "Poznaj kursy",
    icon: `<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></svg>`,
  },
  {
    title: "Newsletter",
    description: "Przeprogramowany Newsletter — format 3-2-1, co tydzień w piątek.",
    href: "/#newsletter",
    cta: "Zapisz się",
    icon: `<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>`,
  },
];
---

<BaseLayout
  title="O nas"
  description="Poznaj Przeprogramowanych — Przemka Smyrdka i Marcina Czarkowskiego. Łączymy świat programowania, biznesu i rozwoju osobistego."
>
  <PageHero
    eyebrow="O nas"
    title="Łączymy świat programowania, biznesu i rozwoju"
    lead="Przeprogramowani to miejsce, w którym programowanie spotyka się z rozwojem osobistym."
  />

  <section class="pb-16 lg:pb-24" aria-labelledby="about-title">
    <div class="container-page">
      <div class="mx-auto max-w-3xl space-y-6 text-base leading-relaxed text-slate-300 sm:text-lg">
        <p class="text-xl font-medium text-white">
          Wierzymy, że najlepsi programiści to ci, którzy patrzą szerzej — na architekturę,
          na biznes, na ludzi i na siebie.
        </p>
        <p>
          Tworzymy treści, kursy i narzędzia, które pomagają programistom rozwijać się na
          wielu płaszczyznach. Od technicznych deep-dive'ów po rozmowy o karierze i rozwoju.
        </p>
        <p class="font-semibold text-violet-300">Zyskaj szersze spojrzenie na programowanie.</p>
      </div>
    </div>
  </section>

  <section class="pb-16 lg:pb-24" aria-labelledby="team-title">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Zespół</p>
        <h2
          id="team-title"
          class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl"
        >
          Poznaj nas
        </h2>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-2">
        {
          team.map((member) => (
            <li class="card flex flex-col p-6 text-center transition hover:border-violet-500/50 sm:p-8">
              <img
                src={member.photo}
                alt={`Zdjęcie: ${member.name}`}
                width={160}
                height={160}
                loading="lazy"
                class="mx-auto h-32 w-32 rounded-full border-2 border-violet-500/40 object-cover shadow-lg shadow-violet-950/40"
              />
              <h3 class="mt-5 font-display text-xl font-bold text-white">{member.name}</h3>
              <p class="mt-1 text-sm font-medium text-violet-400">{member.role}</p>
              <p class="mt-4 text-sm leading-relaxed text-slate-400">{member.bio}</p>
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary mx-auto mt-6 w-full sm:w-auto"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45z" />
                </svg>
                LinkedIn
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-y border-slate-800/80 bg-slate-900/20 py-16" aria-label="Nasze liczby">
    <div class="container-page">
      <dl class="grid grid-cols-2 gap-6 lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="text-center">
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <div class="gradient-text font-display text-4xl font-bold">{stat.value}</div>
                <div class="mt-2 text-sm text-slate-400">{stat.label}</div>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="py-16 lg:py-24" aria-labelledby="whatwedo-title">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Nasza działalność</p>
        <h2
          id="whatwedo-title"
          class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl"
        >
          Co robimy?
        </h2>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          whatWeDo.map((item) => (
            <li class="card group flex flex-col p-6 transition hover:-translate-y-1 hover:border-violet-500/50">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-violet-600 to-fuchsia-600 text-white">
                <Fragment set:html={item.icon} />
              </span>
              <h3 class="mt-4 font-display text-lg font-bold text-white">{item.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">{item.description}</p>
              <a
                href={item.href}
                class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-violet-400 transition hover:text-violet-300"
              >
                {item.cta}
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="pb-16 lg:pb-24" aria-labelledby="contact-title">
    <div class="container-page">
      <div class="card relative overflow-hidden p-8 text-center lg:p-12">
        <div class="orb -left-16 -top-16 h-64 w-64 bg-violet-600" aria-hidden="true"></div>
        <div class="orb -bottom-16 -right-16 h-64 w-64 bg-orange-600" aria-hidden="true"></div>
        <div class="relative">
          <h2 id="contact-title" class="font-display text-2xl font-bold text-white sm:text-3xl">
            Chcesz nawiązać współpracę?
          </h2>
          <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-slate-400">
            Prowadzimy szkolenia i warsztaty dla firm, tworzymy treści edukacyjne i dzielimy
            się wiedzą ze społecznością. Odezwwij się do nas!
          </p>
          <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href={`mailto:${site.email}`} class="btn-primary">
              {site.email}
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
            <a href={newsletterUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
              Newsletter
            </a>
            <a
              href={youtubeChannelUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              YouTube
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustedBy />
</BaseLayout>
