---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero";
import CoursesSection from "@/components/CoursesSection";
import PodcastSection from "@/components/PodcastSection";
import VideoGrid from "@/components/VideoGrid";
import NewsletterSection from "@/components/NewsletterSection.astro";
import TrustedBy from "@/components/TrustedBy.astro";
import { site, youtubeChannelUrl } from "@/data/site";
import { videos } from "@/data/videos";
---

<BaseLayout title={site.title}>
  <Hero client:load />
  <CoursesSection client:visible />
  <PodcastSection client:visible episodeCount={3} />

  <section id="youtube" class="scroll-mt-24 py-20 lg:py-28" aria-labelledby="youtube-title">
    <div class="container-page">
      <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div class="max-w-2xl">
          <p class="eyebrow">YouTube</p>
          <h2
            id="youtube-title"
            class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl"
          >
            Ostatnie <span class="gradient-text">filmy</span>
          </h2>
          <p class="mt-4 text-base leading-relaxed text-slate-400 sm:text-lg">
            Rozwój nowoczesnego programisty — materiały, live'y i kulisy naszych projektów
            prosto z kanału YouTube.
          </p>
        </div>
        <a
          href={youtubeChannelUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary shrink-0"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z" />
          </svg>
          Subskrybuj kanał
        </a>
      </div>
      <div class="mt-12">
        <VideoGrid client:visible videos={videos} initialCount={3} step={3} />
      </div>
      <div class="mt-10 text-center">
        <a href="/youtube" class="btn-secondary">
          Wszystkie filmy na YouTube
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <NewsletterSection />
  <TrustedBy />
</BaseLayout>
