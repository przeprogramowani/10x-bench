---
import Layout from '../layouts/Layout.astro';
import { VideoFilter } from '../components/react/interactive';
import { videos } from '../data/content';
---
<Layout title="YouTube — Przeprogramowani.pl" description="Ostatnie filmy Przeprogramowanych: AI, 10xDevs, workflow z agentami, benchmarki.">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-red-400">YouTube</p>
    <h1 class="mt-2 text-4xl sm:text-5xl font-extrabold font-display">Rozwój nowoczesnego programisty na wideo</h1>
    <p class="mt-4 max-w-2xl text-slate-300">Kanał <a class="text-yellow-300 hover:underline" href="https://youtube.com/c/przeprogramowani/videos" target="_blank" rel="noopener">youtube.com/c/przeprogramowani</a> — AI w praktyce, Demo Day 10xDevs, hackathony, workflow z agentami.</p>
    <div class="mt-10"><VideoFilter client:load items={videos} /></div>
  </div>
</Layout>
