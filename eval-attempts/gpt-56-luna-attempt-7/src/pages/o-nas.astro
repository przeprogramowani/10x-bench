---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { brands, team } from '../data/content';
---

<BaseLayout title="O nas — Przeprogramowani.pl" description="Poznaj Przeprogramowanych: łączymy świat programowania, biznesu i rozwoju.">
  <section class="relative overflow-hidden bg-ink py-24 text-paper md:py-32">
    <div class="dot-grid absolute right-[-40px] top-[-120px] h-[430px] w-[430px] rounded-full opacity-50" />
    <div class="container-wide relative z-10">
      <p class="eyebrow eyebrow-light">O nas / 01</p>
      <h1 class="display mt-6 max-w-[900px] text-[clamp(3.6rem,8vw,8rem)] font-medium leading-[0.86] tracking-[-0.1em]">Łączymy kod,<br /><span class="text-lime">kontekst</span> i ludzi.</h1>
      <div class="mt-12 grid gap-8 md:grid-cols-[1fr_0.65fr] md:items-end">
        <p class="max-w-[610px] text-lg leading-8 text-paper/65">Przeprogramowani to miejsce, w którym programowanie spotyka się z rozwojem osobistym. Wierzymy, że najlepsi programiści patrzą szerzej — na architekturę, biznes, ludzi i na siebie.</p>
        <div class="border-l border-lime/40 pl-5 text-sm leading-6 text-paper/55"><span class="text-lime">2019 → teraz</span><br />Tworzymy rzeczy, które pomagają programistom rozwijać się świadomie.</div>
      </div>
    </div>
  </section>

  <section class="container-wide py-24 md:py-32">
    <div class="grid gap-16 md:grid-cols-[0.7fr_1.3fr]">
      <div><p class="eyebrow">Nasza filozofia</p><p class="display mt-5 text-4xl font-semibold leading-[0.95] tracking-[-0.08em] md:text-5xl">Szerzej znaczy<br /><span class="text-coral">lepiej.</span></p></div>
      <div class="grid gap-8 sm:grid-cols-2">
        <div class="border-t-2 border-ink pt-5"><span class="display text-4xl font-semibold tracking-[-0.08em]">01</span><h2 class="mt-6 text-lg font-bold">Technologia z kontekstem</h2><p class="mt-3 text-sm leading-6 text-ink/55">Nie gonimy za nowością dla samej nowości. Pokazujemy, kiedy dane narzędzie ma sens i jak wpływa na cały system.</p></div>
        <div class="border-t-2 border-ink pt-5"><span class="display text-4xl font-semibold tracking-[-0.08em]">02</span><h2 class="mt-6 text-lg font-bold">Praktyka przed teorią</h2><p class="mt-3 text-sm leading-6 text-ink/55">Każdy program i materiał prowadzi do działania. Budujesz, testujesz, wdrażasz i uczysz się na realnych decyzjach.</p></div>
        <div class="border-t-2 border-ink pt-5"><span class="display text-4xl font-semibold tracking-[-0.08em]">03</span><h2 class="mt-6 text-lg font-bold">Rozwój, który zostaje</h2><p class="mt-3 text-sm leading-6 text-ink/55">Uczymy sposobu myślenia i pracy, który nie dezaktualizuje się wraz z kolejną wersją frameworka.</p></div>
        <div class="border-t-2 border-ink pt-5"><span class="display text-4xl font-semibold tracking-[-0.08em]">04</span><h2 class="mt-6 text-lg font-bold">Bez zadęcia</h2><p class="mt-3 text-sm leading-6 text-ink/55">Można mówić o złożonych rzeczach prosto. Wierzymy w konkrety, poczucie humoru i zdrowy sceptycyzm.</p></div>
      </div>
    </div>
  </section>

  <section class="bg-[#e9e4da] py-24 md:py-32">
    <div class="container-wide">
      <SectionHeading eyebrow="Ludzie za projektem" title="Dwie głowy. Jeden szeroki kadr." description="Doświadczenie z dużych produktów, ciekawość i codzienna praca nad tym, żeby dzielić się tym, co naprawdę działa." />
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {team.map((person, index) => (
          <article class="group overflow-hidden rounded-[24px] bg-paper">
            <div class="relative aspect-[4/3] overflow-hidden bg-ink"><img src={person.image} alt={person.name} class="h-full w-full object-cover object-top grayscale transition duration-500 group-hover:scale-105 group-hover:grayscale-0" /><span class="absolute left-5 top-5 grid h-10 w-10 place-items-center rounded-full bg-lime text-sm font-bold text-ink">0{index + 1}</span></div>
            <div class="p-6 md:p-8"><p class="eyebrow">{person.role}</p><h2 class="display mt-3 text-3xl font-semibold tracking-[-0.07em]">{person.name}</h2><p class="mt-4 text-sm leading-6 text-ink/60">{person.bio}</p><a href={person.linkedin} target="_blank" rel="noreferrer" class="link-arrow mt-6">LinkedIn</a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-wide py-24 md:py-32">
    <div class="grid gap-12 md:grid-cols-[1fr_1fr] md:items-center">
      <div><p class="eyebrow">Dla społeczności</p><h2 class="display mt-5 max-w-[520px] text-5xl font-semibold leading-[0.92] tracking-[-0.08em]">Nie musisz robić tego <span class="text-coral">sam.</span></h2><p class="mt-6 max-w-[470px] text-base leading-7 text-ink/60">Dzielimy się wiedzą przez podcast, YouTube, newsletter i programy edukacyjne. Dołącz do ludzi, którzy chcą rozumieć więcej, a nie tylko robić szybciej.</p><a href="https://przeprogramowani.circle.so/join" class="link-arrow mt-8">Dołącz do społeczności</a></div>
      <div class="relative overflow-hidden rounded-[26px] bg-ink p-8 text-paper md:p-12"><div class="absolute right-[-50px] top-[-60px] h-56 w-56 rounded-full border-[28px] border-coral/30" /><p class="eyebrow eyebrow-light">Nasza obietnica</p><p class="display relative z-10 mt-7 text-4xl font-medium leading-[0.98] tracking-[-0.08em] md:text-5xl">„Nie tylko wiesz, co robić. Wiesz też <span class="text-lime">dlaczego.</span>”</p><div class="relative z-10 mt-12 border-t border-white/15 pt-4 text-xs text-paper/45">Przeprogramowani.pl<br />Szersze spojrzenie na programowanie</div></div>
    </div>
  </section>

  <section class="bg-lime py-20">
    <div class="container-wide flex flex-col justify-between gap-8 md:flex-row md:items-end"><div><p class="eyebrow !text-ink/55">Współpraca</p><h2 class="display mt-4 max-w-[650px] text-5xl font-semibold leading-[0.9] tracking-[-0.08em] md:text-7xl">Zróbmy coś<br />dobrego.</h2></div><a href="mailto:kontakt@przeprogramowani.pl" class="link-arrow text-lg">kontakt@przeprogramowani.pl</a></div>
  </section>

  <section class="container-wide py-20"><p class="eyebrow">Zaufali nam</p><div class="mt-8 grid grid-cols-2 gap-6 border-y border-ink/10 py-8 text-sm font-semibold text-ink/45 sm:grid-cols-3 md:grid-cols-6">{brands.map((brand) => <span>{brand}</span>)}</div></section>
</BaseLayout>
