---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { brands, courses, episodes, videos } from '../data/content';

const featuredVideo = videos[0];
const courseCards = courses.filter((course) => course.id !== 'ai');
---

<BaseLayout>
  <section class="noise relative overflow-hidden bg-ink text-paper">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_82%_16%,rgba(49,72,217,0.42),transparent_34%),radial-gradient(circle_at_23%_90%,rgba(217,250,105,0.1),transparent_30%)]" />
    <div class="dot-grid absolute right-[-100px] top-[-80px] h-[430px] w-[430px] rounded-full opacity-60" />
    <div class="container-wide relative z-10 grid min-h-[650px] items-center gap-12 py-16 md:grid-cols-[1.05fr_0.95fr] md:py-24">
      <div class="max-w-[680px]">
        <div class="mb-8 flex items-center gap-3 text-xs font-semibold text-paper/60">
          <span class="grid h-7 w-7 place-items-center rounded-full border border-lime/40 text-lime">✦</span>
          <span>Technologia bez bańki. Rozwój bez skrótów.</span>
        </div>
        <h1 class="display max-w-[730px] text-[clamp(3.6rem,8vw,7.7rem)] font-medium leading-[0.86] tracking-[-0.095em]">
          Programuj<span class="text-lime">.</span><br />
          Rozwijaj się<span class="text-lime">.</span><br />
          Patrz <span class="text-lime">szerzej.</span>
        </h1>
        <p class="mt-9 max-w-[440px] text-base leading-7 text-paper/65 md:text-lg">Łączymy świat programowania, biznesu i rozwoju. Dajemy Ci kontekst, który pomaga podejmować lepsze decyzje i budować rzeczy, z których można być dumnym.</p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="#kursy" class="inline-flex items-center gap-3 rounded-full bg-lime px-5 py-3.5 text-sm font-bold text-ink transition-transform hover:-translate-y-1">Znajdź swój kierunek <span class="text-lg">↓</span></a>
          <a href="/o-nas" class="link-arrow text-sm text-paper/80">Poznaj nas</a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[480px] md:justify-self-end">
        <div class="absolute -right-4 -top-8 z-20 rotate-6 rounded-full bg-coral px-4 py-2 text-[10px] font-bold uppercase tracking-[0.14em] text-ink shadow-xl md:-right-8">Nowa edycja · 14.09</div>
        <div class="relative overflow-hidden rounded-[28px] border border-white/15 bg-[#242644] p-5 shadow-2xl shadow-black/30 md:p-7">
          <div class="absolute -right-24 -top-24 h-64 w-64 rounded-full bg-lime/20 blur-3xl" />
          <div class="relative z-10 flex items-start justify-between text-[10px] font-bold uppercase tracking-[0.16em] text-paper/50">
            <span>Przeprogramowani presents</span><span class="text-lime">04.0</span>
          </div>
          <div class="relative z-10 mt-12 flex items-end justify-between gap-5">
            <div>
              <div class="display text-7xl font-bold leading-none tracking-[-0.1em] text-lime md:text-8xl">10x</div>
              <div class="display mt-1 text-3xl font-semibold leading-none tracking-[-0.08em] text-paper">DEVS</div>
            </div>
            <div class="grid h-24 w-24 place-items-center rounded-full border border-lime/35 bg-lime/10 md:h-32 md:w-32">
              <span class="display text-center text-[10px] font-bold uppercase leading-4 tracking-[0.1em] text-lime">AI-native<br />software<br />engineering</span>
            </div>
          </div>
          <div class="relative z-10 mt-12 grid grid-cols-2 gap-3 border-t border-white/10 pt-4 text-[11px] text-paper/60">
            <span>5+1 tygodni<br /><strong class="text-paper">praktycznej nauki</strong></span>
            <span class="text-right">6700+<br /><strong class="text-paper">absolwentów</strong></span>
          </div>
          <div class="absolute bottom-[-70px] left-[-50px] h-48 w-48 rounded-full border-[25px] border-coral/30" />
        </div>
        <div class="mt-4 flex items-center justify-between px-1 text-[11px] font-medium text-paper/40"><span>Od promptowania</span><span class="h-px flex-1 mx-4 bg-white/20"></span><span>do dowożenia</span></div>
      </div>
    </div>
  </section>

  <section class="border-b border-ink/10 bg-paper">
    <div class="container-wide grid grid-cols-2 gap-y-8 py-10 sm:grid-cols-4 md:py-12">
      <div><p class="display text-4xl font-semibold tracking-[-0.08em]">7<span class="text-coral">+</span></p><p class="mt-1 text-xs font-medium text-ink/50">lat na rynku edukacji</p></div>
      <div><p class="display text-4xl font-semibold tracking-[-0.08em]">1.5k<span class="text-coral">+</span></p><p class="mt-1 text-xs font-medium text-ink/50">przeszkolonych devów</p></div>
      <div><p class="display text-4xl font-semibold tracking-[-0.08em]">400<span class="text-coral">+</span></p><p class="mt-1 text-xs font-medium text-ink/50">odcinków podcastów</p></div>
      <div><p class="display text-4xl font-semibold tracking-[-0.08em]">∞</p><p class="mt-1 text-xs font-medium text-ink/50">ciekawości do nakarmienia</p></div>
    </div>
  </section>

  <section class="container-wide py-24 md:py-32">
    <div class="grid items-end gap-10 md:grid-cols-[0.75fr_1.25fr]">
      <p class="eyebrow">01 / nasze podejście</p>
      <div>
        <h2 class="display max-w-[820px] text-4xl font-medium leading-[0.98] tracking-[-0.08em] md:text-6xl">Nie uczymy narzędzi. Uczymy <span class="text-coral">myśleć jak inżynier.</span></h2>
        <p class="mt-8 max-w-[600px] text-base leading-7 text-ink/60">Technologie zmieniają się szybciej niż kiedykolwiek. Dlatego zamiast kolejnej listy frameworków budujemy kompetencje, które zostają: rozumienie systemów, świadome decyzje i umiejętność dowożenia wartości.</p>
        <a href="/o-nas" class="link-arrow mt-8">Dowiedz się, jak działamy</a>
      </div>
    </div>
  </section>

  <section id="kursy" class="bg-[#e9e4da] py-24 md:py-32">
    <div class="container-wide">
      <SectionHeading eyebrow="02 / ścieżki rozwoju" title="Wybierz swój następny level." description="Od fundamentów dobrego frontendu po pracę z AI, która nie kończy się na ładnym demie." />
      <div class="mt-12 grid gap-5 lg:grid-cols-2">
        {courseCards.map((course) => <CourseCard {...course} />)}
        <a href="https://10xdevs.pl?utm_source=przeprogramowani_website" class="group relative flex min-h-[390px] flex-col justify-between overflow-hidden rounded-[26px] bg-ink p-7 text-paper transition-transform duration-300 hover:-translate-y-1 md:p-9 lg:col-span-2 lg:min-h-[300px] lg:flex-row lg:items-end lg:gap-12">
          <div class="absolute right-[-80px] top-[-100px] h-72 w-72 rounded-full bg-lime/20 blur-3xl" />
          <div class="relative z-10 max-w-[600px]">
            <p class="eyebrow eyebrow-light">03 / ai-native</p>
            <h3 class="display mt-5 text-5xl font-semibold leading-[0.9] tracking-[-0.085em] md:text-7xl">10xDevs <span class="text-lime">4.0</span></h3>
          </div>
          <div class="relative z-10 max-w-[390px] lg:pb-1">
            <p class="text-sm leading-6 text-paper/60">Zbuduj swój AI-native workflow: od researchu i planu, przez implementację, testy, legacy aż po pracę zespołową.</p>
            <div class="mt-7 flex items-center justify-between border-t border-white/15 pt-4 text-xs font-semibold"><span class="text-paper/45">Start 14.09.2026 · zapisy trwają</span><span class="grid h-9 w-9 place-items-center rounded-full border border-lime/40 text-lg text-lime transition-transform group-hover:translate-x-1">↗</span></div>
          </div>
          <div class="pointer-events-none absolute bottom-[-90px] left-[40%] h-64 w-64 rounded-full border-[34px] border-lime/10" />
        </a>
      </div>
    </div>
  </section>

  <section class="bg-ink py-24 text-paper md:py-32">
    <div class="container-wide">
      <SectionHeading eyebrow="03 / poszerzaj kontekst" title="Treści, do których chce się wracać." description="Wiedza podana po ludzku. Bez lania wody, bez gonienia za każdym hype'em." light />
      <div class="mt-14 grid gap-8 md:grid-cols-2">
        <div class="rounded-[24px] border border-white/10 bg-white/[0.04] p-6 md:p-8">
          <div class="flex items-center justify-between"><div><p class="eyebrow eyebrow-light">Słuchaj</p><h3 class="display mt-3 text-3xl font-semibold tracking-[-0.07em]">Podcasty</h3></div><span class="grid h-11 w-11 place-items-center rounded-full bg-coral text-xl text-ink">◖</span></div>
          <p class="mt-5 max-w-[330px] text-sm leading-6 text-paper/55">Rozmowy o AI, programowaniu, karierze i tym, co dzieje się pomiędzy kodem a biznesem.</p>
          <a href="/podcast" class="link-arrow mt-8 text-paper">Najnowsze odcinki</a>
          <div class="mt-8 border-t border-white/10 pt-5"><p class="text-xs font-semibold text-paper/40">NAJNOWSZY ODCINEK</p><p class="mt-2 text-base font-semibold leading-5">BAN NA AI?! USA BLOKUJE ANTHROPICA i OPEN AI</p><p class="mt-2 text-xs text-paper/40">01:21:53 · Opanuj.AI Podcast</p></div>
        </div>
        <div class="rounded-[24px] border border-white/10 bg-white/[0.04] p-6 md:p-8">
          <div class="flex items-center justify-between"><div><p class="eyebrow eyebrow-light">Oglądaj</p><h3 class="display mt-3 text-3xl font-semibold tracking-[-0.07em]">YouTube</h3></div><span class="grid h-11 w-11 place-items-center rounded-full bg-lime text-xl text-ink">▶</span></div>
          <p class="mt-5 max-w-[330px] text-sm leading-6 text-paper/55">Praktyczne materiały, live'y i technologia widziana z szerszej perspektywy. Nowy odcinek co tydzień.</p>
          <a href="/youtube" class="link-arrow mt-8 text-paper">Zobacz najnowsze</a>
          <div class="mt-8 overflow-hidden rounded-xl"><img src={featuredVideo.image} alt="" loading="lazy" class="aspect-[16/7] w-full object-cover opacity-90" /></div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide py-24 md:py-32">
    <div class="grid items-start gap-14 md:grid-cols-[0.65fr_1.35fr]">
      <div class="md:sticky md:top-8">
        <p class="eyebrow">04 / ostatnio</p>
        <h2 class="display mt-4 max-w-[350px] text-5xl font-semibold leading-[0.92] tracking-[-0.08em]">Co u nas<br /><span class="text-coral">słychać?</span></h2>
        <p class="mt-6 max-w-[280px] text-sm leading-6 text-ink/55">Najnowsze rozmowy i materiały z naszego kanału. Wybierz coś na dziś.</p>
        <a href="/podcast" class="link-arrow mt-7">Wszystkie podcasty</a>
      </div>
      <div class="divide-y divide-ink/10">
        {episodes.slice(0, 3).map((episode, index) => (
          <a href={episode.href} target="_blank" rel="noreferrer" class="group grid gap-5 py-6 first:pt-0 sm:grid-cols-[105px_1fr_auto] sm:items-center">
            <div class="relative overflow-hidden rounded-xl bg-ink"><img src={episode.image} alt="" loading="lazy" class="aspect-square w-full object-cover opacity-80 transition duration-300 group-hover:scale-105" /><span class="absolute left-2 top-2 text-[10px] font-bold text-lime">0{index + 1}</span></div>
            <div><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-ink/40">{episode.show}</p><h3 class="display mt-2 max-w-[520px] text-2xl font-semibold leading-[1] tracking-[-0.06em] group-hover:underline group-hover:decoration-ink/20 group-hover:underline-offset-4">{episode.title}</h3><p class="mt-2 text-xs text-ink/40">{episode.duration}</p></div>
            <span class="hidden h-10 w-10 place-items-center rounded-full border border-ink/15 text-lg transition-all group-hover:-translate-y-1 group-hover:bg-ink group-hover:text-paper sm:grid">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-coral py-20 md:py-24">
    <div class="container-wide grid items-center gap-10 md:grid-cols-[1fr_auto]">
      <div><p class="eyebrow !text-ink/55">05 / co tydzień w skrzynce</p><h2 class="display mt-4 max-w-[650px] text-4xl font-semibold leading-[0.95] tracking-[-0.08em] md:text-6xl">Przeprogramowany<br />newsletter<span class="text-paper">.</span></h2><p class="mt-5 max-w-[430px] text-sm leading-6 text-ink/65">3 rekomendacje techniczne, 2 rozwojowe i 1 bonus niespodzianka. Zero spamu.</p></div>
      <a href="https://przeprogramowani.substack.com" class="group grid h-32 w-32 place-items-center rounded-full border border-ink/30 text-center text-xs font-bold uppercase leading-4 tracking-[0.08em] transition-colors hover:bg-ink hover:text-paper md:h-40 md:w-40">Dołącz<br />za darmo <span class="text-lg">↗</span></a>
    </div>
  </section>

  <section class="container-wide py-20 md:py-24">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
      <div><p class="eyebrow">Zaufali nam</p><h2 class="display mt-4 text-4xl font-semibold tracking-[-0.08em] md:text-5xl">W dobrym towarzystwie.</h2></div>
      <p class="max-w-[260px] text-sm leading-6 text-ink/55">Współpracujemy z zespołami, które chcą robić rzeczy lepiej. Technicznie i po ludzku.</p>
    </div>
    <div class="mt-12 grid grid-cols-2 gap-x-6 gap-y-8 border-y border-ink/10 py-8 text-sm font-semibold text-ink/45 sm:grid-cols-3 md:grid-cols-6">
      {brands.map((brand) => <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-coral"></span>{brand}</span>)}
    </div>
  </section>
</BaseLayout>
