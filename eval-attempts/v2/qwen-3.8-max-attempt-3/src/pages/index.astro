---
import Base from '../layouts/Base.astro';
import { COURSES, FOUNDERS, SITE, TRUSTED_BY } from '../config/site';
import { getSource } from '../data/index';

const tenXDevs = COURSES.find((c) => c.id === '10xdevs')!;
const yt = await getSource('youtube');
const featuredVideos = yt.items.slice(0, 3);
---

<Base
  path="/"
  title="Przeprogramowani — szersze spojrzenie na programowanie"
  description="Przeprogramowani to edukacja technologiczna w epoce AI: kurs 10xDevs, Opanuj Frontend i Opanuj TypeScript, podcasty Opanuj.AI i Przeprogramowani oraz kanał YouTube. Poznaj Przemka Smyrdka i Marcina Czarkowskiego."
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_60%_at_70%_20%,rgba(59,110,245,0.25),transparent)]"></div>
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-100">{SITE.tagline}</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-tight text-white md:text-6xl">
        Edukacja technologiczna w epoce AI
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-300">
        Tworzymy kursy, podcasty i treści, które pomagają programistom rozwijać się na wielu
        płaszczyznach — od technicznych deep-dive'ów po kariery i rozwój osobisty. Programowanie
        spotyka się tu z biznesem i świadomym korzystaniem z potencjału Generative AI.
      </p>

      <div class="mt-10 rounded-2xl border border-accent-500/40 bg-gradient-to-br from-slate-900 to-brand-900/60 p-6 md:p-8">
        <p class="inline-block rounded-full bg-accent-500 px-3 py-1 text-xs font-bold uppercase tracking-wide text-slate-950">
          Wyróżniony kurs — Nowość
        </p>
        <h2 class="mt-4 text-2xl font-extrabold text-white md:text-3xl">
          10xDevs — Programuj z AI
        </h2>
        <p class="mt-3 max-w-2xl text-slate-300">{tenXDevs.short}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={tenXDevs.url}
            class="inline-block rounded-lg bg-accent-500 px-6 py-3 font-bold text-slate-950 transition-colors hover:bg-accent-400"
          >
            Zobacz kurs 10xDevs ↗
          </a>
          <a
            href="/kursy"
            class="inline-block rounded-lg border border-slate-600 px-6 py-3 font-semibold text-white transition-colors hover:border-brand-500 hover:text-brand-100"
          >
            Wszystkie kursy
          </a>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="zapowiedzi" class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 id="zapowiedzi" class="text-2xl font-bold text-white md:text-3xl">Co znajdziesz na tej stronie</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/o-nas" class="group rounded-xl border border-slate-800 bg-slate-900/60 p-5 transition-colors hover:border-brand-500">
        <h3 class="text-lg font-bold text-white group-hover:text-brand-100">O nas</h3>
        <p class="mt-2 text-sm text-slate-400">
          Poznaj działalność i wartości Przeprogramowanych oraz założycieli: Przemka Smyrdka i Marcina Czarkowskiego.
        </p>
        <p class="mt-3 text-sm font-medium text-brand-100">Przejdź →</p>
      </a>
      <a href="/podcast" class="group rounded-xl border border-slate-800 bg-slate-900/60 p-5 transition-colors hover:border-brand-500">
        <h3 class="text-lg font-bold text-white group-hover:text-brand-100">Podcasty</h3>
        <p class="mt-2 text-sm text-slate-400">
          Opanuj.AI — newsy ze świata sztucznej inteligencji oraz Przeprogramowani — szersze spojrzenie na programowanie.
        </p>
        <p class="mt-3 text-sm font-medium text-brand-100">Przejdź →</p>
      </a>
      <a href="/youtube" class="group rounded-xl border border-slate-800 bg-slate-900/60 p-5 transition-colors hover:border-brand-500">
        <h3 class="text-lg font-bold text-white group-hover:text-brand-100">YouTube</h3>
        <p class="mt-2 text-sm text-slate-400">
          Najnowsze filmy z oficjalnego kanału Przeprogramowani — do obejrzenia bezpośrednio na stronie.
        </p>
        <p class="mt-3 text-sm font-medium text-brand-100">Przejdź →</p>
      </a>
      <a href="/kursy" class="group rounded-xl border border-slate-800 bg-slate-900/60 p-5 transition-colors hover:border-brand-500">
        <h3 class="text-lg font-bold text-white group-hover:text-brand-100">Kursy</h3>
        <p class="mt-2 text-sm text-slate-400">
          10xDevs, Opanuj Frontend i Opanuj TypeScript — topowe programy edukacyjne dla ambitnych programistów.
        </p>
        <p class="mt-3 text-sm font-medium text-brand-100">Przejdź →</p>
      </a>
    </div>
  </section>

  <section aria-labelledby="kursy-zapowiedz" class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
    <h2 id="kursy-zapowiedz" class="text-2xl font-bold text-white md:text-3xl">Topowe programy edukacyjne</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {COURSES.map((course) => (
        <article class={`rounded-xl border p-5 ${course.featured ? 'border-accent-500/60 bg-accent-500/5' : 'border-slate-800 bg-slate-900/60'}`}>
          <h3 class="text-lg font-bold text-white">{course.name}</h3>
          <p class="mt-2 text-sm text-slate-300">{course.short}</p>
          <a class="mt-4 inline-block text-sm font-semibold text-brand-100 underline hover:text-white" href={course.url} rel="noopener" target="_blank">
            Szczegóły kursu ↗
          </a>
        </article>
      ))}
    </div>
  </section>

  {featuredVideos.length > 0 && (
    <section aria-labelledby="media-zapowiedz" class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
      <h2 id="media-zapowiedz" class="text-2xl font-bold text-white md:text-3xl">Filmy i podcasty</h2>
      <p class="mt-2 text-slate-300">Rozwój nowoczesnego programisty — najnowsze materiały z kanału YouTube.</p>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {featuredVideos.map((video) => (
          <li class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
            <h3 class="line-clamp-2 text-sm font-bold text-white">{video.title}</h3>
            <a class="mt-3 inline-block text-sm font-medium text-brand-100 underline hover:text-white" href={video.url} rel="noopener" target="_blank">
              Oglądaj ↗
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-4">
        <a class="text-sm font-semibold text-brand-100 underline hover:text-white" href="/youtube">Zobacz wszystkie najnowsze filmy →</a>
      </p>
    </section>
  )}

  <section aria-labelledby="zaufali-nam" class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
    <h2 id="zaufali-nam" class="text-2xl font-bold text-white">Zaufali nam</h2>
    <p class="mt-2 text-slate-300">7 lat na rynku edukacji technologicznej.</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {TRUSTED_BY.map((company) => (
        <li class="rounded-full border border-slate-800 bg-slate-900/60 px-3 py-1 text-sm text-slate-300">{company}</li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-slate-400">
      Chcesz nawiązać współpracę? <a class="text-brand-100 underline hover:text-white" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
  </section>
</Base>
