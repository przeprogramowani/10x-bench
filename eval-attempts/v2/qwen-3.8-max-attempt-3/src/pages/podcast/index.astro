---
import Base from '../../layouts/Base.astro';
import { SOURCES } from '../../data/sources';
import { getSource, formatDate } from '../../data/index';
import DataStatusNotice from '../../components/DataStatusNotice.astro';

const podcasts = [SOURCES['opanuj-ai'], SOURCES['przeprogramowani-podcast']];
const results = await Promise.all(podcasts.map((p) => getSource(p.id)));
---

<Base
  path="/podcast"
  title="Podcasty — Przeprogramowani | Opanuj.AI i Przeprogramowani"
  description="Katalog podcastów Przeprogramowanych: Opanuj.AI Podcast z nowinkami ze świata AI oraz Przeprogramowani — szersze spojrzenie na programowanie. Najnowsze odcinki z odtwarzaczem."
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
    <nav aria-label="Ścieżka okruszków" class="text-sm text-slate-400">
      <a class="hover:text-white hover:underline" href="/">Strona główna</a>
      <span aria-hidden="true"> / </span>
      <span class="text-slate-200">Podcasty</span>
    </nav>

    <h1 class="mt-4 text-3xl font-extrabold text-white md:text-5xl">Nasze podcasty</h1>
    <p class="mt-4 max-w-3xl text-lg text-slate-300">
      Słuchaj najnowszych odcinków obu podcastów Przeprogramowanych — bezpośrednio na tej stronie
      albo u dostawców (Spotify, Apple Podcasts i inne).
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {results.map((result, i) => (
        <article class="flex flex-col rounded-xl border border-slate-800 bg-slate-900/60 p-6">
          <h2 class="text-xl font-bold text-white">{podcasts[i].name}</h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-300">{podcasts[i].description}</p>
          <DataStatusNotice result={result} />
          {result.items.length > 0 && (
            <div class="mt-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Najnowszy odcinek</p>
              <p class="mt-1 font-medium text-white">{result.items[0].title}</p>
              <p class="text-sm text-slate-400">
                {result.items[0].publishedAt ? formatDate(result.items[0].publishedAt) : 'data nieznana'}
              </p>
            </div>
          )}
          <div class="mt-5 flex flex-wrap gap-3">
            <a
              class="inline-block rounded-lg bg-brand-500 px-4 py-2 text-sm font-bold text-white hover:bg-brand-600"
              href={i === 0 ? '/podcast/opanuj-ai' : '/podcast/przeprogramowani'}
            >
              Strona podcastu →
            </a>
            <a
              class="inline-block rounded-lg border border-slate-700 px-4 py-2 text-sm font-medium text-slate-200 hover:border-brand-500 hover:text-white"
              href={podcasts[i].homepage}
              rel="noopener"
              target="_blank"
            >
              Profil u dostawcy ↗
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>
