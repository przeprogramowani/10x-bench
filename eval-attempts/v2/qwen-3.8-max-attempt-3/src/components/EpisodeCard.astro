---
import type { MediaItem } from '../data/sources';
import { formatDate } from '../data/index';

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;
---

<article class="rounded-xl border border-slate-800 bg-slate-900/60 p-5">
  <div class="flex flex-wrap items-center gap-2 text-xs text-slate-400">
    <span class="rounded-full bg-brand-500/15 px-2.5 py-1 font-medium text-brand-100">{item.sourceName}</span>
    <time datetime={item.publishedAt ?? undefined}>
      {item.publishedAt ? formatDate(item.publishedAt) : 'data publikacji nieznana'}
    </time>
    {item.duration && <span aria-label={`Czas trwania ${item.duration}`}>⏱ {item.duration}</span>}
  </div>
  <h3 class="mt-3 text-lg font-bold leading-snug text-white">
    <a class="rounded hover:text-brand-100 hover:underline" href={item.url} rel="noopener" target="_blank">
      {item.title}
    </a>
  </h3>
  {item.description && <p class="mt-2 line-clamp-3 text-sm text-slate-300">{item.description}</p>}
  <div class="mt-4">
    {item.audioUrl ? (
      <audio controls preload="none" class="w-full" aria-label={`Odtwarzacz odcinka: ${item.title}`}>
        <source src={item.audioUrl} type="audio/mpeg" />
        Twoja przeglądarka nie wspiera odtwarzania audio.{' '}
        <a class="underline" href={item.audioUrl}>Pobierz odcinek</a>.
      </audio>
    ) : (
      <p class="text-sm text-slate-400">
        Odtwarzanie bezpośrednio u dostawcy może być ograniczone — użyj odnośnika do odcinka.
      </p>
    )}
  </div>
  <p class="mt-3 text-sm">
    <a class="font-medium text-brand-100 underline decoration-brand-500/50 hover:decoration-brand-100" href={item.url} rel="noopener" target="_blank">
      Otwórz odcinek w źródle ↗
    </a>
  </p>
</article>
