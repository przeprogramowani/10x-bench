---
import Layout from '../layouts/Layout.astro';
import MediaCard from '../components/MediaCard.astro';
import SourceStatus from '../components/SourceStatus.astro';
import { sources, loadSelected } from '../lib/sources';

const simulateFailure = Astro.url.searchParams.get('fail') === '1';
const data = await loadSelected(sources.youtube, simulateFailure);
const attemptStart = new Date('2026-09-08T07:29:49Z');
---

<Layout
  title="YouTube — najnowsze filmy Przeprogramowani"
  description="Najnowsze filmy kanału YouTube Przeprogramowani: live'y, webinary i materiały o AI, frontendzie i TypeScripcie. Oglądaj osadzone wideo i przejdź do oryginałów."
  path="/youtube"
>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <nav aria-label="Ścieżka nawigacji" class="text-sm text-slate-400">
      <a class="hover:text-brand-500 hover:underline" href="/">Strona główna</a> /
      <span aria-current="page">YouTube</span>
    </nav>
    <h1 class="mt-4 text-3xl font-bold text-white sm:text-4xl">YouTube Przeprogramowani</h1>
    <p class="mt-4 text-lg text-slate-200">
      Oficjalny kanał YouTube Przeprogramowanych: transmisje live o narzędziach AI, Demo Day
      kursu 10xDevs, webinary o frontendzie i TypeScripcie oraz wrażenia z konferencji
      technologicznych.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 font-semibold text-white hover:bg-brand-500"
        rel="noopener" target="_blank"
        href="https://www.youtube.com/@Przeprogramowani">Kanał na YouTube ↗</a
      >
      <a
        class="inline-flex items-center gap-2 rounded-lg border border-white/20 px-4 py-2 font-semibold text-slate-100 hover:bg-white/10"
        rel="noopener" target="_blank"
        href="https://www.youtube.com/@Przeprogramowani/videos">Wszystkie filmy ↗</a
      >
    </div>

    <div class="mt-8"><SourceStatus result={data} /></div>

    <section aria-labelledby="videos-heading" class="mt-8">
      <h2 id="videos-heading" class="text-2xl font-bold text-white">Najnowsze filmy</h2>
      {
        !data.hadRecentItems && data.selected.length > 0 && (
          <p class="mt-2 text-sm text-amber-300">
            Kanał nie opublikował filmów w ostatnich 90 dniach — poniżej najnowsze dostępne
            materiały z rzeczywistymi datami publikacji.
          </p>
        )
      }
      {
        data.selected.length === 0 ? (
          <p class="mt-4 rounded-lg border border-rose-500/40 bg-rose-500/10 px-4 py-3 text-rose-200">
            Brak dostępnych filmów. Przejdź do kanału:{' '}
            <a class="underline" rel="noopener" target="_blank" href="https://www.youtube.com/@Przeprogramowani">
              youtube.com/@Przeprogramowani
            </a>
          </p>
        ) : (
          <div class="mt-4 grid gap-4">
            {data.selected.map((item) => <MediaCard item={item} kind="video" />)}
          </div>
        )
      }
      <p class="mt-6 text-xs text-slate-400">
        Dane: feed Atom <a class="underline" rel="noopener" target="_blank" href={data.sourceUrl}>{data.sourceUrl}</a>
        (pobrane/snapshot: {new Date(data.fetchedAt).toISOString()}; próba wystartowała {attemptStart.toISOString()}).
        Odtwarzanie: osadzony odtwarzacz YouTube (youtube-nocookie) oraz niezależny odnośnik do
        każdego filmu. Jeśli osadzanie zostanie zablokowane przez dostawcę, odnośnik „Otwórz
        oryginał" pozostaje dostępny.
      </p>
    </section>
  </div>
</Layout>
