---
import Layout from '../../layouts/Layout.astro';

const shows = [
  {
    href: '/podcast/opanuj-ai',
    title: 'Opanuj.AI Podcast',
    text: 'Podcast o sztucznej inteligencji dla programistów: praktyczne wykorzystanie LLM, narzędzia AI (Cursor, Claude, modele GPT) i zmiany w ekosystemie. Twórca: Marcin Czarkowski.',
    external: [
      { label: 'Spotify', href: 'https://open.spotify.com/show/4qHUZJpeBK8Ij9e2wTVm2o' },
      { label: 'Spotify for Podcasters', href: 'https://podcasters.spotify.com/pod/show/opanujai' },
      { label: 'RSS', href: 'https://anchor.fm/s/e2cb03d0/podcast/rss' },
    ],
  },
  {
    href: '/podcast/przeprogramowani',
    title: 'Podcast Przeprogramowani',
    text: 'Rozmowy o programowaniu z szerszej perspektywy: frontend, TypeScript, kariera, nauka języków i rozwój zawodowy — prowadzony przez Przemka Smyrdka i Marcina Czarkowskiego, często z gośćmi.',
    external: [
      { label: 'Apple Podcasts', href: 'https://podcasts.apple.com/pl/podcast/przeprogramowani/id1508387250' },
      { label: 'Spotify for Podcasters', href: 'https://podcasters.spotify.com/pod/show/przeprogramowani' },
      { label: 'RSS', href: 'https://anchor.fm/s/c72d808/podcast/rss' },
    ],
  },
];
---

<Layout
  title="Podcasty — Opanuj.AI i Przeprogramowani | Katalog"
  description="Katalog podcastów Przeprogramowanych: Opanuj.AI o sztucznej inteligencji i LLM oraz Przeprogramowani o karierze i technologiach. Opisy, odcinki i linki do platform."
  path="/podcast"
>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <nav aria-label="Ścieżka nawigacji" class="text-sm text-slate-400">
      <a class="hover:text-brand-500 hover:underline" href="/">Strona główna</a> /
      <span aria-current="page">Podcasty</span>
    </nav>
    <h1 class="mt-4 text-3xl font-bold text-white sm:text-4xl">Podcasty Przeprogramowanych</h1>
    <p class="mt-4 text-lg text-slate-200">
      Przeprogramowani tworzą dwa podcasty: techniczny „Opanuj.AI” o sztucznej inteligencji oraz
      „Przeprogramowani” o programowaniu z szerszej perspektywy. Wybierz audycję, aby zobaczyć
      opis i najnowsze odcinki z odtwarzaczem.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        shows.map((show) => (
          <article class="flex flex-col rounded-xl border border-white/10 bg-ink-800 p-6">
            <h2 class="text-xl font-bold text-white">{show.title}</h2>
            <p class="mt-3 flex-1 text-sm text-slate-200">{show.text}</p>
            <a
              class="mt-5 inline-flex items-center gap-2 self-start rounded-lg bg-brand-600 px-4 py-2 font-semibold text-white hover:bg-brand-500"
              href={show.href}
            >
              Strona podcastu<span aria-hidden="true">→</span>
            </a>
            <ul class="mt-4 flex flex-wrap gap-2 text-xs">
              {show.external.map((link) => (
                <li>
                  <a
                    class="inline-flex items-center rounded-full border border-white/20 px-3 py-1 font-medium text-slate-200 hover:bg-white/10"
                    rel="noopener"
                    target="_blank"
                    href={link.href}
                  >
                    {link.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-slate-300">
      Zobacz też: <a class="text-brand-500 hover:underline" href="/youtube">najnowsze filmy YouTube</a>.
    </p>
  </div>
</Layout>
