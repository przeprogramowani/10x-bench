---
import Layout from '../../layouts/Layout.astro';
import MediaCard from '../../components/MediaCard.astro';
import SourceStatus from '../../components/SourceStatus.astro';
import { sources, loadSelected } from '../../lib/sources';

const simulateFailure = Astro.url.searchParams.get('fail') === '1';
const data = await loadSelected(sources.opanujAi, simulateFailure);
const attemptStart = new Date('2026-09-08T07:29:49Z');
---

<Layout
  title="Opanuj.AI Podcast — najnowsze odcinki | Przeprogramowani"
  description="Opanuj.AI Podcast Przeprogramowanych: odcinki o sztucznej inteligencji, LLM i narzędziach AI dla programistów. Odtwarzaj najnowsze epizody i przejdź do oryginałów."
  path="/podcast/opanuj-ai"
>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <nav aria-label="Ścieżka nawigacji" class="text-sm text-slate-400">
      <a class="hover:text-brand-500 hover:underline" href="/">Strona główna</a> /
      <a class="hover:text-brand-500 hover:underline" href="/podcast">Podcasty</a> /
      <span aria-current="page">Opanuj.AI</span>
    </nav>
    <h1 class="mt-4 text-3xl font-bold text-white sm:text-4xl">Opanuj.AI Podcast</h1>
    <p class="mt-4 text-lg text-slate-200">
      Podcast o sztucznej inteligencji dla programistów, tworzony przez Przeprogramowanych.
      Marcin Czarkowski i goście omawiają praktyczne wykorzystanie modeli językowych (LLM),
      narzędzi AI oraz zmiany w ekosystemie — od Cursora i Claude po nowe generacje modeli.
      Według twórców to najpopularniejszy techniczny podcast o LLM w Polsce.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 font-semibold text-white hover:bg-brand-500"
        rel="noopener" target="_blank"
        href="https://podcasters.spotify.com/pod/show/opanujai">Spotify for Podcasters ↗</a
      >
      <a
        class="inline-flex items-center gap-2 rounded-lg border border-white/20 px-4 py-2 font-semibold text-slate-100 hover:bg-white/10"
        rel="noopener" target="_blank"
        href="https://open.spotify.com/show/4qHUZJpeBK8Ij9e2wTVm2o">Spotify ↗</a
      >
      <a
        class="inline-flex items-center gap-2 rounded-lg border border-white/20 px-4 py-2 font-semibold text-slate-100 hover:bg-white/10"
        rel="noopener" target="_blank"
        href="https://opanuj.ai">Strona Opanuj.AI ↗</a
      >
    </div>

    <div class="mt-8"><SourceStatus result={data} /></div>

    <section aria-labelledby="episodes-heading" class="mt-8">
      <h2 id="episodes-heading" class="text-2xl font-bold text-white">Najnowsze odcinki</h2>
      {
        !data.hadRecentItems && data.selected.length > 0 && (
          <p class="mt-2 text-sm text-amber-300">
            Źródło nie opublikowało odcinków w ostatnich 90 dniach — poniżej najnowsze dostępne
            materiały z rzeczywistymi datami publikacji.
          </p>
        )
      }
      {
        data.selected.length === 0 ? (
          <p class="mt-4 rounded-lg border border-rose-500/40 bg-rose-500/10 px-4 py-3 text-rose-200">
            Brak dostępnych odcinków. Przejdź do źródła:{' '}
            <a class="underline" rel="noopener" target="_blank" href={data.sourceUrl}>
              {data.sourceUrl}
            </a>
          </p>
        ) : (
          <div class="mt-4 grid gap-4">
            {data.selected.map((item) => <MediaCard item={item} kind="audio" />)}
          </div>
        )
      }
      <p class="mt-6 text-xs text-slate-400">
        Dane: feed RSS <a class="underline" rel="noopener" target="_blank" href={data.sourceUrl}>{data.sourceUrl}</a>
        (pobrane/snapshot: {new Date(data.fetchedAt).toISOString()}; próba wystartowała {attemptStart.toISOString()}).
        Odtwarzanie: wbudowany odtwarzacz audio (plik mp3 z feedu) oraz niezależny odnośnik do
        oryginału każdego odcinka.
      </p>
    </section>
  </div>
</Layout>
