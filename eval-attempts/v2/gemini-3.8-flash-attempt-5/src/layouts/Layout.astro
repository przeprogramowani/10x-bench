---
import '../styles/global.css';
import { Navbar } from '../components/Navbar';
import { BRAND_INFO } from '../data/static/about';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  ogImage = 'https://przeprogramowani.pl/img/10xdevs-hero.webp'
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://przeprogramowani.pl';
const canonicalUrl = `${siteUrl}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="pl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary SEO Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={BRAND_INFO.name} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚀</text></svg>" />

    <style is:global>
      /* Ensure no horizontal overflow */
      html, body {
        overflow-x: hidden;
      }
    </style>
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans antialiased selection:bg-emerald-500 selection:text-slate-950">
    {/* Accessible skip link */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-emerald-500 text-slate-950 font-bold rounded-lg shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
    >
      Przejdź do treści głównej
    </a>

    {/* Global Navigation with React Interactive Drawer */}
    <Navbar client:load currentPath={currentPath} />

    {/* Main Content Area */}
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    {/* Global Footer */}
    <footer class="bg-slate-900 border-t border-slate-800/80 pt-16 pb-12 text-slate-400 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          {/* Brand Info */}
          <div class="md:col-span-1 space-y-4">
            <a href="/" class="flex items-center space-x-3 text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded-lg">
              <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-500 to-cyan-500 flex items-center justify-center font-black text-lg text-slate-950">
                &lt;/&gt;
              </div>
              <span class="font-extrabold text-lg text-white">
                Przeprogramowani<span class="text-emerald-400">.pl</span>
              </span>
            </a>
            <p class="text-sm text-slate-400 leading-relaxed">
              {BRAND_INFO.slogan} — programowanie, biznes, inżynieria AI i ciągły rozwój. {BRAND_INFO.yearsOnMarket} na rynku edukacji technologicznej.
            </p>
            <div class="text-xs text-slate-500">
              Kontakt: <a href={`mailto:${BRAND_INFO.contactEmail}`} class="text-emerald-400 hover:underline">{BRAND_INFO.contactEmail}</a>
            </div>
          </div>

          {/* Quick Links */}
          <div>
            <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Nawigacja</h4>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/" class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">Strona główna</a></li>
              <li><a href="/o-nas" class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">O nas</a></li>
              <li><a href="/podcast" class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">Katalog podcastów</a></li>
              <li><a href="/youtube" class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">Kanał YouTube</a></li>
              <li><a href="/kursy" class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">Kursy i programy</a></li>
            </ul>
          </div>

          {/* Media & Podcasts Hub */}
          <div>
            <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Podcasty & Media</h4>
            <ul class="space-y-2.5 text-sm">
              <li><a href="/podcast/opanuj-ai" class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">Podcast Opanuj.AI</a></li>
              <li><a href="/podcast/przeprogramowani" class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">Podcast Przeprogramowani</a></li>
              <li><a href="/youtube" class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">Filmy na YouTube</a></li>
              <li><a href={BRAND_INFO.socials.newsletter} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">Przeprogramowany Newsletter</a></li>
            </ul>
          </div>

          {/* Featured Courses Links */}
          <div>
            <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4">Programy edukacyjne</h4>
            <ul class="space-y-2.5 text-sm">
              <li>
                <a href="https://10xdevs.pl" target="_blank" rel="noopener noreferrer" class="text-emerald-400 font-medium hover:underline flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">
                  <span>10xDevs 4.0</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800">HIT</span>
                </a>
              </li>
              <li>
                <a href="https://opanujfrontend.pl" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">
                  Opanuj Frontend: AI Edition
                </a>
              </li>
              <li>
                <a href="https://opanujtypescript.pl" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded">
                  Opanuj TypeScript: Frontend Pro
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <p>© {new Date().getFullYear()} Przeprogramowani.pl. Wszelkie prawa zastrzeżone.</p>
          <div class="flex items-center space-x-6">
            <a href="https://www.youtube.com/c/przeprogramowani" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">YouTube</a>
            <a href="https://www.linkedin.com/company/przeprogramowani/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">LinkedIn</a>
            <a href="https://facebook.com/przeprogramowani" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">Facebook</a>
            <a href="https://instagram.com/przeprogramowani" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">Instagram</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
