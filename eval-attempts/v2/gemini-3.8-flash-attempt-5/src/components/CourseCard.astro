---
import type { Course } from '../types';

interface Props {
  course: Course;
}

const { course } = Astro.props;
---

<article class={`rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all border ${
  course.featured
    ? 'bg-gradient-to-b from-slate-850 to-slate-900 border-emerald-500/50 shadow-2xl shadow-emerald-500/10 ring-1 ring-emerald-500/30'
    : 'bg-slate-850 border-slate-800 hover:border-slate-700 shadow-lg'
}`}>
  <div>
    <div class="flex items-center justify-between gap-3 mb-4">
      <span class={`text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full ${
        course.featured
          ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40'
          : 'bg-slate-800 text-slate-300 border border-slate-700'
      }`}>
        {course.badge}
      </span>
      {course.featured && (
        <span class="text-xs font-semibold text-emerald-400 flex items-center gap-1">
          ★ Wyróżniony
        </span>
      )}
    </div>

    <h3 class="text-2xl sm:text-3xl font-black text-white mb-2 tracking-tight">
      {course.title}
    </h3>

    <p class="text-sm font-semibold text-emerald-400 mb-4">
      {course.tagline}
    </p>

    <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
      {course.description}
    </p>

    <div class="space-y-2.5 mb-8">
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Kluczowe moduły i korzyści:</h4>
      <ul class="space-y-2 text-sm text-slate-300">
        {course.features.map((feature) => (
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="pt-4 border-t border-slate-800">
    <a
      href={course.url}
      target="_blank"
      rel="noopener noreferrer"
      class={`w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-base font-bold transition-all shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900 ${
        course.featured
          ? 'bg-emerald-500 hover:bg-emerald-400 text-slate-950 focus-visible:ring-emerald-400 hover:shadow-emerald-500/25'
          : 'bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 focus-visible:ring-slate-400'
      }`}
      aria-label={`Zobacz oficjalną stronę kursu ${course.title} (otwiera się w nowej karcie)`}
    >
      <span>Sprawdź szczegóły na {new URL(course.url).hostname}</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</article>
