---
import type { SourceMetadata } from '../types';

interface Props {
  meta: SourceMetadata;
}

const { meta } = Astro.props;
---

<div class={`rounded-xl p-4 sm:p-5 border transition-all my-6 ${
  meta.status === 'stale-fallback'
    ? 'bg-amber-950/40 border-amber-600/40 text-amber-200'
    : 'bg-slate-800/40 border-slate-700/60 text-slate-300'
}`}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-start sm:items-center space-x-3">
      {meta.status === 'stale-fallback' ? (
        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">
          ⚠️ Tryb awaryjny (Cache)
        </span>
      ) : (
        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
          ✓ Źródło aktywne (Live)
        </span>
      )}

      <div class="text-xs text-slate-400">
        Pobrano: <time datetime={meta.fetchedAt} class="font-mono text-slate-200">{new Date(meta.fetchedAt).toLocaleString('pl-PL')}</time>
      </div>
    </div>

    <div class="text-xs">
      <a
        href={meta.homepageUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 font-medium text-emerald-400 hover:text-emerald-300 underline underline-offset-2 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded"
      >
        <span>Przejdź do oficjalnego profilu źródła</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>

  {meta.status === 'stale-fallback' && meta.error && (
    <div class="mt-3 text-xs text-amber-300/90 pt-3 border-t border-amber-800/40">
      <p class="font-medium">Informacja o awarii źródła:</p>
      <p class="mt-0.5 text-amber-200/80 font-mono text-[11px]">{meta.error}</p>
      <p class="mt-1">Prezentowane są zweryfikowane dane z lokalnej pamięci podręcznej (stale snapshot). Strona zachowuje pełną funkcjonalność.</p>
    </div>
  )}
</div>
