---
import Layout from '../layouts/Layout.astro';
import { BRAND_INFO, FOUNDERS } from '../data/static/about';
import { COURSES } from '../data/static/courses';
import CourseCard from '../components/CourseCard.astro';
import PodcastCard from '../components/PodcastCard.astro';
import VideoCard from '../components/VideoCard.astro';
import { fetchOpanujAiEpisodes } from '../data/sources/opanujAi.ts';
import { fetchYoutubeVideos } from '../data/sources/youtube.ts';

const featuredCourse = COURSES.find(c => c.featured) || COURSES[0];
const otherCourses = COURSES.filter(c => !c.featured);

// Fetch preview data for homepage teasers
const opanujAiResult = await fetchOpanujAiEpisodes();
const latestEpisode = opanujAiResult.data[0];

const youtubeResult = await fetchYoutubeVideos();
const latestVideo = youtubeResult.data[0];
---

<Layout
  title="Przeprogramowani.pl — Szersze spojrzenie na programowanie i inżynierię AI"
  description="Oficjalna strona projektu Przeprogramowani.pl. Praktyczna wiedza, nowoczesna inżynieria AI, podcasty Opanuj.AI i Przeprogramowani oraz flagowy program 10xDevs."
  canonicalPath="/"
>
  {/* Hero Section with Prominent 10xDevs Feature */}
  <section class="relative overflow-hidden pt-12 pb-20 sm:pt-16 sm:pb-28 border-b border-slate-800/80 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-900/20 via-slate-950/0 to-transparent pointer-events-none" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
          <span>7 lat na rynku edukacji technologicznej</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1] mb-6">
          Szersze spojrzenie na <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">programowanie</span> w epoce AI
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto">
          Łączymy świat nowoczesnego kodu, architektury, biznesu i rozwoju osobistego. Poznaj sprawdzone programy szkoleniowe, podcasty techniczne i materiały tworzone przez praktyków.
        </p>
      </div>

      {/* Prominent 10xDevs Hero Box */}
      <div class="bg-gradient-to-br from-slate-850 via-slate-900 to-slate-950 border-2 border-emerald-500/40 rounded-3xl p-6 sm:p-10 lg:p-12 shadow-2xl shadow-emerald-500/10 ring-1 ring-emerald-500/20 max-w-5xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              ⚡ Wyróżniony program edukacyjny
            </div>

            <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
              {featuredCourse.title}
            </h2>

            <p class="text-base sm:text-lg font-semibold text-emerald-400">
              {featuredCourse.tagline}
            </p>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              {featuredCourse.description}
            </p>

            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm text-slate-300 font-medium">
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span> 10xWorkflow & 10x-cli
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span> Cursor & Claude Code
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span> Ponad 6700 absolwentów
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span> Model Context Protocol (MCP)
              </li>
            </ul>

            <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <a
                href={featuredCourse.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-base font-extrabold bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-lg shadow-emerald-500/20 transition-all hover:scale-[1.02] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
                aria-label="Dołącz do programu 10xDevs 4.0 na oficjalnej stronie 10xdevs.pl"
              >
                <span>Sprawdź program na 10xdevs.pl</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href="/kursy"
                class="inline-flex items-center justify-center px-5 py-3.5 rounded-xl text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400"
              >
                Zobacz wszystkie kursy →
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 bg-slate-900/80 p-6 rounded-2xl border border-slate-800 space-y-4">
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-400">Prowadzący 10xDevs</h3>
            <div class="space-y-4">
              {FOUNDERS.map((founder) => (
                <div class="flex items-center gap-3">
                  <img
                    src={founder.avatar}
                    alt={founder.name}
                    class="w-12 h-12 rounded-full object-cover border border-emerald-500/40"
                    loading="lazy"
                  />
                  <div>
                    <h4 class="text-sm font-bold text-white">{founder.name}</h4>
                    <p class="text-xs text-slate-400">{founder.role}</p>
                  </div>
                </div>
              ))}
            </div>
            <p class="text-xs text-slate-400 italic pt-2 border-t border-slate-800">
              „W 10xDevs nie zostajemy na poziomie teorii ani prostego czatu — budujemy powtarzalny proces inżynierski z agentami AI”.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Page Teasers Section */}
  <section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Eksploruj ekosystem Przeprogramowanych
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        Od cotygodniowych nagrań i podcastów po zaawansowane szkolenia inżynierskie. Sprawdź, co przygotowaliśmy dla Ciebie.
      </p>
    </div>

    {/* 4 Navigation Cards Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
      {/* O nas */}
      <a
        href="/o-nas"
        class="group p-6 rounded-2xl bg-slate-900 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-850 transition-all flex flex-col justify-between focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
      >
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-2xl mb-4 group-hover:scale-110 transition-transform">
            👥
          </div>
          <h3 class="text-xl font-bold text-white mb-2 group-hover:text-emerald-400 transition-colors">
            O nas
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Poznaj twórców: Przemka Smyrdka i Marcina Czarkowskiego, naszą misję i wartości edukacyjne.
          </p>
        </div>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-400 mt-6">
          Poznaj zespół →
        </span>
      </a>

      {/* Podcasty */}
      <a
        href="/podcast"
        class="group p-6 rounded-2xl bg-slate-900 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-850 transition-all flex flex-col justify-between focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
      >
        <div>
          <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-2xl mb-4 group-hover:scale-110 transition-transform">
            🎙️
          </div>
          <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">
            Podcasty
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Katalog obu naszych audycji: Opanuj.AI Podcast oraz Podcast Przeprogramowani.
          </p>
        </div>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-cyan-400 mt-6">
          Przejdź do katalogu →
        </span>
      </a>

      {/* YouTube */}
      <a
        href="/youtube"
        class="group p-6 rounded-2xl bg-slate-900 border border-slate-800 hover:border-red-500/50 hover:bg-slate-850 transition-all flex flex-col justify-between focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400"
      >
        <div>
          <div class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/30 flex items-center justify-center text-red-400 text-2xl mb-4 group-hover:scale-110 transition-transform">
            📺
          </div>
          <h3 class="text-xl font-bold text-white mb-2 group-hover:text-red-400 transition-colors">
            YouTube
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Bezpłatne materiały wideo, nagrania sesji LIVE, recenzje narzędzi i relacje technologiczne.
          </p>
        </div>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-red-400 mt-6">
          Oglądaj filmy →
        </span>
      </a>

      {/* Kursy */}
      <a
        href="/kursy"
        class="group p-6 rounded-2xl bg-slate-900 border border-slate-800 hover:border-emerald-500/50 hover:bg-slate-850 transition-all flex flex-col justify-between focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
      >
        <div>
          <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 text-2xl mb-4 group-hover:scale-110 transition-transform">
            🚀
          </div>
          <h3 class="text-xl font-bold text-white mb-2 group-hover:text-purple-400 transition-colors">
            Kursy
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Opanuj Frontend, Opanuj TypeScript oraz 10xDevs — programy edukacyjne na najwyższym poziomie.
          </p>
        </div>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-purple-400 mt-6">
          Poznaj ofertę kursów →
        </span>
      </a>
    </div>

    {/* Live Media Highlights on Homepage */}
    <div class="space-y-12">
      <div class="flex items-center justify-between border-b border-slate-800 pb-4">
        <div>
          <h3 class="text-2xl font-bold text-white">Najnowsze materiały</h3>
          <p class="text-sm text-slate-400">Odsłuchaj ostatni odcinek lub obejrzyj najnowsze wideo</p>
        </div>
        <div class="flex items-center gap-4">
          <a href="/podcast" class="text-sm text-emerald-400 hover:underline">Wszystkie podcasty →</a>
          <a href="/youtube" class="text-sm text-red-400 hover:underline">Wszystkie filmy →</a>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {latestEpisode && (
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-2">
              Z podcastu: Opanuj.AI
            </div>
            <PodcastCard item={latestEpisode} podcastName="Opanuj.AI Podcast" />
          </div>
        )}

        {latestVideo && (
          <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-red-400 mb-2">
              Z kanału YouTube
            </div>
            <VideoCard item={latestVideo} />
          </div>
        )}
      </div>
    </div>
  </section>

  {/* Other Courses Overview Section */}
  <section class="py-16 bg-slate-900/60 border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Pozostałe programy edukacyjne
          </h2>
          <p class="text-slate-400 text-sm mt-1">
            Ponad 10 lat doświadczenia przelane w usystematyzowaną wiedzę
          </p>
        </div>
        <a href="/kursy" class="text-emerald-400 font-semibold hover:underline text-sm shrink-0">
          Zobacz pełny katalog kursów →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {otherCourses.map((course) => (
          <CourseCard course={course} />
        ))}
      </div>
    </div>
  </section>
</Layout>
