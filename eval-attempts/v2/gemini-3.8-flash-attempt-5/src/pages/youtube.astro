---
import Layout from '../layouts/Layout.astro';
import { fetchYoutubeVideos } from '../data/sources/youtube.ts';
import VideoCard from '../components/VideoCard.astro';
import SourceNotice from '../components/SourceNotice.astro';

const simulateFailure = Astro.url.searchParams.get('simulateFailure') === 'true';
const result = await fetchYoutubeVideos({ simulateFailure });
const videos = result.data;
---

<Layout
  title="YouTube — Filmy, live demo i webinary | Przeprogramowani.pl"
  description="Oficjalny kanał YouTube Przeprogramowanych. Oglądaj najnowsze filmy, prezentacje projektów 10xDevs Demo Day, analizy modeli frontierowych i tutoriale architektoniczne."
  canonicalPath="/youtube"
>
  <div class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Page Header */}
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-semibold mb-4">
        <span>Oficjalny kanał YouTube</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight mb-6">
        Filmy i webinary na YouTube
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed">
        Darmowa, praktyczna wiedza inżynierska bez owijania w bawełnę. Znajdziesz tu nagrania z sesji live, pokazy budowy aplikacji z agentami AI, przeglądy architektury oraz transmisje 10xDevs Demo Day.
      </p>

      <div class="flex flex-wrap items-center gap-4 mt-6 pt-6 border-t border-slate-800">
        <a
          href="https://www.youtube.com/@Przeprogramowani?sub_confirmation=1"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold bg-red-600 hover:bg-red-500 text-white shadow-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>Subskrybuj kanał</span>
        </a>
        <a
          href="https://www.youtube.com/@Przeprogramowani"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors"
        >
          <span>Odwiedź stronę kanału (@Przeprogramowani)</span>
        </a>
      </div>
    </div>

    {/* Resilience & Source Status Notice */}
    <SourceNotice meta={result.meta} />

    {/* Video Grid */}
    <section class="space-y-6 mt-8">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-white">
          Najnowsze publikacje wideo ({videos.length})
        </h2>
        <span class="text-xs text-slate-400">
          Materiały z 90 dni poprzedzających start próby
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {videos.map((video) => (
          <VideoCard item={video} />
        ))}
      </div>
    </section>

    {/* Bottom CTA */}
    <div class="mt-20 p-8 rounded-3xl bg-slate-900 border border-slate-800 text-center max-w-2xl mx-auto space-y-4">
      <h3 class="text-2xl font-bold text-white">Szukasz więcej uporządkowanej wiedzy?</h3>
      <p class="text-sm text-slate-300">
        Nasze darmowe filmy to świetny punkt wyjścia. Jeśli chcesz wejść na wyższy poziom inżynierii AI, sprawdź kurs 10xDevs 4.0.
      </p>
      <div class="pt-2">
        <a
          href="https://10xdevs.pl"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-colors"
        >
          <span>Poznaj program 10xDevs 4.0</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</Layout>
