---
import Layout from '../../layouts/Layout.astro';
import { fetchOpanujAiEpisodes } from '../../data/sources/opanujAi.ts';
import PodcastCard from '../../components/PodcastCard.astro';
import SourceNotice from '../../components/SourceNotice.astro';

const simulateFailure = Astro.url.searchParams.get('simulateFailure') === 'true';
const result = await fetchOpanujAiEpisodes({ simulateFailure });
const episodes = result.data;
---

<Layout
  title="Podcast Opanuj.AI — Najnowsze odcinki, odtwarzacz | Przeprogramowani.pl"
  description="Opanuj.AI Podcast — cykliczne podsumowanie nowinek ze świata AI, LLM i agentów. Prowadzą Marcin Czarkowski i Przemek Smyrdek. Słuchaj online z odtwarzaczem."
  canonicalPath="/podcast/opanuj-ai"
>
  <div class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Breadcrumb Navigation */}
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-400 mb-8" aria-label="Ścieżka nawigacyjna">
      <a href="/" class="hover:text-white transition-colors">Główna</a>
      <span>/</span>
      <a href="/podcast" class="hover:text-white transition-colors">Podcasty</a>
      <span>/</span>
      <span class="text-emerald-400 font-medium">Opanuj.AI</span>
    </nav>

    {/* Header */}
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold mb-4">
        <span>Oficjalny podcast techniczny o AI</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight mb-6">
        Opanuj.AI Podcast
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed">
        Podcast, w którym znajdziesz cykliczne podsumowanie nowinek technicznych ze świata AI. Prowadzącymi są Marcin Czarkowski i Przemek Smyrdek, dwójka doświadczonych programistów, którzy dzielą się ze słuchaczami opiniami o wpływie sztucznej inteligencji na inżynierię oprogramowania.
      </p>

      <div class="flex flex-wrap items-center gap-4 mt-6 pt-6 border-t border-slate-800">
        <a
          href="https://open.spotify.com/show/3D6LmchBdoqL2sWkQjvWOy"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold bg-[#1DB954] hover:bg-[#1aa34a] text-slate-950 transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
          </svg>
          <span>Spotify</span>
        </a>
        <a
          href="https://podcasts.apple.com/pl/podcast/opanuj-ai-podcast/id1690353799"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 transition-colors"
        >
          <span>Apple Podcasts</span>
        </a>
        <a
          href="https://anchor.fm/s/e2cb03d0/podcast/rss"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold bg-orange-600/20 text-orange-400 border border-orange-500/30 hover:bg-orange-600/30 transition-colors"
        >
          <span>Feed RSS</span>
        </a>
      </div>
    </div>

    {/* Resilience & Source Status Notice */}
    <SourceNotice meta={result.meta} />

    {/* Episodes List */}
    <section class="space-y-6 mt-8">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-white">
          Najnowsze odcinki ({episodes.length})
        </h2>
        <span class="text-xs text-slate-400">
          Materiały z 90 dni poprzedzających start próby
        </span>
      </div>

      <div class="grid grid-cols-1 gap-6">
        {episodes.map((episode) => (
          <PodcastCard item={episode} podcastName="Opanuj.AI Podcast" />
        ))}
      </div>
    </section>

    {/* Back navigation */}
    <div class="mt-16 pt-8 border-t border-slate-800 flex items-center justify-between">
      <a href="/podcast" class="text-sm font-semibold text-emerald-400 hover:underline">
        ← Wróć do katalogu podcastów
      </a>
      <a href="/podcast/przeprogramowani" class="text-sm font-semibold text-cyan-400 hover:underline">
        Zobacz Podcast Przeprogramowani →
      </a>
    </div>
  </div>
</Layout>
