---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogImage = '/img/profiles/przemek.webp',
  ogType = 'website',
} = Astro.props;

// Configurable site URL from Astro config or environment
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://przeprogramowani.pl';
const canonicalUrl = `${siteUrl}${canonicalPath.startsWith('/') ? canonicalPath : '/' + canonicalPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? ogImage : '/' + ogImage}`;
---

<!doctype html>
<html lang="pl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Page Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Przeprogramowani.pl" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon & Colors -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>👨‍💻</text></svg>" />
    <meta name="theme-color" content="#0b0f19" />
  </head>
  <body class="bg-[#0b0f19] text-gray-100 min-h-screen flex flex-col font-sans selection:bg-blue-600 selection:text-white antialiased overflow-x-hidden">
    <Header currentPath={canonicalPath} />

    <main id="main-content" class="flex-1 w-full focus:outline-none" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
