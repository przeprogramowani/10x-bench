---
import { NAV_LINKS } from '../lib/content';
import MobileNav from '../components/MobileNav';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const links = [...NAV_LINKS];
const isActive = (href: string) =>
  currentPath === href || currentPath === href + '/' || currentPath.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-bold text-lg" aria-label="Przeprogramowani — strona główna">
      <span class="text-brand-500" aria-hidden="true">&lt;/&gt;</span>
      <span>Przeprogramowani</span>
    </a>
    <nav aria-label="Nawigacja główna" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:bg-slate-800 hover:text-white',
                  isActive(link.href) ? 'bg-slate-800 text-accent-400' : 'text-slate-300',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="https://10xdevs.pl"
            class="ml-2 inline-block rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-500"
          >
            Kurs 10xDevs
          </a>
        </li>
      </ul>
    </nav>
    <div class="md:hidden">
      <MobileNav client:load links={links.map((l) => ({ href: l.href, label: l.label }))} currentPath={currentPath} />
    </div>
  </div>
</header>
