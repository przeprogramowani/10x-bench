---
import { CONTACT_EMAIL, NAV_LINKS } from '../lib/content';
---

<footer class="border-t border-slate-800 bg-slate-950">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-3">
    <div>
      <a href="/" class="flex items-center gap-2 text-lg font-bold">
        <span class="text-brand-500" aria-hidden="true">&lt;/&gt;</span>
        Przeprogramowani
      </a>
      <p class="mt-2 max-w-xs text-sm text-slate-400">
        Szersze spojrzenie na programowanie. Edukacja technologiczna w epoce AI.
      </p>
    </div>
    <nav aria-label="Nawigacja stopki">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Strony</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {NAV_LINKS.map((link) => (
          <li>
            <a class="text-slate-400 hover:text-white" href={link.href}>{link.label}</a>
          </li>
        ))}
        <li><a class="text-slate-400 hover:text-white" href="/">Strona główna</a></li>
      </ul>
    </nav>
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Kontakt i źródła</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-slate-400 hover:text-white" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        <li><a class="text-slate-400 hover:text-white" href="https://przeprogramowani.pl" rel="noopener">Oficjalna strona projektu</a></li>
        <li><a class="text-slate-400 hover:text-white" href="https://www.youtube.com/@przeprogramowani" rel="noopener">Kanał YouTube</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-800 py-4 text-center text-xs text-slate-500">
    Nieoficjalna prezentacja projektu Przeprogramowani — strona demonstracyjna.
  </div>
</footer>
