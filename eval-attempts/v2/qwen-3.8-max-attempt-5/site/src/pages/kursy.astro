---
import Layout from '../layouts/Layout.astro';
import { COURSES } from '../lib/content';
---

<Layout
  title="Kursy — 10xDevs, Opanuj Frontend, Opanuj TypeScript"
  description="Kursy Przeprogramowanych: 10xDevs o pracy z Generative AI, Opanuj Frontend: AI Edition oraz Opanuj TypeScript. Opisy i oficjalne strony kursów."
  path="/kursy"
>
  <nav class="mt-6 text-sm text-slate-400" aria-label="Ścieżka nawigacji">
    <a class="hover:text-white hover:underline" href="/">Strona główna</a> ›
    <span aria-current="page" class="text-slate-200">Kursy</span>
  </nav>

  <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">Kursy</h1>
  <p class="mt-4 max-w-3xl leading-relaxed text-slate-300">
    Topowe programy edukacyjne Przeprogramowanych dla ambitnych programistów —
    od nowoczesnego frontendu, przez TypeScript, po świadome korzystanie
    z potencjału Generative AI.
  </p>

  <div class="mt-8 grid gap-6 lg:grid-cols-3">
    {
      COURSES.map((course) => (
        <article
          class:list={[
            'flex flex-col rounded-2xl border p-6',
            course.featured
              ? 'border-brand-600 bg-gradient-to-b from-brand-900/60 to-slate-900/60'
              : 'border-slate-800 bg-slate-900/60',
          ]}
        >
          {course.featured && (
            <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-accent-400">
              Kurs flagowy
            </p>
          )}
          <h2 class="text-xl font-bold text-white">{course.name}</h2>
          <p class="mt-1 text-sm font-medium text-brand-500">{course.tagline}</p>
          <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-300">{course.description}</p>
          <ul class="mt-4 space-y-2 text-sm text-slate-400">
            {course.highlights.map((highlight) => (
              <li class="flex gap-2">
                <span class="text-accent-400" aria-hidden="true">
                  ✓
                </span>
                {highlight}
              </li>
            ))}
          </ul>
          <a
            href={course.url}
            rel="noopener"
            target="_blank"
            class="mt-6 inline-flex items-center justify-center rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-500"
          >
            Przejdź do strony kursu ↗
          </a>
        </article>
      ))
    }
  </div>

  <p class="mt-8 text-sm text-slate-500">
    Opisy opracowano na podstawie oficjalnych stron
    <a class="mx-1 text-slate-400 underline hover:text-white" href="https://przeprogramowani.pl" rel="noopener">przeprogramowani.pl</a>,
    <a class="mx-1 text-slate-400 underline hover:text-white" href="https://opanuj.ai" rel="noopener">opanuj.ai</a>
    oraz stron produktowych kursów (stan z 8 września 2026).
  </p>
</Layout>
