---
import Layout from '../layouts/Layout.astro';
import SourceStatus from '../components/SourceStatus.astro';
import MediaItemCard from '../components/MediaItemCard.astro';
import { getSource } from '../lib/sources';

const source = await getSource('youtube');
---

<Layout
  title="YouTube — najnowsze filmy Przeprogramowani"
  description="Najnowsze filmy z oficjalnego kanału YouTube Przeprogramowani: materiały o AI, live'y i demo day kursu 10xDevs. Odtwarzanie i odnośniki do oryginałów."
  path="/youtube"
>
  <nav class="mt-6 text-sm text-slate-400" aria-label="Ścieżka nawigacji">
    <a class="hover:text-white hover:underline" href="/">Strona główna</a> ›
    <span aria-current="page" class="text-slate-200">YouTube</span>
  </nav>

  <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">YouTube</h1>
  <p class="mt-4 max-w-3xl leading-relaxed text-slate-300">
    Oficjalny kanał Przeprogramowanych na YouTube: filmy o nowoczesnym
    programowaniu z AI, transmisje live, hackathony i prezentacje projektów
    uczestników kursu 10xDevs.
  </p>
  <p class="mt-3 text-sm">
    <a class="font-medium text-accent-400 hover:underline" href={source.sourceHomeUrl} rel="noopener" target="_blank">
      Otwórz kanał Przeprogramowani na YouTube ↗
    </a>
  </p>

  <section class="mt-8" aria-labelledby="filmy">
    <h2 id="filmy" class="text-xl font-semibold text-white">Najnowsze filmy</h2>
    <div class="mt-4">
      <SourceStatus source={source} />
    </div>
    {
      source.items.length > 0 ? (
        <div class="mt-5 grid gap-4 lg:grid-cols-2">
          {source.items.map((item) => (
            <MediaItemCard item={item} kind="youtube" sourceLabel={source.sourceLabel} />
          ))}
        </div>
      ) : (
        <p class="mt-5 rounded-xl border border-slate-800 bg-slate-900/60 p-5 text-slate-300">
          Brak filmów do wyświetlenia. Najnowsze materiały znajdziesz{' '}
          <a class="text-accent-400 underline" href={source.sourceHomeUrl} rel="noopener">
            bezpośrednio na kanale YouTube
          </a>.
        </p>
      )
    }
  </section>
</Layout>
