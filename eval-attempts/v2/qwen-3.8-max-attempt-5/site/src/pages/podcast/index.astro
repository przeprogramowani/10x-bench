---
import Layout from '../../layouts/Layout.astro';
import { PODCASTS } from '../../lib/content';
---

<Layout
  title="Podcasty — Przeprogramowani"
  description="Katalog podcastów Przeprogramowanych: Opanuj.AI o sztucznej inteligencji oraz Przeprogramowani o szerszym spojrzeniu na programowanie."
  path="/podcast"
>
  <h1 class="mt-10 text-3xl font-extrabold text-white sm:text-4xl">Podcasty</h1>
  <p class="mt-4 max-w-3xl leading-relaxed text-slate-300">
    Przeprogramowani tworzą dwa podcasty: <strong class="text-white">Opanuj.AI</strong> —
    o sztucznej inteligencji z perspektywy programisty, oraz
    <strong class="text-white">Przeprogramowani</strong> — rozmowy o szerszym spojrzeniu
    na programowanie i karierze w IT. Wybierz podcast, aby zobaczyć najnowsze odcinki
    z odtwarzaczem i odnośnikami do oryginałów.
  </p>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    {
      PODCASTS.map((podcast) => (
        <article class="flex flex-col rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
          <h2 class="text-xl font-bold text-white">{podcast.name}</h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-300">{podcast.description}</p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <a
              href={podcast.path}
              class="inline-flex items-center justify-center rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-500"
            >
              Zobacz odcinki →
            </a>
            <a
              href={podcast.spotifyUrl}
              rel="noopener"
              target="_blank"
              class="text-sm font-medium text-slate-400 hover:text-white hover:underline"
            >
              Spotify ↗
            </a>
            <a
              href={podcast.appleUrl}
              rel="noopener"
              target="_blank"
              class="text-sm font-medium text-slate-400 hover:text-white hover:underline"
            >
              Apple Podcasts ↗
            </a>
          </div>
        </article>
      ))
    }
  </div>
</Layout>
