---
import Layout from '../../layouts/Layout.astro';
import SourceStatus from '../../components/SourceStatus.astro';
import MediaItemCard from '../../components/MediaItemCard.astro';
import { getSource } from '../../lib/sources';
import { PODCASTS } from '../../lib/content';

const podcast = PODCASTS[0];
const source = await getSource('opanujai');
---

<Layout
  title="Podcast Opanuj.AI — najnowsze odcinki"
  description="Podcast Opanuj.AI Przemka Smyrdka i Marcina Czarkowskiego: najnowsze odcinki o sztucznej inteligencji z odtwarzaczem i odnośnikami do oryginałów."
  path="/podcast/opanuj-ai"
>
  <nav class="mt-6 text-sm text-slate-400" aria-label="Ścieżka nawigacji">
    <a class="hover:text-white hover:underline" href="/">Strona główna</a> ›
    <a class="hover:text-white hover:underline" href="/podcast">Podcasty</a> ›
    <span aria-current="page" class="text-slate-200">Opanuj.AI</span>
  </nav>

  <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">Podcast Opanuj.AI</h1>
  <p class="mt-4 max-w-3xl leading-relaxed text-slate-300">
    {podcast.description}
  </p>
  <p class="mt-3 flex flex-wrap gap-4 text-sm">
    <a class="font-medium text-accent-400 hover:underline" href={podcast.spotifyUrl} rel="noopener" target="_blank">Słuchaj na Spotify ↗</a>
    <a class="font-medium text-accent-400 hover:underline" href={podcast.appleUrl} rel="noopener" target="_blank">Słuchaj na Apple Podcasts ↗</a>
    <a class="font-medium text-accent-400 hover:underline" href={source.sourceHomeUrl} rel="noopener" target="_blank">Strona podcastu ↗</a>
  </p>

  <section class="mt-8" aria-labelledby="odcinki">
    <h2 id="odcinki" class="text-xl font-semibold text-white">Najnowsze odcinki</h2>
    <div class="mt-4">
      <SourceStatus source={source} />
    </div>
    {
      source.items.length > 0 ? (
        <div class="mt-5 grid gap-4 lg:grid-cols-2">
          {source.items.map((item) => (
            <MediaItemCard item={item} kind="podcast" sourceLabel={source.sourceLabel} />
          ))}
        </div>
      ) : (
        <p class="mt-5 rounded-xl border border-slate-800 bg-slate-900/60 p-5 text-slate-300">
          Brak odcinków do wyświetlenia. Najnowsze materiały znajdziesz{' '}
          <a class="text-accent-400 underline" href={source.sourceHomeUrl} rel="noopener">
            bezpośrednio w źródle
          </a>.
        </p>
      )
    }
  </section>
</Layout>
