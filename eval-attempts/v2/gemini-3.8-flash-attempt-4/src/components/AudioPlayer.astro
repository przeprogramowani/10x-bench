---
import type { MediaItem } from '../data/types';

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;
---

<article class="bg-[#0f172a]/90 rounded-2xl border border-gray-800 p-6 shadow-lg hover:border-gray-700 transition-all flex flex-col justify-between">
  <div>
    {/* Header with badge & date */}
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-950/60 border border-cyan-800/50 text-cyan-300">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
        </svg>
        <span>{item.sourceName}</span>
      </span>
      <time datetime={item.publishedAt} class="text-xs text-gray-400">
        {item.formattedDate}
      </time>
    </div>

    {/* Title */}
    <h3 class="text-lg font-bold text-white hover:text-cyan-300 transition-colors mb-3 leading-snug">
      <a href={item.url} target="_blank" rel="noopener noreferrer" class="focus-visible:ring-2 focus-visible:ring-cyan-400 rounded">
        {item.title}
      </a>
    </h3>

    {/* Description snippet */}
    {item.description && (
      <p class="text-sm text-gray-400 line-clamp-3 mb-5 leading-relaxed">
        {item.description}
      </p>
    )}
  </div>

  <div class="pt-4 border-t border-gray-800/80 space-y-4">
    {/* Embedded Audio Player */}
    {item.audioUrl ? (
      <div class="bg-gray-900/90 p-3 rounded-xl border border-gray-800">
        <div class="flex items-center justify-between text-xs text-gray-400 mb-2">
          <span class="flex items-center gap-1.5 font-medium text-gray-300">
            <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Odtwarzacz odcinka
          </span>
          {item.duration && (
            <span class="bg-gray-800 px-2 py-0.5 rounded text-[11px] font-mono text-gray-300">
              {item.duration}
            </span>
          )}
        </div>
        <audio
          controls
          preload="none"
          class="w-full h-10 accent-cyan-500 rounded-lg focus-visible:ring-2 focus-visible:ring-cyan-400"
          aria-label={`Odtwórz odcinek: ${item.title}`}
        >
          <source src={item.audioUrl} type="audio/mpeg" />
          Twoja przeglądarka nie obsługuje elementu audio. Możesz odsłuchać odcinek bezpośrednio w serwisie.
        </audio>
      </div>
    ) : (
      <div class="p-3 bg-gray-900/60 rounded-xl border border-gray-800 text-xs text-gray-400">
        Odtwarzanie audio bezpośrednie jest niedostępne u tego dostawcy. Odsłuchaj w serwisie Spotify.
      </div>
    )}

    {/* Independent link to original item */}
    <div class="flex items-center justify-between gap-3 text-xs">
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-gray-800/80 hover:bg-gray-700/80 text-cyan-300 hover:text-white font-medium transition-colors border border-gray-700/50 w-full justify-center sm:w-auto"
        aria-label={`Otwórz odcinek "${item.title}" w serwisie źródłowym`}
      >
        <span>Otwórz w Spotify / Podcasters</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <span class="text-gray-500 text-[11px] hidden sm:inline">
        Oryginalny link
      </span>
    </div>
  </div>
</article>
