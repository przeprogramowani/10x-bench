---
interface Props {
  status: 'live' | 'stale_cache' | 'error';
  isStale: boolean;
  fetchedAt: string;
  sourceUrl: string;
  sourceName: string;
  errorMessage?: string;
}

const { status, fetchedAt, sourceUrl, sourceName, errorMessage } = Astro.props;
const formattedTime = new Date(fetchedAt).toLocaleString('pl-PL', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
});
---

<div class="mb-8 p-4 rounded-xl border text-sm backdrop-blur-sm transition-all"
  class:list={[
    status === 'live' && 'bg-emerald-950/20 border-emerald-800/50 text-emerald-200',
    status === 'stale_cache' && 'bg-amber-950/30 border-amber-800/60 text-amber-200',
    status === 'error' && 'bg-rose-950/30 border-rose-800/60 text-rose-200',
  ]}
>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      {status === 'live' && (
        <>
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
          </span>
          <span class="font-medium">Źródło zweryfikowane na żywo</span>
          <span class="text-xs text-emerald-400/80">({formattedTime})</span>
        </>
      )}

      {status === 'stale_cache' && (
        <>
          <span class="relative flex h-3 w-3">
            <span class="relative inline-flex rounded-full h-3 w-3 bg-amber-500"></span>
          </span>
          <div>
            <span class="font-semibold">Tryb awaryjny — dane z pamięci podręcznej</span>
            <span class="text-xs text-amber-300/80 ml-1.5">(ostatnia aktualizacja: {formattedTime})</span>
            {errorMessage && (
              <p class="text-xs text-amber-400/90 mt-0.5">{errorMessage}</p>
            )}
          </div>
        </>
      )}

      {status === 'error' && (
        <>
          <span class="relative flex h-3 w-3">
            <span class="relative inline-flex rounded-full h-3 w-3 bg-rose-500"></span>
          </span>
          <span class="font-semibold">Źródło chwilowo niedostępne</span>
        </>
      )}
    </div>

    <div class="text-xs">
      <a
        href={sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 underline underline-offset-2 hover:opacity-80 font-medium"
      >
        <span>Odwiedź źródło: {sourceName}</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</div>
