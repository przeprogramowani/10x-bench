---
import Layout from '../../layouts/Layout.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import MediaStatusBadge from '../../components/MediaStatusBadge.astro';
import { fetchOpanujAiEpisodes } from '../../data/sources/opanuj-ai';

const result = await fetchOpanujAiEpisodes();
const episodes = result.data;
---

<Layout
  title="Podcast Opanuj.AI — Przeprogramowani | Odcinki i odtwarzanie"
  description="Oficjalny podcast Opanuj.AI prowadzony przez Marcina Czarkowskiego i Przemka Smyrdka. Najnowsze odcinki, odtwarzanie audio i analizy frontierowych modeli AI."
  canonicalPath="/podcast/opanuj-ai"
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-2 text-xs text-gray-400 mb-6" aria-label="Ścieżka powrotu">
      <a href="/" class="hover:text-amber-400">Strona główna</a>
      <span>/</span>
      <a href="/podcast" class="hover:text-cyan-400">Podcasty</a>
      <span>/</span>
      <span class="text-gray-200" aria-current="page">Opanuj.AI</span>
    </nav>

    {/* Header */}
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 mb-4">
        <span>Podcast technologiczny AI</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        Opanuj.AI Podcast
      </h1>
      <p class="text-lg text-gray-300 leading-relaxed mb-4">
        Opanuj.AI to comiesięczne techniczne podsumowanie rewolucji sztucznej inteligencji. Marcin Czarkowski i Przemek Smyrdek analizują możliwości modeli LLM (Claude Opus, GPT-5, DeepSeek), agentów kodujących oraz wpływ AI na proces wytwarzania oprogramowania (SDLC).
      </p>
      <div class="flex flex-wrap items-center gap-4 text-xs text-gray-400">
        <span>Prowadzący: <strong>Marcin Czarkowski</strong> i <strong>Przemek Smyrdek</strong></span>
        <span>•</span>
        <span>Częstotliwość: <strong>Co miesiąc</strong></span>
        <span>•</span>
        <span>Społeczność: <strong>4000+ słuchaczy</strong></span>
      </div>
    </div>

    {/* Source Verification Badge */}
    <MediaStatusBadge
      status={result.status}
      isStale={result.isStale}
      fetchedAt={result.fetchedAt}
      sourceUrl={result.sourceUrl}
      sourceName="Feed RSS Opanuj.AI (Anchor/Spotify)"
      errorMessage={result.errorMessage}
    />

    {/* Episodes List */}
    <section aria-labelledby="episodes-heading">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-gray-800">
        <div>
          <h2 id="episodes-heading" class="text-2xl font-bold text-white tracking-tight">
            Najnowsze odcinki (okres 90 dni)
          </h2>
          <p class="text-xs text-gray-400 mt-1">
            Rzeczywiste materiały opublikowane w oficjalnym feedzie RSS
          </p>
        </div>
        <div class="text-xs font-mono text-cyan-400">
          Liczba materiałów: {episodes.length}
        </div>
      </div>

      {episodes.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {episodes.map((episode) => (
            <AudioPlayer item={episode} />
          ))}
        </div>
      ) : (
        <div class="p-8 rounded-2xl bg-gray-900 border border-gray-800 text-center">
          <p class="text-gray-300 text-sm">Brak dostępnych odcinków w wybranym okresie.</p>
          <a href={result.sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block text-xs text-cyan-400 underline">
            Sprawdź oficjalny kanał Spotify
          </a>
        </div>
      )}
    </section>

    {/* Back navigation CTA */}
    <div class="mt-16 pt-8 border-t border-gray-800/80 flex flex-wrap items-center justify-between gap-4 text-sm">
      <a href="/podcast" class="inline-flex items-center gap-2 text-cyan-400 hover:text-cyan-300 font-semibold">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Wróć do katalogu podcastów</span>
      </a>
      <a href="/podcast/przeprogramowani" class="inline-flex items-center gap-2 text-amber-400 hover:text-amber-300 font-semibold">
        <span>Zobacz drugi podcast: Przeprogramowani ft. Gość</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</Layout>
