---
import type { MediaItem } from '../data/types';

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;
---

<article class="flex flex-col bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 transition-all duration-300 shadow-lg">
  <!-- Embedded Video Player / Iframe with 16:9 ratio -->
  <div class="relative w-full aspect-video bg-slate-950">
    <iframe
      class="absolute inset-0 w-full h-full border-0"
      src={item.embedUrl}
      title={item.title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    >
    </iframe>
  </div>

  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <!-- Meta: Source & Date -->
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400 mb-3">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-red-950/60 border border-red-800/40 text-red-300 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500" aria-hidden="true"></span>
          YouTube
        </span>
        <time datetime={item.publishedAt} class="text-slate-400">
          📅 {item.publishedDateFormatted}
        </time>
      </div>

      <!-- Title -->
      <h3 class="text-lg sm:text-xl font-bold text-white mb-3 hover:text-amber-400 transition-colors">
        <a href={item.url} target="_blank" rel="noopener noreferrer" class="focus-visible:ring-1 focus-visible:ring-amber-400 focus-visible:rounded">
          {item.title}
        </a>
      </h3>

      <!-- Description -->
      <p class="text-sm text-slate-300 line-clamp-3 mb-6 leading-relaxed">
        {item.description}
      </p>
    </div>

    <!-- Independent Link and Fallback Notice -->
    <div class="pt-4 border-t border-slate-800/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-md bg-red-600/90 hover:bg-red-500 text-white transition-colors focus-visible:ring-2 focus-visible:ring-red-400"
      >
        <span>Oglądaj bezpośrednio na YouTube</span>
        <span aria-hidden="true">↗</span>
      </a>
      <span class="text-[11px] text-slate-500">
        Jeśli osadzenie jest zablokowane, skorzystaj z linku.
      </span>
    </div>
  </div>
</article>
