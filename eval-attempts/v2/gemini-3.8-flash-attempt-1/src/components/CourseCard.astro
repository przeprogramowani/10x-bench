---
import type { CourseItem } from '../data/types';

interface Props {
  course: CourseItem;
}

const { course } = Astro.props;
---

<div
  class={`relative flex flex-col justify-between rounded-2xl p-6 sm:p-8 transition-all duration-300 ${
    course.isFeatured
      ? 'bg-gradient-to-b from-amber-950/30 via-slate-900 to-slate-900 border-2 border-amber-500/60 shadow-2xl shadow-amber-500/10'
      : 'bg-slate-900/80 border border-slate-800 hover:border-slate-700 shadow-xl'
  }`}
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-4">
      {course.badge && (
        <span
          class={`text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider ${
            course.isFeatured
              ? 'bg-amber-400 text-slate-950'
              : 'bg-slate-800 text-slate-300 border border-slate-700'
          }`}
        >
          {course.badge}
        </span>
      )}
      {course.isFeatured && (
        <span class="text-xs font-semibold text-amber-400">
          Wyróżniony program
        </span>
      )}
    </div>

    <h3 class="text-2xl font-black text-white tracking-tight mb-2">
      {course.title}
    </h3>
    <p class="text-sm font-medium text-amber-400/90 mb-4">
      {course.subtitle}
    </p>
    <p class="text-sm text-slate-300 leading-relaxed mb-6">
      {course.description}
    </p>

    <!-- Key highlights -->
    <div class="space-y-2.5 mb-8">
      <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">
        Co zyskujesz:
      </p>
      {course.highlights.map((highlight) => (
        <div class="flex items-start gap-2.5 text-xs text-slate-300">
          <span class="text-amber-400 font-bold mt-0.5">✓</span>
          <span>{highlight}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="pt-6 border-t border-slate-800">
    <a
      href={course.url}
      target="_blank"
      rel="noopener noreferrer"
      class={`w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm transition-all focus-visible:ring-2 ${
        course.isFeatured
          ? 'bg-amber-400 hover:bg-amber-300 text-slate-950 shadow-lg shadow-amber-400/20 hover:scale-[1.02] focus-visible:ring-amber-400'
          : 'bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 hover:border-slate-600 focus-visible:ring-slate-400'
      }`}
    >
      <span>Sprawdź szczegóły na {new URL(course.url).hostname}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>
