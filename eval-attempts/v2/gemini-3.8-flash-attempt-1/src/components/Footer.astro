---
---
<footer class="border-t border-slate-800 bg-slate-950 text-slate-400 py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12 mb-12">
      <!-- Col 1: Brand Info & Home link -->
      <div class="space-y-4 md:col-span-1">
        <a href="/" class="flex items-center gap-2 text-white font-bold text-xl hover:text-amber-400 transition-colors" aria-label="Wróć na stronę główną">
          <span class="text-amber-400 font-mono text-2xl font-black">&lt;/&gt;</span>
          <span>Przeprogramowani</span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed">
          Szersze spojrzenie na programowanie. Tworzymy programy edukacyjne, podcasty i filmy dla ambitnych programistów w erze sztucznej inteligencji.
        </p>
        <div class="pt-2">
          <a
            href="/"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-400 hover:text-amber-300 underline underline-offset-4 focus-visible:ring-1 focus-visible:ring-amber-400"
          >
            ← Wróć na stronę główną
          </a>
        </div>
      </div>

      <!-- Col 2: Strony i nawigacja -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Strony projektu</h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="hover:text-white transition-colors focus-visible:ring-1 focus-visible:ring-amber-400">Strona główna</a>
          </li>
          <li>
            <a href="/o-nas" class="hover:text-white transition-colors focus-visible:ring-1 focus-visible:ring-amber-400">O nas (Twórcy)</a>
          </li>
          <li>
            <a href="/podcast" class="hover:text-white transition-colors focus-visible:ring-1 focus-visible:ring-amber-400">Katalog podcastów</a>
          </li>
          <li>
            <a href="/podcast/opanuj-ai" class="text-slate-400 hover:text-amber-400 transition-colors pl-2">↳ Opanuj.AI Podcast</a>
          </li>
          <li>
            <a href="/podcast/przeprogramowani" class="text-slate-400 hover:text-amber-400 transition-colors pl-2">↳ Podcast Przeprogramowani</a>
          </li>
          <li>
            <a href="/youtube" class="hover:text-white transition-colors focus-visible:ring-1 focus-visible:ring-amber-400">YouTube</a>
          </li>
          <li>
            <a href="/kursy" class="hover:text-white transition-colors focus-visible:ring-1 focus-visible:ring-amber-400">Wszystkie kursy</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Nasze programy -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Programy edukacyjne</h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href="https://10xdevs.pl"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-amber-400 hover:text-amber-300 font-medium focus-visible:ring-1 focus-visible:ring-amber-400"
            >
              <span>10xDevs 4.0 (Nowość)</span>
              <span class="text-xs">↗</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.opanujfrontend.pl"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors focus-visible:ring-1 focus-visible:ring-amber-400"
            >
              Opanuj Frontend: AI Edition ↗
            </a>
          </li>
          <li>
            <a
              href="https://www.opanujtypescript.pl"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors focus-visible:ring-1 focus-visible:ring-amber-400"
            >
              Opanuj TypeScript ↗
            </a>
          </li>
          <li>
            <a
              href="https://opanuj.ai"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors focus-visible:ring-1 focus-visible:ring-amber-400"
            >
              Społeczność Opanuj.AI ↗
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Kontakt i założyciele -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Kontakt i twórcy</h3>
        <p class="text-sm text-slate-400 mb-3">
          Przemysław Smyrdek & Marcin Czarkowski
        </p>
        <p class="text-sm mb-4">
          Napisz do nas:{' '}
          <a
            href="mailto:kontakt@przeprogramowani.pl"
            class="text-amber-400 hover:underline focus-visible:ring-1 focus-visible:ring-amber-400"
          >
            kontakt@przeprogramowani.pl
          </a>
        </p>
        <div class="flex flex-wrap gap-2 pt-1 text-xs">
          <a
            href="https://www.linkedin.com/in/psmyrdek/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700"
          >
            LinkedIn Przemek ↗
          </a>
          <a
            href="https://www.linkedin.com/in/mkczarkowski/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700"
          >
            LinkedIn Marcin ↗
          </a>
          <a
            href="https://www.youtube.com/@przeprogramowani"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700"
          >
            Kanał YouTube ↗
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© 2026 Przeprogramowani.pl. Wszelkie prawa zastrzeżone.</p>
      <div class="flex items-center gap-4">
        <span>Astro 7 + React 19 + Tailwind CSS 4</span>
        <span aria-hidden="true">•</span>
        <span>Cloudflare Workers Ready</span>
      </div>
    </div>
  </div>
</footer>
