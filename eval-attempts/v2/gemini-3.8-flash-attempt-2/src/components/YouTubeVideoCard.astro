---
import type { MediaItem } from '../data/types';

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;
---

<article class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/60 overflow-hidden hover:border-slate-700 transition-all shadow-sm">
  <!-- Embedded YouTube Player -->
  <div class="relative w-full aspect-video bg-slate-950">
    {item.embedUrl ? (
      <iframe
        src={item.embedUrl}
        title={item.title}
        class="w-full h-full border-0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex flex-col items-center justify-center p-4 text-center">
        <p class="text-sm text-slate-400 mb-2">Odtwarzacz niedostępny w osadzeniu.</p>
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 rounded-lg bg-red-600 text-white text-xs font-bold hover:bg-red-500"
        >
          Obejrzyj na YouTube ↗
        </a>
      </div>
    )}
  </div>

  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div>
      <!-- Meta -->
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400 mb-2.5">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-red-950/60 border border-red-800/40 text-red-300 font-medium">
          <svg class="w-3 h-3 text-red-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          {item.sourceName}
        </span>
        <time datetime={item.publishedAt !== 'nieznana' ? item.publishedAt : undefined}>
          Data publikacji: <strong class="text-slate-300">{item.publishedDateDisplay}</strong>
        </time>
      </div>

      <!-- Title -->
      <h3 class="text-lg font-bold text-white mb-2 leading-snug">
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-amber-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded"
        >
          {item.title}
        </a>
      </h3>

      <!-- Description -->
      {item.description && (
        <p class="text-sm text-slate-300 line-clamp-2 mb-4 leading-relaxed">
          {item.description}
        </p>
      )}
    </div>

    <!-- Actions & Links -->
    <div class="mt-4 pt-4 border-t border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
      <span class="text-slate-400">
        Problemy z odtwarzaniem? Osadzenie zablokowane?
      </span>
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 font-semibold text-amber-400 hover:text-amber-300 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded px-1 self-start sm:self-auto"
        aria-label={`Otwórz film „${item.title}” bezpośrednio w serwisie YouTube`}
      >
        <span>Obejrzyj na YouTube</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>
