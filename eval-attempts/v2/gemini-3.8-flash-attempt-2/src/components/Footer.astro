---
import { aboutBrand } from '../data/founders';
---

<footer class="border-t border-slate-800 bg-slate-950 mt-auto text-slate-400">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: Brand -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2 text-white font-bold text-lg mb-3">
          <span class="text-amber-400 font-mono" aria-hidden="true">&lt;/&gt;</span>
          <span>{aboutBrand.name}</span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed">
          {aboutBrand.tagline}. Przestrzeń łącząca programowanie, architekturę, AI oraz rozwój inżynierów.
        </p>
        <div class="mt-4 text-xs text-slate-500">
          Ponad {aboutBrand.yearsOnMarket} na rynku edukacji technologicznej.
        </div>
      </div>

      <!-- Col 2: Strony serwisu -->
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4">
          Nawigacja
        </h2>
        <ul class="space-y-2.5 text-sm" role="list">
          <li>
            <a href="/" class="hover:text-amber-400 transition-colors">Strona główna</a>
          </li>
          <li>
            <a href="/o-nas" class="hover:text-amber-400 transition-colors">O nas</a>
          </li>
          <li>
            <a href="/podcast" class="hover:text-amber-400 transition-colors">Katalog podcastów</a>
          </li>
          <li>
            <a href="/podcast/opanuj-ai" class="hover:text-amber-400 transition-colors pl-2 text-slate-400 border-l border-slate-800">Podcast Opanuj.AI</a>
          </li>
          <li>
            <a href="/podcast/przeprogramowani" class="hover:text-amber-400 transition-colors pl-2 text-slate-400 border-l border-slate-800">Podcast Przeprogramowani</a>
          </li>
          <li>
            <a href="/youtube" class="hover:text-amber-400 transition-colors">Filmy YouTube</a>
          </li>
          <li>
            <a href="/kursy" class="hover:text-amber-400 transition-colors">Kursy i szkolenia</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Kursy i produkty -->
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4">
          Programy edukacyjne
        </h2>
        <ul class="space-y-2.5 text-sm" role="list">
          <li>
            <a href="https://10xdevs.pl" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors inline-flex items-center gap-1">
              <span>10xDevs (Programuj z AI)</span>
              <span aria-hidden="true" class="text-xs">↗</span>
            </a>
          </li>
          <li>
            <a href="https://www.opanujfrontend.pl" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors inline-flex items-center gap-1">
              <span>Opanuj Frontend: AI Edition</span>
              <span aria-hidden="true" class="text-xs">↗</span>
            </a>
          </li>
          <li>
            <a href="https://www.opanujtypescript.pl" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors inline-flex items-center gap-1">
              <span>Opanuj TypeScript</span>
              <span aria-hidden="true" class="text-xs">↗</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Kontakt i źródła -->
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4">
          Oficjalny kontakt
        </h2>
        <p class="text-sm text-slate-400 mb-3">
          Współpraca, szkolenia i pytania:
        </p>
        <a
          href={`mailto:${aboutBrand.contactEmail}`}
          class="text-sm text-amber-400 hover:underline font-mono"
        >
          {aboutBrand.contactEmail}
        </a>

        <div class="mt-6 pt-4 border-t border-slate-800 text-xs text-slate-500">
          Wszystkie dane materiałów pobierane są po stronie serwera z oficjalnych kanałów i feedów RSS.
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        &copy; {new Date().getFullYear()} Przeprogramowani.pl. Wszelkie prawa zastrzeżone.
      </div>
      <div class="flex items-center gap-4">
        <a href="https://przeprogramowani.pl" target="_blank" rel="noopener noreferrer" class="hover:text-slate-400 transition-colors">
          Oficjalna strona projektu
        </a>
        <span>•</span>
        <a href="https://youtube.com/@Przeprogramowani" target="_blank" rel="noopener noreferrer" class="hover:text-slate-400 transition-colors">
          Kanał YouTube
        </a>
      </div>
    </div>
  </div>
</footer>
