---
import MobileNav from './MobileNav';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navItems = [
  { href: '/o-nas', label: 'O nas' },
  { href: '/podcast', label: 'Podcasty' },
  { href: '/youtube', label: 'YouTube' },
  { href: '/kursy', label: 'Kursy' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-slate-800 bg-slate-950/90 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2 text-white font-bold text-lg hover:text-amber-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 rounded-md"
      aria-label="Przeprogramowani — Strona główna"
    >
      <span class="text-amber-400 font-mono text-xl" aria-hidden="true">&lt;/&gt;</span>
      <span class="tracking-tight">Przeprogramowani</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Nawigacja główna">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || currentPath.startsWith(item.href + '/');
        return (
          <a
            href={item.href}
            class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 ${
              isActive
                ? 'bg-slate-800 text-white font-semibold'
                : 'text-slate-300 hover:text-white hover:bg-slate-900'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right side / CTA -->
    <div class="flex items-center gap-3">
      <a
        href="https://10xdevs.pl"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs md:text-sm font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300"
      >
        <span>10xDevs</span>
        <span aria-hidden="true" class="text-xs">↗</span>
      </a>

      <!-- Mobile navigation menu -->
      <MobileNav client:load />
    </div>
  </div>
</header>
