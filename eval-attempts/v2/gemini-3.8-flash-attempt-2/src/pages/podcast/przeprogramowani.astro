---
import Layout from '../../layouts/Layout.astro';
import { fetchPrzeprogramowaniPodcast } from '../../data/fetch-przeprogramowani-podcast';
import AudioPlayerCard from '../../components/AudioPlayerCard.astro';
import ResilienceNotice from '../../components/ResilienceNotice.astro';

// Check if controlled failure simulation is requested via query param (e.g. ?simulate_failure=1)
const simulateFailureParam = Astro.url.searchParams.get('simulate_failure') === 'true' || Astro.url.searchParams.get('simulate_failure') === '1';

const data = await fetchPrzeprogramowaniPodcast({ forceError: simulateFailureParam });
---

<Layout
  title="Podcast Przeprogramowani ft. Gość — Rozmowy dla głodnych wiedzy"
  description="Podcast Przeprogramowani: wywiady z czołowymi inżynierami i liderami technologicznymi. Architektura aplikacji, inżynieria jakości, dojrzałość programistyczna i rozwój kariery."
>
  <!-- Hero Section -->
  <section class="border-b border-slate-800 bg-gradient-to-b from-slate-900 to-slate-950 py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <nav aria-label="Ścieżka powrotu" class="mb-6">
          <ol class="flex items-center gap-2 text-xs font-semibold text-slate-400">
            <li>
              <a href="/" class="hover:text-amber-400 transition-colors">Strona główna</a>
            </li>
            <li aria-hidden="true">/</li>
            <li>
              <a href="/podcast" class="hover:text-amber-400 transition-colors">Podcasty</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="text-sky-400" aria-current="page">Przeprogramowani</li>
          </ol>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-300 text-xs font-bold uppercase tracking-wider mb-4">
          Rozmowy & Architektura
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Podcast Przeprogramowani
        </h1>

        <p class="mt-4 text-lg text-slate-300 leading-relaxed">
          Szersze spojrzenie na inżynierię oprogramowania. Zapraszają <strong>Przemek Smyrdek</strong> i <strong>Marcin Czarkowski</strong>. Dyskutujemy z gośćmi o architekturze nowoczesnego frontendu, rozwoju zawodowym, wyzwaniach zespołów produktowych, Open Source oraz budowaniu trwałego kapitału kariery programisty.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-400">
          <span>👥 Ponad 3800 stałych słuchaczy</span>
          <span>•</span>
          <a
            href="https://open.spotify.com/show/3yVvOAXSYq6sQB02w4A4wo"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sky-400 hover:underline font-semibold"
          >
            Subskrybuj na Spotify ↗
          </a>
          <span>•</span>
          <a
            href="https://anchor.fm/s/c72d808/podcast/rss"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-300 hover:text-white"
          >
            Oficjalny feed RSS ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Episodes Section -->
  <section class="py-16 sm:py-20 bg-slate-950" aria-labelledby="episodes-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <h2 id="episodes-heading" class="text-2xl sm:text-3xl font-bold text-white">
          Najnowsze rzeczywiste odcinki
        </h2>
        <p class="mt-2 text-sm text-slate-400">
          Poniżej prezentujemy niepusty wybór najnowszych dostępnych materiałów wraz z ich autentycznymi datami publikacji i bezstratnym odtwarzaniem audio.
        </p>
      </div>

      <!-- Resilience Fallback Banner -->
      <ResilienceNotice
        status={data.status}
        isFallback={data.isFallback}
        message={data.message}
        sourceUrl={data.sourceUrl}
        fetchedAt={data.fetchedAt}
      />

      <!-- Episodes List -->
      <div class="space-y-6">
        {data.items.map((item) => (
          <AudioPlayerCard item={item} />
        ))}
      </div>

      <!-- Bottom Navigation Back to Hub -->
      <div class="mt-12 pt-8 border-t border-slate-800 flex flex-wrap items-center justify-between gap-4">
        <a
          href="/podcast"
          class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400 hover:text-amber-300"
        >
          <span aria-hidden="true">←</span>
          <span>Wróć do katalogu podcastów</span>
        </a>
        <a
          href="/podcast/opanuj-ai"
          class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400 hover:text-amber-300"
        >
          <span>Zobacz Podcast Opanuj.AI</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
