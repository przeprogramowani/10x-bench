---
import Layout from '../layouts/Layout.astro';
import { fetchYouTube } from '../data/fetch-youtube';
import YouTubeVideoCard from '../components/YouTubeVideoCard.astro';
import ResilienceNotice from '../components/ResilienceNotice.astro';

// Check if controlled failure simulation is requested via query param (e.g. ?simulate_failure=1)
const simulateFailureParam = Astro.url.searchParams.get('simulate_failure') === 'true' || Astro.url.searchParams.get('simulate_failure') === '1';

const data = await fetchYouTube({ forceError: simulateFailureParam });
---

<Layout
  title="Oficjalny kanał YouTube Przeprogramowani — Filmy i transmisje LIVE"
  description="Oglądaj najnowsze filmy oficjalnego kanału Przeprogramowani: warsztaty na żywo o sztucznej inteligencji, analizy benchmarków AI, 10xWorkflow oraz omówienia nowoczesnych technik programowania."
>
  <!-- Hero Section -->
  <section class="border-b border-slate-800 bg-gradient-to-b from-slate-900 to-slate-950 py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <nav aria-label="Ścieżka powrotu" class="mb-6">
          <ol class="flex items-center gap-2 text-xs font-semibold text-slate-400">
            <li>
              <a href="/" class="hover:text-amber-400 transition-colors">Strona główna</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="text-red-400" aria-current="page">YouTube</li>
          </ol>
        </nav>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold uppercase tracking-wider mb-4">
          Wideo & Warsztaty Live
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Oficjalny kanał YouTube Przeprogramowani
        </h1>

        <p class="mt-4 text-lg text-slate-300 leading-relaxed">
          Praktyczna wiedza inżynierska w formie wideo. Oglądaj transmisje na żywo, relacje z hackathonów, demonstracje projektów z kursu 10xDevs (Demo Day) oraz wnikliwe analizy narzędzi AI i bibliotek open source.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-400">
          <a
            href="https://www.youtube.com/@Przeprogramowani"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-500 text-white font-semibold transition-colors"
          >
            <span>Subskrybuj kanał YouTube</span>
            <span aria-hidden="true">↗</span>
          </a>
          <span>•</span>
          <a
            href="https://www.youtube.com/feeds/videos.xml?channel_id=UCb2Y3vMeD6N4WDt5Acw7Arw"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-300 hover:text-white"
          >
            Oficjalny feed Atom ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Video Grid Section -->
  <section class="py-16 sm:py-20 bg-slate-950" aria-labelledby="videos-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <h2 id="videos-heading" class="text-2xl sm:text-3xl font-bold text-white">
          Najnowsze rzeczywiste filmy (ostatnie 90 dni)
        </h2>
        <p class="mt-2 text-sm text-slate-400">
          Materiały wideo pobrane bezpośrednio z oficjalnego kanału YouTube Przeprogramowani. Każdy film możesz obejrzeć bezpośrednio w osadzonym odtwarzaczu lub otworzyć w serwisie YouTube.
        </p>
      </div>

      <!-- Resilience Fallback Banner -->
      <ResilienceNotice
        status={data.status}
        isFallback={data.isFallback}
        message={data.message}
        sourceUrl={data.sourceUrl}
        fetchedAt={data.fetchedAt}
      />

      <!-- Grid of videos -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {data.items.map((item) => (
          <YouTubeVideoCard item={item} />
        ))}
      </div>

      <!-- Footer CTA back to home -->
      <div class="mt-16 pt-8 border-t border-slate-800 flex flex-wrap items-center justify-between gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400 hover:text-amber-300"
        >
          <span aria-hidden="true">←</span>
          <span>Wróć na stronę główną</span>
        </a>
        <a
          href="https://www.youtube.com/@Przeprogramowani"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-red-400 hover:text-red-300"
        >
          <span>Wszystkie filmy na oficjalnym kanale</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
