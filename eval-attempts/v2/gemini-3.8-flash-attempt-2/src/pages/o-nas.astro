---
import Layout from '../layouts/Layout.astro';
import { founders, aboutBrand } from '../data/founders';
---

<Layout
  title="O nas — Twórcy i wartości"
  description="Poznaj Przeprogramowanych: misję, wartości oraz sylwetki współzałożycieli — Przemka Smyrdka i Marcina Czarkowskiego. Łączymy inżynierię oprogramowania, architekturę i rozwój w epoce AI."
>
  <!-- Hero Section -->
  <section class="border-b border-slate-800 bg-gradient-to-b from-slate-900 to-slate-950 py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <nav aria-label="Ścieżka powrotu" class="mb-6">
          <ol class="flex items-center gap-2 text-xs font-semibold text-slate-400">
            <li>
              <a href="/" class="hover:text-amber-400 transition-colors">Strona główna</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="text-amber-400" aria-current="page">O nas</li>
          </ol>
        </nav>

        <p class="text-xs font-bold uppercase tracking-widest text-amber-400">Zespół i filozofia</p>
        <h1 class="mt-3 text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          O Przeprogramowanych
        </h1>
        <p class="mt-4 text-lg text-slate-300 leading-relaxed">
          {aboutBrand.mission}
        </p>
      </div>
    </div>
  </section>

  <!-- Founders Section -->
  <section class="py-16 sm:py-20 bg-slate-950 border-b border-slate-800" aria-labelledby="founders-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <p class="text-xs font-bold uppercase tracking-widest text-amber-400">Założyciele</p>
        <h2 id="founders-heading" class="mt-2 text-2xl sm:text-4xl font-bold text-white tracking-tight">
          Sylwetki twórców
        </h2>
        <p class="mt-3 text-slate-400 text-sm sm:text-base">
          Doświadczeni inżynierowie i liderzy techniczni z bogatą praktyką w międzynarodowych organizacjach oraz świecie Open Source.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {founders.map((founder) => (
          <article class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/70 p-6 sm:p-8 hover:border-slate-700 transition-all">
            <div>
              <div class="flex items-center gap-4 mb-5">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-amber-500 to-amber-300 flex items-center justify-center text-slate-950 text-2xl font-black shadow-md">
                  {founder.name.split(' ').map((n) => n[0]).join('')}
                </div>
                <div>
                  <h3 class="text-xl sm:text-2xl font-bold text-white">{founder.name}</h3>
                  <p class="text-xs sm:text-sm font-semibold text-amber-400">{founder.role}</p>
                </div>
              </div>

              <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-6">
                {founder.bio}
              </p>

              <div class="space-y-2 mb-6 pt-4 border-t border-slate-800/80">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">
                  Kluczowe doświadczenia i obszary:
                </h4>
                <ul class="space-y-1.5" role="list">
                  {founder.highlights.map((highlight) => (
                    <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-300">
                      <span class="text-amber-400 shrink-0 font-bold">✓</span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
              <span class="text-xs text-slate-500">Profil zawodowy:</span>
              <a
                href={founder.linkedInUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
                aria-label={`Profil LinkedIn: ${founder.name} (otwiera w nowej karcie)`}
              >
                <span>LinkedIn</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand Values Section -->
  <section class="py-16 sm:py-20 bg-slate-900/40 border-b border-slate-800" aria-labelledby="values-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <p class="text-xs font-bold uppercase tracking-widest text-amber-400">Fundamenty</p>
        <h2 id="values-heading" class="mt-2 text-2xl sm:text-4xl font-bold text-white tracking-tight">
          Nasze wartości i zasady
        </h2>
        <p class="mt-3 text-slate-400 text-sm sm:text-base">
          Czym kierujemy się przy tworzeniu programów, podcastów i materiałów inżynierskich.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {aboutBrand.values.map((val, idx) => (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 sm:p-7">
            <span class="text-amber-400 font-mono text-sm font-bold">0{idx + 1}.</span>
            <h3 class="text-lg font-bold text-white mt-2 mb-2">{val.title}</h3>
            <p class="text-sm text-slate-300 leading-relaxed">{val.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust & Stats Section -->
  <section class="py-16 sm:py-20 bg-slate-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 p-8 sm:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div>
            <span class="px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30">
              Społeczność i Zaufanie
            </span>
            <h2 class="mt-4 text-2xl sm:text-3xl font-bold text-white">
              Edukacja technologiczna od ponad {aboutBrand.yearsOnMarket}
            </h2>
            <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed">
              Z naszych kursów, podcastów i materiałów wideo skorzystały tysiące inżynierów z wiodących przedsiębiorstw w Polsce i na świecie. Stale rozwijamy programy i wspieramy adeptów nowoczesnego software developmentu.
            </p>
            <div class="mt-6 flex flex-wrap gap-4">
              <a
                href="/kursy"
                class="px-5 py-2.5 rounded-xl font-bold text-sm bg-amber-500 text-slate-950 hover:bg-amber-400 transition-colors"
              >
                Przeglądaj kursy →
              </a>
              <a
                href={`mailto:${aboutBrand.contactEmail}`}
                class="px-5 py-2.5 rounded-xl font-semibold text-sm bg-slate-800 text-slate-200 hover:text-white hover:bg-slate-700 transition-colors"
              >
                Napisz do nas
              </a>
            </div>
          </div>

          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">
              Zaufali nam pracownicy i liderzy m.in.:
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              {aboutBrand.trustedBy.map((brand) => (
                <div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-center text-xs font-semibold text-slate-300">
                  {brand}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
