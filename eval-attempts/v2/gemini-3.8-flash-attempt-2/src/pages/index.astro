---
import Layout from '../layouts/Layout.astro';
import { courses } from '../data/courses';
import { aboutBrand } from '../data/founders';
import { fetchOpanujAi } from '../data/fetch-opanuj-ai';
import { fetchYouTube } from '../data/fetch-youtube';

const featuredCourse = courses.find((c) => c.id === '10xdevs') || courses[0];
const opanujAiData = await fetchOpanujAi();
const youtubeData = await fetchYouTube();

const latestPodcast = opanujAiData.items[0];
const latestVideo = youtubeData.items[0];
---

<Layout
  title="Szersze spojrzenie na programowanie"
  description="Przeprogramowani.pl — przestrzeń nowoczesnej edukacji technologicznej. Kurs 10xDevs o programowaniu z Generatywnym AI, szkolenia Opanuj Frontend i Opanuj TypeScript oraz podcasty i materiały wideo."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden border-b border-slate-800 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950 py-16 sm:py-24">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber-500/10 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-300 text-xs sm:text-sm font-semibold mb-6">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Nowość — Edycja 2026: Programuj z Agentami AI
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight">
          Szersze spojrzenie na <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">programowanie</span>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-slate-300 leading-relaxed max-w-2xl">
          Edukacja technologiczna dla ambitnych programistów. Łączymy inżynierię oprogramowania, architekturę systemów, rozwój osobisty i świadome wykorzystanie Generatywnego AI.
        </p>

        <!-- Featured 10xDevs Course Hero Box -->
        <div class="mt-10 rounded-2xl border-2 border-amber-500/40 bg-slate-900/90 p-6 sm:p-8 shadow-2xl shadow-amber-500/5 relative overflow-hidden">
          <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <span class="px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-amber-500 text-slate-950">
              Wyróżniony Kurs
            </span>
            <span class="text-xs text-amber-400/90 font-mono">
              SDLC • Core Skills Chain • Agenci AI
            </span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-bold text-white">
            {featuredCourse.title} — {featuredCourse.subtitle}
          </h2>

          <p class="mt-3 text-slate-300 text-sm sm:text-base leading-relaxed">
            {featuredCourse.description}
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a
              href={featuredCourse.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-base bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 hover:from-amber-400 hover:to-amber-500 transition-all shadow-lg shadow-amber-500/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300"
            >
              <span>Przejdź do oficjalnej strony kursu 10xDevs</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a
              href="/kursy"
              class="inline-flex items-center gap-1.5 px-4 py-3 rounded-xl font-semibold text-sm text-slate-300 hover:text-white hover:bg-slate-800 transition-colors"
            >
              <span>Zobacz wszystkie kursy</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Project Overview Section -->
  <section class="py-16 sm:py-20 border-b border-slate-800 bg-slate-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
        <div class="lg:col-span-2">
          <p class="text-xs font-bold uppercase tracking-widest text-amber-400">O projekcie</p>
          <h2 class="mt-2 text-2xl sm:text-4xl font-bold text-white tracking-tight">
            Dlaczego Przeprogramowani?
          </h2>
          <p class="mt-4 text-slate-300 leading-relaxed text-base sm:text-lg">
            {aboutBrand.mission}
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-6 text-sm text-slate-400">
            <div class="flex items-center gap-2">
              <span class="text-2xl font-bold text-amber-400">{aboutBrand.yearsOnMarket}</span>
              <span>doświadczenia na rynku</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-2xl font-bold text-sky-400">400+</span>
              <span>absolwentów programów</span>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 space-y-4">
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <span class="text-amber-400">★</span> Zaufali naszym szkoleniom:
          </h3>
          <div class="flex flex-wrap gap-2 text-xs font-medium text-slate-300">
            {aboutBrand.trustedBy.slice(0, 8).map((company) => (
              <span class="px-2.5 py-1 rounded-md bg-slate-800/80 border border-slate-700/50">
                {company}
              </span>
            ))}
          </div>
          <div class="pt-2">
            <a href="/o-nas" class="text-xs font-semibold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1">
              Poznaj twórców i wartości projektu <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sections Preview (Zapowiedzi pozostałych stron) -->
  <section class="py-16 sm:py-24 bg-slate-900/30 border-b border-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <p class="text-xs font-bold uppercase tracking-widest text-amber-400">Eksploruj serwis</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Poznaj wszystkie działy Przeprogramowanych
        </h2>
        <p class="mt-3 text-slate-400 text-sm sm:text-base">
          Przeglądaj podcasty technologiczne, filmy szkoleniowe na YouTube, sprawdzone kursy oraz sylwetki założycieli.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Card 1: O nas -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/80 p-6 hover:border-slate-700 hover:bg-slate-900 transition-all group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 text-xl font-bold mb-4 group-hover:scale-105 transition-transform">
              👥
            </div>
            <h3 class="text-xl font-bold text-white mb-2">O nas</h3>
            <p class="text-sm text-slate-300 leading-relaxed mb-6">
              Poznaj historię, misję oraz sylwetki założycieli: Przemka Smyrdka i Marcina Czarkowskiego.
            </p>
          </div>
          <a
            href="/o-nas"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-amber-400 hover:text-amber-300 group-hover:underline"
          >
            <span>Czytaj o zespole</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Card 2: Podcasty -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/80 p-6 hover:border-slate-700 hover:bg-slate-900 transition-all group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 text-xl font-bold mb-4 group-hover:scale-105 transition-transform">
              🎙️
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Podcasty</h3>
            <p class="text-sm text-slate-300 leading-relaxed mb-6">
              Dwa autorskie podcasty: <strong>Opanuj.AI</strong> o modelach i agentach oraz <strong>Przeprogramowani</strong> o karierze i architekturze.
            </p>
          </div>
          <a
            href="/podcast"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-sky-400 hover:text-sky-300 group-hover:underline"
          >
            <span>Katalog podcastów</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Card 3: YouTube -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/80 p-6 hover:border-slate-700 hover:bg-slate-900 transition-all group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400 text-xl font-bold mb-4 group-hover:scale-105 transition-transform">
              ▶️
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Kanał YouTube</h3>
            <p class="text-sm text-slate-300 leading-relaxed mb-6">
              Live sesje programistyczne, omówienia benchmarków AI, prezentacje Demo Day oraz analizy architektoniczne.
            </p>
          </div>
          <a
            href="/youtube"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-red-400 hover:text-red-300 group-hover:underline"
          >
            <span>Zobacz materiały wideo</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Card 4: Kursy -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900/80 p-6 hover:border-slate-700 hover:bg-slate-900 transition-all group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 text-xl font-bold mb-4 group-hover:scale-105 transition-transform">
              🎓
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Kursy i Szkolenia</h3>
            <p class="text-sm text-slate-300 leading-relaxed mb-6">
              Topowe programy edukacyjne: 10xDevs, Opanuj Frontend: AI Edition oraz Opanuj TypeScript z bezpośrednimi linkami.
            </p>
          </div>
          <a
            href="/kursy"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-400 hover:text-emerald-300 group-hover:underline"
          >
            <span>Przeglądaj ofertę</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Media Highlights on Homepage -->
  <section class="py-16 sm:py-20 bg-slate-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-amber-400">Najnowsze materiały</p>
          <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-white">
            Świeże publikacje ze świata technologii i AI
          </h2>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <a href="/podcast" class="text-amber-400 hover:underline">Wszystkie podcasty →</a>
          <span>•</span>
          <a href="/youtube" class="text-amber-400 hover:underline">Wszystkie filmy →</a>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Latest Podcast Highlight -->
        {latestPodcast && (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
              <span class="px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 font-medium">
                🎙️ Najnowszy odcinek podcastu Opanuj.AI
              </span>
              <time datetime={latestPodcast.publishedAt}>
                {latestPodcast.publishedDateDisplay}
              </time>
            </div>
            <h3 class="text-lg font-bold text-white mb-3">
              <a href={latestPodcast.url} target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors">
                {latestPodcast.title}
              </a>
            </h3>
            {latestPodcast.description && (
              <p class="text-sm text-slate-300 line-clamp-2 mb-4 leading-relaxed">
                {latestPodcast.description}
              </p>
            )}
            {latestPodcast.audioUrl && (
              <div class="mt-4 mb-4">
                <audio controls preload="none" class="w-full h-10 rounded">
                  <source src={latestPodcast.audioUrl} type="audio/mpeg" />
                </audio>
              </div>
            )}
            <div class="flex items-center justify-between text-xs pt-2 border-t border-slate-800">
              <a href="/podcast/opanuj-ai" class="text-amber-400 hover:underline font-semibold">
                Więcej odcinków Opanuj.AI →
              </a>
              <a href={latestPodcast.url} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white">
                Otwórz na Spotify ↗
              </a>
            </div>
          </div>
        )}

        <!-- Latest YouTube Highlight -->
        {latestVideo && (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-3">
                <span class="px-2.5 py-1 rounded-full bg-red-950/70 text-red-300 font-medium border border-red-800/40">
                  ▶️ Najnowszy film YouTube
                </span>
                <time datetime={latestVideo.publishedAt}>
                  {latestVideo.publishedDateDisplay}
                </time>
              </div>
              <h3 class="text-lg font-bold text-white mb-3">
                <a href={latestVideo.url} target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors">
                  {latestVideo.title}
                </a>
              </h3>
              {latestVideo.description && (
                <p class="text-sm text-slate-300 line-clamp-3 mb-4 leading-relaxed">
                  {latestVideo.description}
                </p>
              )}
            </div>
            <div class="flex items-center justify-between text-xs pt-4 border-t border-slate-800">
              <a href="/youtube" class="text-amber-400 hover:underline font-semibold">
                Oglądaj filmy na podstronie YouTube →
              </a>
              <a href={latestVideo.url} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white">
                Obejrzyj na YouTube ↗
              </a>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
