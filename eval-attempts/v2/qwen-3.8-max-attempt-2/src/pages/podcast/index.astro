---
import Base from '../../layouts/Base.astro';
import { SOURCES } from '../../data/sources';

const podcasts = [
  {
    href: '/podcast/opanuj-ai',
    title: 'Opanuj.AI Podcast',
    meta: 'Ponad 4000 słuchaczy',
    text: 'Comiesięczne podsumowanie najważniejszych wydarzeń ze świata AI. Twórca: Marcin Czarkowski — najpopularniejszy techniczny podcast o LLM w Polsce.',
    directories: SOURCES['opanuj-ai'].directories,
  },
  {
    href: '/podcast/przeprogramowani',
    title: 'Przeprogramowani ft. Gość',
    meta: 'Ponad 3800 słuchaczy',
    text: 'Rozmowy dla głodnych wiedzy — wywiady z gośćmi o frontendzie, TypeScript, karierze programisty i rozwoju zawodowym.',
    directories: SOURCES['przeprogramowani-podcast'].directories,
  },
];
---

<Base
  title="Podcasty — Opanuj.AI i Przeprogramowani | Przeprogramowani"
  description="Katalog podcastów Przeprogramowanych: Opanuj.AI Podcast o świecie AI i LLM oraz Przeprogramowani ft. Gość — rozmowy dla głodnych wiedzy. Najnowsze odcinki z odtwarzaczem i linkami."
  path="/podcast"
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <nav aria-label="Ścieżka okruszków" class="text-sm text-slate-500">
      <a href="/" class="hover:text-slate-300">Strona główna</a> <span aria-hidden="true">/</span> <span class="text-slate-300">Podcasty</span>
    </nav>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white">Podcasty</h1>
    <p class="mt-3 max-w-3xl text-lg text-slate-300">
      Słuchaj naszych podcastów o technologii, AI i programowaniu. Każdy katalog zawiera
      najnowsze odcinki z odtwarzaczem audio oraz linki do oryginałów u dostawcy.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {podcasts.map((p) => (
        <article class="flex flex-col rounded-xl border border-slate-800 bg-slate-900/60 p-6">
          <p class="font-mono text-xs font-semibold uppercase tracking-wider text-brand-300">{p.meta}</p>
          <h2 class="mt-2 text-2xl font-bold text-white">{p.title}</h2>
          <p class="mt-3 flex-1 text-sm text-slate-300">{p.text}</p>
          <div class="mt-5">
            <a href={p.href} class="inline-block rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-500">
              Zobacz odcinki →
            </a>
          </div>
          <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
            {p.directories.map((d) => (
              <li>
                <a href={d.url} class="underline hover:text-slate-300" target="_blank" rel="noopener noreferrer">
                  {d.label}<span class="sr-only"> — katalog zewnętrzny podcastu {p.title} (otwiera się w nowej karcie)</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</Base>
