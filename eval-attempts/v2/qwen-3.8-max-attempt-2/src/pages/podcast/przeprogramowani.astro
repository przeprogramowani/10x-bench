---
import Base from '../../layouts/Base.astro';
import SourceNotice from '../../components/SourceNotice.astro';
import AudioPlayer from '../../components/AudioPlayer';
import { loadSource } from '../../data/loader';
import { SOURCES } from '../../data/sources';
import { formatDate } from '../../utils/format';

const result = await loadSource('przeprogramowani-podcast');
const source = SOURCES['przeprogramowani-podcast'];
---

<Base
  title="Podcast Przeprogramowani — odcinki | Przeprogramowani"
  description="Podcast Przeprogramowani ft. Gość: rozmowy dla głodnych wiedzy o frontendzie, TypeScripcie, architekturze i karierze programisty. Najnowsze odcinki z odtwarzaczem i linkami."
  path="/podcast/przeprogramowani"
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <nav aria-label="Ścieżka okruszków" class="text-sm text-slate-500">
      <a href="/" class="hover:text-slate-300">Strona główna</a> <span aria-hidden="true">/</span>
      <a href="/podcast" class="hover:text-slate-300">Podcasty</a> <span aria-hidden="true">/</span>
      <span class="text-slate-300">Przeprogramowani</span>
    </nav>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white">Przeprogramowani ft. Gość</h1>
    <p class="mt-3 max-w-3xl text-lg text-slate-300">
      Rozmowy dla głodnych wiedzy — ponad 3800 słuchaczy. Wywiady z gośćmi o nowoczesnym
      frontendzie, TypeScripcie, architekturze aplikacji, no-code/low-code oraz o dojrzewaniu
      zawodowym programisty.
    </p>
    <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-400">
      {source.directories.map((d) => (
        <li>
          <a href={d.url} class="text-brand-300 underline hover:text-brand-200" target="_blank" rel="noopener noreferrer">
            {d.label}<span class="sr-only"> — katalog podcastu (otwiera się w nowej karcie)</span>
          </a>
        </li>
      ))}
    </ul>

    <section aria-labelledby="episodes-heading" class="mt-10">
      <h2 id="episodes-heading" class="text-2xl font-bold text-white">Najnowsze odcinki</h2>
      <div class="mt-4">
        <SourceNotice result={result} />
      </div>
      {result.items.length > 0 ? (
        <ol class="space-y-5">
          {result.items.map((item) => (
            <li>
              <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-6">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                  <span>{item.sourceName}</span>
                  <span aria-hidden="true">•</span>
                  <time datetime={item.publishedAt ?? undefined}>{formatDate(item.publishedAt)}</time>
                </div>
                <h3 class="mt-2 text-lg font-semibold text-white">{item.title}</h3>
                {item.description && <p class="mt-2 text-sm text-slate-400">{item.description}</p>}
                <div class="mt-4">
                  <AudioPlayer client:load src={item.enclosureUrl} title={item.title} episodeUrl={item.url} />
                </div>
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <p class="text-slate-400">Brak odcinków do wyświetlenia.</p>
      )}
    </section>
  </div>
</Base>
