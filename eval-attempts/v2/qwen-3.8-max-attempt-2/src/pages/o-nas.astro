---
import Base from '../layouts/Base.astro';
import { FOUNDERS } from '../data/sources';

const values = [
  {
    title: 'Szersze spojrzenie',
    text: 'Najlepsi programiści patrzą szerzej — na architekturę, biznes, ludzi i na siebie. Programowanie łączy się tu z rozwojem osobistym.',
  },
  {
    title: 'Wiedza oparta na praktyce',
    text: 'Treści, kursy i narzędzia powstają z realnego doświadczenia inżynierskiego: od technicznych deep-dive’ów po rozmowy o karierze.',
  },
  {
    title: 'Edukacja w epoce AI',
    text: 'Świadome korzystanie z potencjału generatywnego AI w całym cyklu wytwarzania oprogramowania — bez rezygnowania z inżynierskiego rzemiosła.',
  },
];
---

<Base
  title="O nas — Przemek Smyrdek i Marcin Czarkowski | Przeprogramowani"
  description="Przeprogramowani łączą świat programowania, biznesu i rozwoju. Poznaj wartości projektu oraz sylwetki założycieli: Przemka Smyrdka i Marcina Czarkowskiego."
  path="/o-nas"
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <nav aria-label="Ścieżka okruszków" class="text-sm text-slate-500">
      <a href="/" class="hover:text-slate-300">Strona główna</a> <span aria-hidden="true">/</span> <span class="text-slate-300">O nas</span>
    </nav>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white">O nas</h1>
    <p class="mt-3 max-w-3xl text-lg text-slate-300">Łączymy świat programowania, biznesu i rozwoju</p>

    <section aria-labelledby="about-heading" class="mt-10 max-w-3xl">
      <h2 id="about-heading" class="text-2xl font-bold text-white">Witaj na Przeprogramowanych!</h2>
      <p class="mt-4 text-slate-300">
        Przeprogramowani to miejsce, w którym programowanie spotyka się z rozwojem osobistym.
        Wierzymy, że najlepsi programiści to ci, którzy patrzą szerzej — na architekturę,
        na biznes, na ludzi i na siebie. Tworzymy treści, kursy i narzędzia, które pomagają
        programistom rozwijać się na wielu płaszczyznach — od technicznych deep-dive'ów
        po rozmowy o karierze i rozwoju. Zyskaj szersze spojrzenie na programowanie.
      </p>
      <p class="mt-4 text-slate-300">
        Działamy od ponad 7 lat na rynku edukacji technologicznej. Prowadzimy kursy
        (<a class="text-brand-300 underline hover:text-brand-200" href="/kursy">10xDevs, Opanuj Frontend, Opanuj TypeScript</a>),
        dwa <a class="text-brand-300 underline hover:text-brand-200" href="/podcast">podcasty</a>
        oraz oficjalny <a class="text-brand-300 underline hover:text-brand-200" href="/youtube">kanał YouTube</a>.
        Współpraca: <a class="text-brand-300 underline hover:text-brand-200" href="mailto:kontakt@przeprogramowani.pl">kontakt@przeprogramowani.pl</a>.
      </p>
    </section>

    <section aria-labelledby="values-heading" class="mt-12">
      <h2 id="values-heading" class="text-2xl font-bold text-white">Wartości</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {values.map((v) => (
          <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-6">
            <h3 class="text-lg font-semibold text-white">{v.title}</h3>
            <p class="mt-2 text-sm text-slate-400">{v.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="founders-heading" class="mt-12">
      <h2 id="founders-heading" class="text-2xl font-bold text-white">Założyciele</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {FOUNDERS.map((f) => (
          <article class="rounded-xl border border-slate-800 bg-slate-900/60 p-6">
            <div class="flex items-center gap-4">
              <span aria-hidden="true" class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-600/20 font-mono text-lg font-bold text-brand-300">
                {f.name.split(' ').map((n) => n[0]).join('')}
              </span>
              <div>
                <h3 class="text-lg font-semibold text-white">{f.name}</h3>
                <p class="text-sm text-brand-300">{f.role}</p>
              </div>
            </div>
            <p class="mt-4 text-sm text-slate-300">{f.bio}</p>
            <a href={f.linkedin} class="mt-4 inline-block text-sm font-semibold text-brand-300 underline hover:text-brand-200" target="_blank" rel="noopener noreferrer">
              Profil LinkedIn<span class="sr-only"> — {f.name} (otwiera się w nowej karcie)</span> →
            </a>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>
