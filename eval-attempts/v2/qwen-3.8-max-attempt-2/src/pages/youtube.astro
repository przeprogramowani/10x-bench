---
import Base from '../layouts/Base.astro';
import SourceNotice from '../components/SourceNotice.astro';
import { loadSource } from '../data/loader';
import { SOURCES } from '../data/sources';
import { formatDate } from '../utils/format';

const result = await loadSource('youtube');
const source = SOURCES.youtube;

function embedUrl(itemUrl: string, id: string): string {
  return `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}`;
}
---

<Base
  title="YouTube — najnowsze filmy kanału Przeprogramowani"
  description="Najnowsze filmy oficjalnego kanału YouTube Przeprogramowani: transmisje LIVE, relacje z konferencji i materiały o programowaniu z AI. Odtwarzanie na stronie i linki do oryginałów."
  path="/youtube"
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <nav aria-label="Ścieżka okruszków" class="text-sm text-slate-500">
      <a href="/" class="hover:text-slate-300">Strona główna</a> <span aria-hidden="true">/</span> <span class="text-slate-300">YouTube</span>
    </nav>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-white">YouTube</h1>
    <p class="mt-3 max-w-3xl text-lg text-slate-300">
      Najnowsze filmy oficjalnego kanału Przeprogramowani — development z AI, relacje
      z konferencji i hackathonów oraz transmisje LIVE. Filmy odtworzysz bezpośrednio
      na stronie; każdy ma też link do oryginału w serwisie YouTube.
    </p>
    <p class="mt-4 text-sm">
      <a href={source.homeUrl} class="font-semibold text-brand-300 underline hover:text-brand-200" target="_blank" rel="noopener noreferrer">
        Kanał Przeprogramowani na YouTube<span class="sr-only"> (otwiera się w nowej karcie)</span> →
      </a>
    </p>

    <section aria-labelledby="videos-heading" class="mt-10">
      <h2 id="videos-heading" class="text-2xl font-bold text-white">Najnowsze filmy</h2>
      <div class="mt-4">
        <SourceNotice result={result} />
      </div>
      {result.items.length > 0 ? (
        <ol class="grid gap-6 lg:grid-cols-2">
          {result.items.map((item) => (
            <li>
              <article class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-800 bg-slate-900/60">
                <div class="relative w-full" style="padding-top: 56.25%">
                  <iframe
                    class="absolute inset-0 h-full w-full"
                    src={embedUrl(item.url, item.id)}
                    title={item.title}
                    loading="lazy"
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    referrerpolicy="strict-origin-when-cross-origin"
                  ></iframe>
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                    <span>{item.sourceName}</span>
                    <span aria-hidden="true">•</span>
                    <time datetime={item.publishedAt ?? undefined}>{formatDate(item.publishedAt)}</time>
                  </div>
                  <h3 class="mt-2 text-base font-semibold text-white">{item.title}</h3>
                  {item.description && <p class="mt-2 flex-1 text-sm text-slate-400">{item.description}</p>}
                  <a href={item.url} class="mt-4 text-sm font-semibold text-brand-300 underline hover:text-brand-200" target="_blank" rel="noopener noreferrer">
                    Otwórz film na YouTube<span class="sr-only"> — {item.title} (otwiera się w nowej karcie)</span> →
                  </a>
                </div>
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <p class="text-slate-400">Brak filmów do wyświetlenia.</p>
      )}
    </section>
  </div>
</Base>
