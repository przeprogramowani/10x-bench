---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
const people = [
  { name: 'Przemek Smyrdek', image: 'przemek.webp', subtitle: 'Engineering, produkty i szeroka perspektywa.', bio: 'Autor programów szkoleniowych, kursów i podcastów. Zdobywał doświadczenie jako Lead Engineer i Manager w DAZN i Cabify. Tworzył aplikacje full-stack z wykorzystaniem .NET, Javy, Node.js, Angulara i TypeScriptu.', extra: 'Dzieli się wiedzą na 4Developers, ReactiveConf i InfoShare. Współtworzy projekty Open Source, m.in. CursorLens i openapi-typescript.', linkedin: 'https://www.linkedin.com/in/psmyrdek/' },
  { name: 'Marcin Czarkowski', image: 'marcin.webp', subtitle: 'Frontend, AI i nauka, która zostaje.', bio: 'Lead techniczny Platformy Frontendowej w SmartRecruiters. Od ponad 10 lat tworzy rozwiązania oparte na TypeScripcie, React i Node.js. W edukacji łączy praktykę inżynierską z zainteresowaniem neuronauką i tym, jak skutecznie się uczymy.', extra: 'Twórca Opanuj.AI Podcast. Lubi przyglądać się nowym technologiom przez pryzmat ich rzeczywistej wartości dla ludzi i biznesu.', linkedin: 'https://www.linkedin.com/in/mkczarkowski/' },
];
---
<Layout title="O nas — Przeprogramowani" description="Poznaj Przemka Smyrdka i Marcina Czarkowskiego. Łączymy programowanie, biznes i rozwój, tworząc praktyczne kursy, podcasty i materiały dla developerów.">
  <section class="page-hero container"><a class="breadcrumb" href="/">Przeprogramowani <span>/</span></a><span class="eyebrow"><span class="status-dot"></span> POZNAJMY SIĘ</span><h1>Za kodem<br />zawsze stoją <span class="highlight-text">ludzie.</span></h1><p>Łączymy świat programowania, biznesu i rozwoju.<br class="desktop-break"/> I od lat dzielimy się tym, czego sami się uczymy.</p></section>
  <section class="founders-section container">{people.map((person, i) => <article class="founder-card"><div class:list={['founder-photo', { 'founder-photo-green': i === 1 }]}><span class="eyebrow">CO-FOUNDER / PRZEPROGRAMOWANI</span><img src={`/images/${person.image}`} alt={person.name} width="600" height="600"/><span class="founder-photo-index">0{i + 1}</span></div><div class="founder-bio"><h2>{person.name}</h2><span class="founder-subtitle">{person.subtitle}</span><p>{person.bio}</p><p>{person.extra}</p><a href={person.linkedin} class="text-link">Poznaj mnie na LinkedIn <Icon name="arrow" size={18}/></a></div></article>)}</section>
  <section class="manifesto-section"><div class="container manifesto-grid"><div><span class="eyebrow">NASZA PERSPEKTYWA</span><h2>Więcej niż<br/>kolejna linia kodu<span class="lime">.</span></h2></div><div><p>Warsztat techniczny to fundament. Ale najlepsze rozwiązania powstają, gdy rozumiesz też ludzi, architekturę i cele biznesowe.</p><p>Dlatego tworzymy kursy z praktycznymi zadaniami, rozmawiamy z ludźmi z branży i sprawdzamy nowe narzędzia w rzeczywistych projektach. Chcemy, żeby wiedza przekładała się na to, co potrafisz zbudować.</p><a href="/kursy" class="button button-lime">Odkryj nasze kursy <Icon name="arrow"/></a></div></div></section>
  <Newsletter />
</Layout>
