---
import Icon from './Icon.astro';
---
<a href="https://10xdevs.pl" class="hero-visual" aria-label="Poznaj program 10xDevs — AI-Native Software Engineering">
  <div class="visual-top"><span class="visual-label"><span class="status-dot"></span> AI-NATIVE SOFTWARE ENGINEERING</span><span class="visual-edition">4.0</span></div>
  <div class="orbital-art" aria-hidden="true">
    <div class="orbital-grid"></div>
    <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div>
    <div class="orbit-core"><span>10<span class="x-mark">x</span></span></div>
    <span class="orbit-node node-one"><Icon name="code" size={22}/></span><span class="orbit-node node-two"><Icon name="spark" size={21}/></span>
    <span class="orbit-caption caption-one">human creativity</span><span class="orbit-caption caption-two">× AI potential</span>
    <span class="art-cross cross-one">+</span><span class="art-cross cross-two">+</span>
  </div>
  <div class="visual-bottom"><div><h2>10xDevs<span class="lime">.</span></h2><p>Twój następny krok w erze AI.</p></div><span class="visual-arrow"><Icon name="arrow" size={27}/></span></div>
  <div class="visual-foot"><span>OD POMYSŁU DO PRODUKCJI</span><span>POZNAJ PROGRAM <Icon name="right" size={15}/></span></div>
</a>
