---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatsBar from '../components/StatsBar.astro';
import CourseCard from '../components/CourseCard';
import EpisodeCard from '../components/EpisodeCard';
import VideoCard from '../components/VideoCard';
import BrandMarquee from '../components/BrandMarquee';
import { courses } from '../data/courses';
import { stats, brands, site } from '../data/site';
import { podcastShows } from '../data/podcast';
import { videos } from '../data/youtube';

const aiPodcast = podcastShows[0];
const latestEpisodes = aiPodcast.episodes.slice(0, 2);
const latestVideos = videos.slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden pt-16">
    <div class="bg-grid absolute inset-0" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-x-0 top-0 blur-3xl"
      aria-hidden="true"
      style="height: 500px; background: radial-gradient(60% 50% at 50% 0%, rgba(249,115,22,0.14) 0%, transparent 70%);"
    >
    </div>

    <div class="container-site relative py-20 sm:py-28">
      <div class="mx-auto max-w-3xl text-center">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-zinc-700/80 bg-zinc-900/70 px-4 py-1.5 text-xs font-medium text-zinc-300 backdrop-blur"
        >
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-500"></span>
          </span>
          Edukacja technologiczna w epoce AI
        </span>

        <h1
          class="mt-6 font-display text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-6xl"
        >
          Szersze spojrzenie
          <br />
          na <span class="text-gradient">programowanie</span>
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-zinc-400 sm:text-lg">
          Przeprogramowani to miejsce, w którym programowanie spotyka się z rozwojem osobistym.
          Tworzymy treści, kursy i narzędzia, które pomagają programistom rozwijać się na wielu
          płaszczyznach.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="#kursy" class="btn-primary">
            Poznaj nasze kursy
            <span aria-hidden>↓</span>
          </a>
          <a href="/podcast" class="btn-ghost">Posłuchaj podcastu</a>
        </div>
      </div>

      <!-- Kursy w hero -->
      <div id="kursy" class="mt-16 scroll-mt-24 sm:mt-20">
        <div class="mb-8 text-center">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-400">
            Nasze programy edukacyjne
          </p>
          <p class="mt-2 text-sm text-zinc-500">
            Topowe programy dla ambitnych programistów i świadome korzystanie z potencjału
            Generative AI
          </p>
        </div>

        <div class="grid gap-6 pt-3 md:grid-cols-3">
          {courses.map((course) => <CourseCard client:load course={course} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Statystyki -->
  <section class="container-site py-14">
    <StatsBar stats={stats} />
  </section>

  <!-- Podcast teaser -->
  <section class="border-y border-zinc-800/80 bg-zinc-900/30 py-20">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading
          eyebrow="🎧 Podcast"
          title="Najnowsze odcinki"
          text="Comiesięczne podsumowania świata AI oraz rozmowy z gośćmi — ponad 7800 słuchaczy."
        />
        <a href="/podcast" class="btn-ghost shrink-0">
          Wszystkie odcinki
          <span aria-hidden>→</span>
        </a>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {
          latestEpisodes.map((episode) => (
            <EpisodeCard
              client:load
              episode={episode}
              cover={aiPodcast.cover}
              accent={aiPodcast.accent}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- YouTube teaser -->
  <section class="container-site py-20">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="▶ YouTube"
        title="Ostatnie filmy"
        text="Rozwój nowoczesnego programisty — materiały o frontendzie, AI i karierze."
      />
      <a href="/youtube" class="btn-ghost shrink-0">
        Wszystkie filmy
        <span aria-hidden>→</span>
      </a>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {latestVideos.map((video) => <VideoCard client:load video={video} />)}
    </div>
  </section>

  <!-- Zaufali nam -->
  <section class="border-y border-zinc-800/80 bg-zinc-900/30 py-14">
    <div class="container-site">
      <p class="text-center text-sm font-semibold uppercase tracking-widest text-zinc-500">
        Zaufali nam
      </p>
      <div class="mt-8">
        <BrandMarquee client:load brands={brands} />
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="container-site py-20">
    <div
      class="relative overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900/60 px-6 py-16 text-center sm:px-16"
    >
      <div
        class="pointer-events-none absolute inset-0 blur-3xl"
        aria-hidden="true"
        style="background: radial-gradient(50% 60% at 50% 100%, rgba(249,115,22,0.12) 0%, transparent 70%);"
      >
      </div>
      <div class="relative mx-auto max-w-2xl">
        <span class="font-mono text-sm font-semibold text-brand-400">3-2-1</span>
        <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Przeprogramowany Newsletter
        </h2>
        <p class="mt-4 text-base leading-relaxed text-zinc-400">
          Co tydzień w piątek otrzymaj porcję wartościowych treści: 3 rekomendacje techniczne,
          2 rekomendacje rozwojowe i 1 bonus niespodzianka.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href={site.newsletter} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Zapisz się za darmo
            <span aria-hidden>→</span>
          </a>
          <a href="/o-nas" class="btn-ghost">Poznaj nas bliżej</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
