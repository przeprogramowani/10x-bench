---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, text, align = 'left' } = Astro.props;
---

<div class={align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl'}>
  {
    eyebrow && (
      <span class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-brand-400">
        {eyebrow}
      </span>
    )
  }
  <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
    {title}
  </h2>
  {text && <p class="mt-4 text-base leading-relaxed text-zinc-400">{text}</p>}
</div>
