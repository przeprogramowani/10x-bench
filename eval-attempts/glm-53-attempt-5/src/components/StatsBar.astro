---
interface Props {
  stats: { value: string; suffix: string; label: string }[];
}

const { stats } = Astro.props;
---

<div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-800/60 lg:grid-cols-4">
  {
    stats.map((stat) => (
      <div class="bg-zinc-900/80 px-6 py-8 text-center">
        <p class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
          {stat.value}
          {stat.suffix && <span class="text-brand-400"> {stat.suffix}</span>}
        </p>
        <p class="mt-2 text-xs leading-snug text-zinc-500 sm:text-sm">{stat.label}</p>
      </div>
    ))
  }
</div>
