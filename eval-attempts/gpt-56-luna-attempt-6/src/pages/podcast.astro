---
import BaseLayout from '../layouts/BaseLayout.astro';

const aiEpisodes = [
  { title: 'BAN NA AI?! USA BLOKUJE ANTHROPICA i OPEN AI', description: 'Czy najlepsze modele AI właśnie przestały być zwykłym produktem, a stały się technologią kontrolowaną przez państwo?', time: '01:21:53', link: 'https://podcasters.spotify.com/pod/show/opanujai/episodes/BAN-NA-AI---USA-BLOKUJE-ANTHROPICA-i-OPEN-AI-Claude-Mythos--Claude-Fable-i-GPT-5-6-e3lfs2p' },
  { title: 'Byliśmy na Google I/O 2026 — wrażenia na gorąco!', description: 'Relacja z konferencji, która była jedną wielką niewiadomą, ale też źródłem wielu ważnych pytań o przyszłość AI.', time: '01:12:26', link: 'https://podcasters.spotify.com/pod/show/opanujai/episodes/Bylimy-na-Google-IO-2026---wraenia-na-gorco---Opanuj-AI-LIVE---Maj-2026-e3k9b7u' },
  { title: 'GPT-5.5 VS Opus 4.7 — kto rządzi na scenie AI?', description: 'GPT-5.5, Claude Opus 4.7, DeepSeek V4, Cursor 3.0 i Meta Muse. Co naprawdę zmieniło się w ostatnich miesiącach?', time: '00:47:22', link: 'https://podcasters.spotify.com/pod/show/opanujai/episodes/GPT-5-5-VS-Opus-4-7---kto-rzdzi-na-scenie-AI---Cursor-3-0--DeepSeek-V4--Meta-Muse-e3injdh' },
  { title: 'Programowanie w epoce AI z Claude Code, Cursorem i Copilotem', description: 'Dawid Sibiński dzieli się doświadczeniami z pracy z narzędziami wspierającymi programowanie.', time: '01:28:30', link: 'https://podcasters.spotify.com/pod/show/opanujai/episodes/Programowanie-w-epoce-AI-z-Claude-Code--Cursorem-i-Copilotem---Go-Dawid-Sibiski-e3gmm83' },
];

const guestEpisodes = [
  ['Programista vs. Angielski: Od strachu do sukcesu', 'Wiktoria Sitko', '00:33:45'],
  ['O dojrzewaniu zawodowym programisty', 'Wojciech Trawiński', '00:45:56'],
  ['Architektura frontendu: Co naprawdę ma znaczenie?', 'Tomasz Ducin', '01:16:44'],
  ['No-code i Low-code — przyszłość tworzenia aplikacji?', 'Kamil Tarczyński', '00:36:31'],
];
---

<BaseLayout currentPath="/podcast" title="Podcast — Przeprogramowani" description="Podcasty o technologii, AI, programowaniu i rozwoju zawodowym.">
  <main>
    <section class="relative overflow-hidden bg-orange py-24 md:py-32"><div class="absolute -right-16 -top-24 h-[420px] w-[420px] rounded-full border border-black/20 shadow-[0_0_0_35px_rgba(21,23,25,.06),0_0_0_90px_rgba(21,23,25,.04)]"></div><div class="container-wide relative"><p class="eyebrow">Podcast / 01</p><h1 class="display mt-7 max-w-[800px] text-6xl leading-[.88] md:text-8xl">Myślenie<br />na głos<span class="text-white">.</span></h1><div class="mt-10 flex flex-wrap items-end justify-between gap-8"><p class="max-w-[480px] text-lg leading-7 text-black/65">Słuchaj naszych podcastów o technologii, AI i programowaniu. Długie rozmowy, konkretne idee, zero pozy.</p><div class="text-right"><span class="display text-6xl font-semibold">4k<span class="text-white">+</span></span><p class="text-sm text-black/55">słuchaczy Opanuj.AI</p></div></div></div></section>

    <section class="section-pad"><div class="container-wide"><div class="mb-12 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="section-label eyebrow">Seria / Opanuj.AI</p><h2 class="display heading-lg mt-5">Technologia<br /><span class="text-orange">bez skrótów.</span></h2></div><a class="button-outline" href="https://open.spotify.com/show/4qHUZJpeBK8Ij9e2wTVm2o" target="_blank" rel="noreferrer">Otwórz w Spotify ↗</a></div><div class="grid gap-5 md:grid-cols-2">{aiEpisodes.map((episode, index) => <a class="group border hairline bg-white p-6 transition hover:-translate-y-1 hover:shadow-[7px_8px_0_#ff5b36]" href={episode.link} target="_blank" rel="noreferrer"><div class="flex items-start justify-between gap-5"><span class="display text-5xl font-semibold text-orange/30">0{index + 1}</span><span class="border border-black/15 px-3 py-1 text-[.68rem] font-bold">{episode.time}</span></div><h3 class="display mt-12 text-2xl leading-tight">{episode.title}</h3><p class="mt-4 text-sm leading-6 text-black/55">{episode.description}</p><span class="mt-7 inline-block text-sm font-bold">Słuchaj odcinka <span class="text-orange transition group-hover:ml-2">↗</span></span></a>)}</div></div></section>

    <section class="section-pad border-y hairline bg-paper-deep"><div class="container-wide grid gap-14 lg:grid-cols-[.72fr_1.28fr]"><div><p class="section-label eyebrow">Seria / Gość</p><h2 class="display heading-lg mt-5">Rozmowy<br />dla głodnych<br /><span class="text-orange">wiedzy.</span></h2><p class="mt-7 max-w-[340px] text-base leading-7 text-black/60">Ludzie, którzy robią ciekawe rzeczy. Ich decyzje, potknięcia i lekcje, których nie znajdziesz w dokumentacji.</p></div><div>{guestEpisodes.map((episode, index) => <a class="episode-row" href="https://podcasters.spotify.com/pod/show/przeprogramowani" target="_blank" rel="noreferrer"><span class="episode-number">0{index + 1}</span><span><span class="episode-title block">{episode[0]}</span><span class="mt-2 block text-sm text-black/50">{episode[1]}</span></span><span class="episode-time text-right text-xs text-black/45">{episode[2]}<br /><span class="text-orange">Odtwórz ↗</span></span></a>)}</div></div></section>

    <section class="section-pad"><div class="container-wide"><div class="flex flex-col items-start justify-between gap-7 border-b hairline pb-10 md:flex-row md:items-end"><div><p class="section-label eyebrow">Wybierz platformę</p><h2 class="display mt-5 text-4xl">Słuchaj, gdzie Ci wygodnie.</h2></div><p class="max-w-[300px] text-sm leading-6 text-black/55">Nowe odcinki pojawiają się również w formacie wideo na naszym kanale YouTube.</p></div><div class="grid gap-4 pt-8 sm:grid-cols-2 lg:grid-cols-4"><a class="border hairline p-6 transition hover:border-orange hover:bg-orange" href="https://open.spotify.com/show/4qHUZJpeBK8Ij9e2wTVm2o" target="_blank" rel="noreferrer"><span class="text-2xl">●</span><p class="mt-10 font-bold">Spotify</p><span class="mt-2 block text-xs text-black/50">Słuchaj teraz ↗</span></a><a class="border hairline p-6 transition hover:border-orange hover:bg-orange" href="https://podcasts.apple.com/pl/podcast/przeprogramowani/id1508387250" target="_blank" rel="noreferrer"><span class="text-2xl">◉</span><p class="mt-10 font-bold">Apple Podcasts</p><span class="mt-2 block text-xs text-black/50">Słuchaj teraz ↗</span></a><a class="border hairline p-6 transition hover:border-orange hover:bg-orange" href="https://www.youtube.com/@przeprogramowani" target="_blank" rel="noreferrer"><span class="text-2xl">▷</span><p class="mt-10 font-bold">YouTube</p><span class="mt-2 block text-xs text-black/50">Oglądaj teraz ↗</span></a><a class="border hairline p-6 transition hover:border-orange hover:bg-orange" href="https://anchor.fm/s/22544b7c/podcast/rss" target="_blank" rel="noreferrer"><span class="text-2xl">◌</span><p class="mt-10 font-bold">RSS</p><span class="mt-2 block text-xs text-black/50">Dodaj do czytnika ↗</span></a></div></div></section>
  </main>
</BaseLayout>
