---
import Layout from "../layouts/Layout.astro";
import { latestVideos } from "../data/content";

const moreVideos = [
  { title: "MVP w Claude Code - Context Engineering, kontrola Agenta i refaktoryzacja", id: "Vce4cD_5XW0", duration: "11:52", age: "4 miesiące temu" },
  { title: "Topowe AI do budowania stron? Mamy wyniki naszego benchmarku!", id: "UsdbrG_pRIA", duration: "10:48", age: "4 miesiące temu" },
  { title: "Skills vs AgentsMD: 53% vs 100%. Co poszło nie tak?", id: "_kQHwE6zAbM", duration: "11:37", age: "5 miesięcy temu" },
];
---

<Layout title="YouTube | Przeprogramowani" description="Najnowsze filmy Przeprogramowani o AI, programowaniu i rozwoju.">
  <section class="border-b border-white/10">
    <div class="mx-auto grid max-w-[1440px] gap-10 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-[1fr_.85fr] lg:items-end lg:px-12">
      <div><p class="eyebrow">Przeprogramowani / YouTube</p><h1 class="display mt-6 text-[clamp(3.7rem,8vw,8rem)] font-bold leading-[0.82]">Patrz<br /><span class="text-[#c7ff3d]">szerzej.</span></h1><p class="mt-8 max-w-xl text-base leading-7 text-[#b6b7b0]">Kanał dla programistów, którzy stawiają na własny rozwój. Nowości z IT, techniki pracy i decyzje, które budują dobrą karierę.</p></div>
      <div class="border-l border-[#c7ff3d] pl-6 sm:pl-8"><p class="display text-5xl font-bold sm:text-6xl">20,5 tys.</p><p class="mt-2 text-sm font-bold text-[#a2a39c]">subskrybentów i 398 materiałów</p><a href="https://youtube.com/c/przeprogramowani/videos" class="mt-7 inline-flex bg-[#c7ff3d] px-5 py-3 text-sm font-extrabold text-[#101111]">Otwórz kanał ↗</a></div>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-20 md:px-8 md:py-28 lg:px-12"><div class="flex items-end justify-between border-b border-white/10 pb-8"><div><p class="eyebrow">Najnowsze materiały</p><h2 class="display mt-5 text-5xl font-bold leading-none sm:text-6xl">Właśnie opublikowane</h2></div><a href="https://youtube.com/c/przeprogramowani/videos" class="hidden border-b border-[#c7ff3d] pb-1 text-sm font-extrabold text-[#c7ff3d] sm:block">Wszystkie filmy →</a></div><div class="mt-9 grid gap-6 md:grid-cols-3">{latestVideos.map((video, index) => (<a href={`https://www.youtube.com/watch?v=${video.id}`} class={`group ${index === 0 ? "md:col-span-2" : ""}`}><div class={`relative overflow-hidden bg-[#1c1d1c] ${index === 0 ? "aspect-[16/8.5]" : "aspect-video"}`}><img src={`https://i.ytimg.com/vi/${video.id}/maxresdefault.jpg`} alt="" loading={index === 0 ? "eager" : "lazy"} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" /><span class="absolute bottom-3 right-3 bg-[#101111] px-2 py-1 text-xs font-bold">{video.duration}</span><span class="absolute left-4 top-4 grid h-10 w-10 place-items-center rounded-full bg-[#c7ff3d] text-xs text-[#101111] opacity-0 transition-opacity group-hover:opacity-100">▶</span></div><p class="mt-4 text-xs font-bold text-[#c7ff3d]">{video.age}</p><h3 class={`mt-2 font-extrabold leading-6 ${index === 0 ? "text-xl sm:text-2xl" : "text-base"}`}>{video.title}</h3><p class="mt-2 text-xs text-[#969790]">{video.views}</p></a>))}</div></section>

  <section class="border-t border-white/10 bg-[#151716]"><div class="mx-auto max-w-[1440px] px-5 py-20 md:px-8 md:py-28 lg:px-12"><p class="eyebrow">Więcej do odkrycia</p><div class="mt-8 grid gap-6 md:grid-cols-3">{moreVideos.map((video) => (<a href={`https://www.youtube.com/watch?v=${video.id}`} class="lift group border border-white/10 bg-[#101111] p-3"><div class="relative aspect-video overflow-hidden"><img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" /><span class="absolute bottom-2 right-2 bg-[#101111] px-1.5 py-1 text-[0.62rem] font-bold">{video.duration}</span></div><div class="p-2 pb-3"><p class="mt-3 text-xs text-[#969790]">{video.age}</p><h3 class="mt-2 text-sm font-extrabold leading-5">{video.title}</h3></div></a>))}</div></div></section>
</Layout>
