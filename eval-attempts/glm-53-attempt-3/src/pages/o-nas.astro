---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NewsletterForm from '../components/NewsletterForm';
import { founders, stats } from '../data/content';
import { ArrowRightIcon, CheckIcon, LinkedinIcon, MailIcon } from '../components/Icons';

const values = [
  {
    title: 'Szersza perspektywa',
    description: 'Najlepsi programiści to ci, którzy patrzą szerzej — na architekturę, na biznes, na ludzi i na siebie.',
  },
  {
    title: 'Praktyka ponad teorię',
    description: 'Tworzymy treści, kursy i narzędzia, które można od razu przenieść do codziennej pracy produkcyjnej.',
  },
  {
    title: 'Nauka oparta na badaniach',
    description: 'Materiały edukacyjne budujemy w oparciu o badania nad uczeniem się i efektywne przyswajanie wiedzy.',
  },
  {
    title: 'Świadome AI',
    description: 'Uczymy świadomego stosowania Generative AI w całym cyklu wytwarzania oprogramowania — bez hype’u.',
  },
];
---

<BaseLayout
  title="O nas"
  description="Poznaj Przemka i Marcina — założycieli Przeprogramowanych. Łączymy świat programowania, biznesu i rozwoju osobistego."
>
  <!-- Nagłówek strony -->
  <section class="relative overflow-hidden">
    <div class="hero-grid absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 pb-16 pt-20 sm:px-6 sm:pt-24">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-300">O nas</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl">
        Łączymy świat <span class="gradient-text">programowania, biznesu i rozwoju</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mist">
        Przeprogramowani to miejsce, w którym programowanie spotyka się z rozwojem osobistym. Od 7 lat tworzymy
        kursy, podcasty i narzędzia, które pomagają programistom rozwijać się na wielu płaszczyznach.
      </p>
    </div>
  </section>

  <!-- Założyciele -->
  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
    <div class="grid gap-6 lg:grid-cols-2">
      {
        founders.map((founder) => (
          <article class="flex flex-col rounded-3xl border border-white/10 bg-ink-card p-8 transition-colors hover:border-brand-400/30 sm:p-10">
            <div class="flex items-center gap-5">
              <span
                class={`inline-flex size-20 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br ${founder.gradient} text-2xl font-bold text-white shadow-lg`}
              >
                {founder.initials}
              </span>
              <div>
                <h2 class="text-xl font-bold text-white">{founder.name}</h2>
                <p class="mt-1 text-sm font-medium text-brand-300">{founder.role}</p>
              </div>
            </div>
            <div class="mt-6 flex-1 space-y-3">
              {founder.description.map((paragraph) => (
                <p class="text-sm leading-relaxed text-mist">{paragraph}</p>
              ))}
            </div>
            <a
              href={founder.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex w-fit items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:border-brand-400/50 hover:bg-white/10"
            >
              <LinkedinIcon className="size-4 text-brand-300" />
              LinkedIn
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Misja -->
  <section class="border-y border-white/5 bg-ink-soft py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <SectionHeading
        eyebrow="Witaj na Przeprogramowanych!"
        title={`Wierzymy, że <span class="gradient-text">najlepsi programiści patrzą szerzej</span>`}
        description="Na architekturę, na biznes, na ludzi i na siebie. Tworzymy treści, kursy i narzędzia — od technicznych deep-dive'ów po rozmowy o karierze i rozwoju."
      />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((value) => (
            <div class="rounded-2xl border border-white/10 bg-ink-card p-6 transition-colors hover:border-brand-400/30">
              <span class="inline-flex size-10 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500/20 to-accent-500/20 text-cyan-glow ring-1 ring-white/10">
                <CheckIcon className="size-5" />
              </span>
              <h3 class="mt-5 text-base font-semibold text-white">{value.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-mist">{value.description}</p>
            </div>
          ))
        }
      </div>

      <dl class="mt-16 grid grid-cols-2 gap-8 rounded-3xl border border-white/10 bg-ink-card px-6 py-10 text-center sm:grid-cols-4 sm:px-10">
        {
          stats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd class="text-3xl font-bold text-white sm:text-4xl">{stat.value}</dd>
              <dd class="mt-2 text-xs leading-snug text-mist">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-brand-600/15 via-accent-500/10 to-cyan-500/10 px-6 py-14 text-center sm:px-12">
        <div class="absolute -right-24 -top-24 size-72 rounded-full bg-accent-500/20 blur-[100px]" aria-hidden="true"></div>
        <h2 class="relative mx-auto max-w-xl text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Zyskaj <span class="gradient-text">szersze spojrzenie</span> na programowanie
        </h2>
        <p class="relative mx-auto mt-4 max-w-lg text-base leading-relaxed text-mist">
          Dołącz do newslettera i społeczności tysięcy programistów, którzy rozwijają się świadomie — także w epoce AI.
        </p>
        <div class="relative mt-8 flex justify-center">
          <NewsletterForm client:visible />
        </div>
        <a
          href="mailto:kontakt@przeprogramowani.pl"
          class="relative mt-6 inline-flex items-center gap-2 text-sm font-medium text-mist transition-colors hover:text-white"
        >
          <MailIcon className="size-4" />
          Współpraca: kontakt@przeprogramowani.pl
          <ArrowRightIcon className="size-4" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
