---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Nie znaleziono strony" description="Podana strona nie istnieje.">
  <section class="relative flex min-h-[70vh] items-center overflow-hidden">
    <div class="hero-grid absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-24 text-center sm:px-6">
      <p class="font-mono text-8xl font-bold tracking-tight">
        <span class="text-brand-400">4</span><span class="text-accent-400">0</span><span class="text-cyan-glow">4</span>
      </p>
      <h1 class="mt-6 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Nie znaleziono strony
      </h1>
      <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-mist">
        Wygląda na to, że ten endpoint nie istnieje — może hashed routing się zmienił? Wróć na stronę główną.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-brand-600 via-accent-500 to-cyan-500 px-6 py-3.5 text-base font-semibold text-white shadow-xl shadow-brand-600/25 transition-transform hover:scale-[1.02]"
      >
        Wróć na stronę główną
      </a>
    </div>
  </section>
</BaseLayout>
