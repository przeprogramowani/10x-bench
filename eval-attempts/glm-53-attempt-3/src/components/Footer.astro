---

<footer class="border-t border-white/10 bg-ink-soft">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="font-mono text-lg font-bold tracking-tight">
          <span class="text-brand-400">&lt;/&gt;</span> <span class="text-fog">Przeprogramowani</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-mist">
          {site.tagline}. Edukacja technologiczna w epoce AI — kursy, podcasty i materiały dla ambitnych programistów.
        </p>
        <div class="mt-6 flex gap-3">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="inline-flex size-9 items-center justify-center rounded-lg border border-white/10 text-mist transition-colors hover:border-brand-400/50 hover:text-white"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
                  <path d={socialIcons[social.label]} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Strona</h3>
        <ul class="mt-4 space-y-2.5">
          {
            nav.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-mist transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={site.newsletter} target="_blank" rel="noopener noreferrer" class="text-sm text-mist transition-colors hover:text-white">
              Newsletter
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Kursy</h3>
        <ul class="mt-4 space-y-2.5">
          {
            courseLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm text-mist transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Kontakt</h3>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a href={`mailto:${site.email}`} class="text-sm text-mist transition-colors hover:text-white">{site.email}</a>
          </li>
          <li>
            <a href={site.youtube} target="_blank" rel="noopener noreferrer" class="text-sm text-mist transition-colors hover:text-white">YouTube</a>
          </li>
        </ul>
        <p class="mt-6 text-sm leading-relaxed text-mist">
          Chcesz nawiązać współpracę? Napisz do nas — chętnie porozmawiamy o szkoleniach dla Twojego zespołu.
        </p>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-8 sm:flex-row">
      <p class="text-xs text-mist">
        &copy; {new Date().getFullYear()} Przeprogramowani.pl — {site.tagline}.
      </p>
      <p class="text-xs text-mist">
        Zbudowane w <span class="text-white">Astro</span> + <span class="text-white">React</span> + <span class="text-white">Tailwind</span> · gotowe na Cloudflare
      </p>
    </div>
  </div>
</footer>
