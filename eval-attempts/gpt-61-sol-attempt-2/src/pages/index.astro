---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import HeroArt from '../components/HeroArt.astro';
import Newsletter from '../components/Newsletter.astro';
import content from '../data/content.json';
---
<Layout>
  <section class="hero container">
    <div class="hero-copy"><a class="hero-badge" href="https://10xdevs.pl"><span class="status-dot"></span>POZNAJ 10xDEVS 4.0 <Icon name="external" size={14}/></a>
      <h1>Szersze spojrzenie<br/>na <span class="headline-highlight">programowanie.<svg viewBox="0 0 560 18" preserveAspectRatio="none" aria-hidden="true"><path d="M3 13Q240-3 557 10"/></svg></span></h1>
      <p>Technologia się zmienia. Ty też możesz.<br/>Pomagamy programistom rozwijać umiejętności,<br class="desktop-break"/> myśleć szerzej i tworzyć więcej — również z AI.</p>
      <div class="hero-actions"><a class="button button-dark" href="https://10xdevs.pl">Odkryj 10xDevs <Icon name="external"/></a><a class="button button-text" href="#kursy">Poznaj nasze kursy <Icon name="arrow"/></a></div>
      <div class="hero-community"><div class="avatar-stack"><img src="/images/przemek.webp" width="40" height="40" alt=""/><img src="/images/marcin.webp" width="40" height="40" alt=""/><span><Icon name="code" size={17}/></span></div><div><strong>8 100+ absolwentów 10xDevs</strong><span>Twój rozwój. Nasza wspólna misja.</span></div></div>
    </div>
    <HeroArt />
  </section>
  <section class="trust-strip" aria-label="Firmy, które nam zaufały"><div class="container"><p>ZAUFALI NAM</p><div class="company-logos"><span class="logo-smart">smart<span>Recruiters</span></span><span class="logo-callstack">◈ callstack</span><span class="logo-huuuge">Huuuge Games</span><span class="logo-future">future processing<span>technology is our way</span></span><span class="logo-autodesk">▰ AUTODESK</span></div></div></section>
  <section class="courses-section container" id="kursy"><div class="section-heading"><div><span class="eyebrow"><span class="little-square"></span> MNIEJ TEORII. WIĘCEJ PRAKTYKI.</span><h2>Twój kolejny poziom.</h2></div><p>Wiedza, którą wykorzystasz w pracy.<br/>Wybierz kierunek. My pokażemy drogę.</p></div>
    <div class="course-grid">
      <a class="course-card course-ai" href="https://10xdevs.pl"><div class="course-card-top"><span class="course-tag">AI & PROGRAMOWANIE</span><span class="circle-link"><Icon name="external"/></span></div><div class="course-illustration ai-illustration" aria-hidden="true"><span>10x</span><div class="mini-orbit"></div><span class="mini-star">✳</span></div><div class="course-body"><span class="course-kicker">ZBUDUJ SWÓJ WORKFLOW Z AI</span><h3>10xDevs</h3><p>Od pomysłu do produkcji. Opanuj pracę z agentami AI w całym cyklu tworzenia oprogramowania.</p><div class="course-meta"><span>AI-native</span><span>Praktyczny projekt</span><span>↗</span></div></div></a>
      <a class="course-card course-frontend" href="https://opanujfrontend.pl"><div class="course-card-top"><span class="course-tag">FRONTEND DEVELOPMENT</span><span class="circle-link"><Icon name="external"/></span></div><div class="course-illustration frontend-illustration" aria-hidden="true"><div class="browser-illustration"><div><i></i><i></i><i></i></div><span>&lt;<b>/</b>&gt;</span></div><span class="frontend-spark">✳</span><span class="ai-edition">AI EDITION</span></div><div class="course-body"><span class="course-kicker">TWÓRZ NOWOCZESNY WEB</span><h3>Opanuj Frontend</h3><p>Architektura, testy, CI/CD i dobre praktyki. Rozwijaj aplikacje webowe z pewnością siebie.</p><div class="course-meta"><span>5 modułów</span><span>10 tygodni</span><span>↗</span></div></div></a>
      <a class="course-card course-typescript" href="https://opanujtypescript.pl"><div class="course-card-top"><span class="course-tag">TYPESCRIPT & REACT</span><span class="circle-link"><Icon name="external"/></span></div><div class="course-illustration ts-illustration" aria-hidden="true"><span class="ts-bracket">&#123;</span><div class="ts-tile">TS<span>✓</span></div><span class="ts-bracket">&#125;</span></div><div class="course-body"><span class="course-kicker">POSTAW NA DOBRE TYPY</span><h3>Opanuj TypeScript</h3><p>Pisz bezpieczniejszy kod. Poznaj TypeScript i React w praktyce, od fundamentów po zaawansowane wzorce.</p><div class="course-meta"><span>TypeScript 5</span><span>React 19</span><span>↗</span></div></div></a>
    </div>
  </section>
  <section class="media-section"><div class="container"><div class="section-heading"><div><span class="eyebrow"><span class="little-square"></span> ZOSTAŃ NA BIEŻĄCO</span><h2>Wiedza bez paywalla.</h2></div><a class="text-link" href="/youtube/">Wszystkie materiały <Icon name="arrow"/></a></div><div class="home-media-grid">
    <a class="featured-podcast" href={content.podcasts[0].url}><div class="podcast-cover"><span class="eyebrow">PRZEPROGRAMOWANI PODCAST</span><div class="podcast-cover-title">opanuj<span>.AI</span></div><div class="waveform" aria-hidden="true">{Array.from({length: 31}, (_,i) => <i style={`height:${16 + Math.abs(Math.sin(i*1.4))*66}px`}></i>)}</div><span class="podcast-cover-bottom">SZERSZA PERSPEKTYWA. DOBRA ROZMOWA.</span><span class="play-circle"><Icon name="play" size={22}/></span></div><div class="media-card-copy"><span class="eyebrow">PODCAST <span>· {content.podcasts[0].duration}</span></span><h3>{content.podcasts[0].title.replace(/\s*\|.*$/, '')}</h3><span class="text-link">Posłuchaj odcinka <Icon name="arrow" size={17}/></span></div></a>
    {content.videos.slice(1,3).map(video => <a class="video-card" href={video.url}><div class="video-thumbnail"><img src={video.image} alt="" loading="lazy" width="640" height="360"/><span class="play-circle"><Icon name="play" size={22}/></span></div><div class="media-card-copy"><span class="eyebrow">YOUTUBE <span>· PRZEPROGRAMOWANI</span></span><h3>{video.title}</h3><span class="text-link">Obejrzyj film <Icon name="arrow" size={17}/></span></div></a>)}
  </div><div class="media-platforms"><span>W swoim tempie. Na swojej platformie.</span><a href="/podcast/"><Icon name="headphones" size={18}/> Nasze podcasty <Icon name="external" size={15}/></a><a href="https://youtube.com/c/przeprogramowani"><Icon name="play" size={18}/> Kanał YouTube <Icon name="external" size={15}/></a></div></div></section>
  <section class="about-teaser container"><div class="about-portraits"><div><img src="/images/przemek.webp" alt="Przemek Smyrdek" loading="lazy" width="320" height="350"/><span>Przemek</span></div><div><img src="/images/marcin.webp" alt="Marcin Czarkowski" loading="lazy" width="320" height="350"/><span>Marcin</span></div><span class="portrait-sticker" aria-hidden="true">&lt;/&gt;</span></div><div class="about-teaser-copy"><span class="eyebrow"><span class="little-square"></span> CZEŚĆ, TU PRZEPROGRAMOWANI</span><h2>Programiści.<br/>Edukatorzy.<br/><span class="muted-heading">Przede wszystkim ludzie.</span></h2><p>Łączy nas ciekawość i przekonanie, że dobry programista widzi więcej niż kod. Dzielimy się tym, czego sami uczymy się w projektach, zespołach i rozmowach.</p><a class="text-link" href="/o-nas/">Poznaj nas bliżej <Icon name="arrow"/></a></div></section>
  <Newsletter />
</Layout>
