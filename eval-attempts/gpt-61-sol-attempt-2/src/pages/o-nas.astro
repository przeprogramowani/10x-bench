---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Newsletter from '../components/Newsletter.astro';
---
<Layout title="O nas — Ludzie za Przeprogramowanymi | Przeprogramowani" description="Poznaj Przemka Smyrdka i Marcina Czarkowskiego, twórców Przeprogramowani.pl. Łączymy programowanie, edukację i rozwój zawodowy.">
  <section class="page-intro container"><div class="breadcrumb"><a href="/">Strona główna</a><span>/</span>O nas</div><span class="eyebrow"><span class="little-square"></span> LUDZIE ZA KODEM</span><h1>Ciekawość nas łączy.<br/><span class="muted-heading">Praktyka nas napędza.</span></h1><p>Jesteśmy Przeprogramowani. Łączymy świat technologii,<br class="desktop-break"/> biznesu i rozwoju. I wierzymy, że zawsze warto patrzeć szerzej.</p></section>
  <section class="team-section container"><article class="team-card"><div class="team-photo"><img src="/images/przemek.webp" alt="Przemek Smyrdek" width="500" height="500"/><span class="team-photo-mark" aria-hidden="true">&lt;/&gt;</span></div><div class="team-copy"><span class="eyebrow">CO-FOUNDER · EDUKATOR · ENGINEER</span><h2>Przemek Smyrdek</h2><p>Autor programów edukacyjnych, kursów i podcastów. Zdobywał doświadczenie jako Lead Engineer i Manager w DAZN i Cabify, rozwijając aplikacje full-stack.</p><p>Dzieli się wiedzą na 4Developers, ReactiveConf i InfoShare. Współtworzy projekty open source, między innymi CursorLens i openapi-typescript.</p><a class="text-link" href="https://www.linkedin.com/in/psmyrdek/">Poznaj Przemka na LinkedIn <Icon name="external" size={18}/></a></div></article>
  <article class="team-card"><div class="team-photo team-photo-blue"><img src="/images/marcin.webp" alt="Marcin Czarkowski" width="500" height="500" loading="lazy"/><span class="team-photo-mark" aria-hidden="true">&#123; &#125;</span></div><div class="team-copy"><span class="eyebrow">CO-FOUNDER · EDUKATOR · TECH LEAD</span><h2>Marcin Czarkowski</h2><p>Lead techniczny Platformy Frontendowej w SmartRecruiters. Specjalizuje się w TypeScript, React i Node.js, czerpiąc z ponad dekady pracy nad komercyjnymi projektami.</p><p>Pasjonat neurobiologii i skutecznego uczenia się. Twórca Opanuj.AI Podcast, w którym przygląda się praktycznemu wykorzystaniu modeli językowych.</p><a class="text-link" href="https://www.linkedin.com/in/mkczarkowski/">Poznaj Marcina na LinkedIn <Icon name="external" size={18}/></a></div></article></section>
  <section class="mission-section container"><span class="eyebrow"><span class="little-square"></span> NASZE PODEJŚCIE</span><h2>Dobry programista<br/>widzi więcej niż kod.</h2><div class="mission-grid">{[{number:'01',title:'Praktyka ponad teorią',text:'Pokazujemy rozwiązania, których używamy w projektach. Uczysz się przez tworzenie, eksperymentowanie i rozwiązywanie problemów.'},{number:'02',title:'Szersza perspektywa',text:'Technologia to część układanki. Rozmawiamy też o biznesie, pracy zespołowej i świadomym budowaniu kariery.'},{number:'03',title:'Rozwój w dobrym towarzystwie',text:'Kursy, rozmowy i wspólne projekty. Tworzymy przestrzeń do wymiany doświadczeń, zadawania pytań i robienia kolejnych kroków.'}].map(item=><div><span class="mission-number">{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></div>)}</div><a class="button button-dark" href="mailto:kontakt@przeprogramowani.pl">Porozmawiajmy o współpracy <Icon name="external"/></a></section>
  <Newsletter />
</Layout>
