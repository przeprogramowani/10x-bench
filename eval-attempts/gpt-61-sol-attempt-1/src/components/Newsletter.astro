---
import Icon from './Icon.astro';
---

<section id="newsletter" class="container newsletter-section">
  <div class="newsletter-copy">
    <span class="eyebrow">DOBRY KOD ZACZYNA SIĘ OD DOBRYCH INSPIRACJI</span>
    <h2>
      Piątek. Kawa.
      <br />
      <span>Nowa perspektywa.</span>
    </h2>
    <p>
      3 rekomendacje techniczne, 2 rozwojowe i 1 niespodzianka.
      <br />
      Przeprogramowany Newsletter. Co tydzień, prosto do Ciebie.
    </p>
    <a class="button button-dark" href="https://przeprogramowani.substack.com/">
      Dołącz do newslettera <Icon name="arrow" size={18} />
    </a>
    <span class="newsletter-note">Za darmo. Wypisujesz się, kiedy chcesz.</span>
  </div>
  <div class="newsletter-art" aria-hidden="true">
    <span class="newsletter-asterisk">✳</span>
    <div class="newsletter-paper">
      <span>
        PRZEPROGRAMOWANY
        <br />
        NEWSLETTER ↗
      </span>
      <strong>
        3<span>—</span>2<span>—</span>1
      </strong>
      <div class="paper-line"></div>
      <div class="paper-line short"></div>
      <p>Twój piątkowy rytuał.</p>
      <Icon name="mail" size={30} />
    </div>
  </div>
</section>
