---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Nie znaleziono strony">
  <section class="container not-found">
    <span class="eyebrow justify-center">COŚ POSZŁO INNĄ ŚCIEŻKĄ</span>
    <h1>404</h1>
    <h2>Tu jeszcze nie ma kodu.</h2>
    <p>Ta strona nie istnieje. Wróć i odkryj nasze kursy, filmy oraz podcasty.</p>
    <a class="button button-purple" href="/">
      Wróć na stronę główną <Icon name="arrow" size={17} />
    </a>
  </section>
</Layout>
