---
import Layout from '../layouts/Layout.astro';
import { courses } from '../data/site';
---
<Layout title="Kursy — Przeprogramowani.pl" description="10xDevs, Opanuj Frontend: AI Edition i Opanuj TypeScript: Frontend Pro.">
  <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6">
    <p class="text-xs font-bold uppercase tracking-widest text-cyan-300">Kursy</p>
    <h1 class="mt-1 text-4xl font-extrabold text-white sm:text-5xl">Topowe programy dla ambitnych devów</h1>
    <p class="mt-3 max-w-2xl text-slate-300">Od AI-Native workflow, przez kompletny frontend, po produkcyjny TypeScript z React 19.</p>
  </section>
  <section class="mx-auto grid max-w-7xl gap-6 px-4 pt-8 sm:px-6">
    {courses.map((c) => (
      <article id={c.slug} class="glass scroll-mt-24 overflow-hidden rounded-3xl">
        <div class={`bg-gradient-to-r ${c.gradient} px-6 py-2 text-xs font-bold text-white`}>{c.badge}</div>
        <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-[1.2fr_.8fr]">
          <div>
            <h2 class="text-3xl font-extrabold text-white">{c.icon} {c.name}</h2>
            <p class="mt-1 font-semibold text-slate-300">{c.tagline}</p>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{c.desc}</p>
            <p class="mt-3 text-xs font-semibold text-slate-500">{c.meta}</p>
            <a href={c.href} class={`mt-5 inline-block rounded-xl bg-gradient-to-r ${c.gradient} px-6 py-3 text-sm font-bold text-white shadow-lg`}>{c.cta} →</a>
          </div>
          <ul class="space-y-2 rounded-2xl bg-black/30 p-5 text-sm text-slate-200">
            <p class="text-xs font-bold uppercase tracking-widest text-slate-400">Co dostajesz</p>
            {c.features.map((f) => <li class="flex gap-2"><span class="text-emerald-300">✓</span>{f}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </section>
</Layout>
