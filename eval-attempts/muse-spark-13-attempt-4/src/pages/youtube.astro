---
import Layout from '../layouts/Layout.astro';
import VideoGrid from '../components/VideoGrid';
---
<Layout title="YouTube — Przeprogramowani.pl" description="Ostatnie filmy Przeprogramowanych: AI, 10xDevs, workflow z agentami, benchmarki i live z ekspertami.">
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-red-400">▶ YouTube</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-black tracking-tight sm:text-6xl">Filmy i live'y <span class="text-gradient">dla nowoczesnych devów</span></h1>
    <p class="mt-4 max-w-2xl text-slate-300">Rozwój nowoczesnego programisty: AI-Native, 10xWorkflow, benchmarki modeli i architektura z agentem AI. Kliknij miniaturę, aby odtworzyć bez opuszczania strony.</p>
    <div class="mt-6">
      <a href="https://youtube.com/c/przeprogramowani/videos" target="_blank" class="inline-block rounded-2xl bg-red-600 px-7 py-3.5 text-sm font-black text-white hover:bg-red-500">Subskrybuj kanał →</a>
    </div>
    <div class="mt-10">
      <VideoGrid client:visible />
    </div>
    <p class="mt-8 text-xs text-slate-500">Źródło: youtube.com/c/przeprogramowani — ostatnie publikacje z przeprogramowani.pl.</p>
  </section>
</Layout>
