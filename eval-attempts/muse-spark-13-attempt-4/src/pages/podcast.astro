---
import Layout from '../layouts/Layout.astro';
import PodcastExplorer from '../components/PodcastExplorer';
---
<Layout title="Podcast — Przeprogramowani.pl" description="Opanuj.AI Podcast i Przeprogramowani ft. Gość — ostatnie odcinki o AI, frontendzie i karierze programisty.">
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-violet-300">🎙 Podcasty</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-black tracking-tight sm:text-6xl">Słuchaj o technologii, <span class="text-gradient">AI i programowaniu</span></h1>
    <p class="mt-4 max-w-2xl text-slate-300">Dwa formaty: <strong>Opanuj.AI</strong> (4000+ słuchaczy, comiesięczne podsumowania świata AI) oraz <strong>Przeprogramowani ft. Gość</strong> (3800+ słuchaczy, rozmowy dla głodnych wiedzy).</p>
    <div class="mt-6 flex flex-wrap gap-2 text-xs">
      <a href="https://podcasts.apple.com/pl/podcast/przeprogramowani/id1508387250" target="_blank" class="rounded-full border border-white/15 px-4 py-2 hover:bg-white/10">🍎 Apple Podcasts</a>
      <a href="https://open.spotify.com/show/4qHUZJpeBK8Ij9e2wTVm2o" target="_blank" class="rounded-full border border-white/15 px-4 py-2 hover:bg-white/10">🟢 Spotify</a>
      <a href="https://anchor.fm/s/22544b7c/podcast/rss" target="_blank" class="rounded-full border border-white/15 px-4 py-2 hover:bg-white/10">📡 RSS</a>
    </div>
    <div class="mt-10">
      <PodcastExplorer client:load />
    </div>
    <p class="mt-8 text-xs text-slate-500">Źródło: przeprogramowani.pl/podcast · Opanuj.AI + Przeprogramowani ft. Gość. Linki prowadzą do Spotify / Anchor.</p>
  </section>
</Layout>
