---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Courses from '../components/Courses.astro';
import Newsletter from '../components/Newsletter.astro';
import content from '../data/content.json';
const videos = content.videos.slice(1,4);
---
<Layout>
 <section class="hero container">
  <div class="hero-copy"><span class="eyebrow"><span class="tiny-line"></span> TECHNOLOGIA. ROZWÓJ. SPOŁECZNOŚĆ.</span><h1>Szersze spojrzenie.<br/> <span>Większe<br/> możliwości.</span></h1><p>Świat technologii nie stoi w miejscu. Ty też nie musisz.<br class="desktop-break"/> Pomagamy programistom rozwijać umiejętności,<br class="desktop-break"/> myśleć szerzej i tworzyć rzeczy, które mają znaczenie.</p><div class="hero-actions"><a class="button button-orange" href="#kursy">Znajdź swój następny krok <Icon name="arrow"/></a><a class="text-link" href="/o-nas/">Poznaj nas <Icon name="diagonal" size={17}/></a></div><div class="hero-people"><div class="avatar-stack"><img src="/images/przemek.webp" alt="" width="36" height="36"/><img src="/images/marcin.webp" alt="" width="36" height="36"/></div><span>Od programistów. Dla programistów.</span><span class="people-line"></span></div></div>
  <a class="hero-feature" href="https://10xdevs.pl/" aria-label="Poznaj program 10xDevs 4.0"><div class="feature-top"><span class="feature-label"><span></span> TWÓJ NOWY SUPERPOWER</span><span class="feature-edition">EDYCJA 4.0</span></div><div class="feature-art" aria-hidden="true"><svg class="orbit-art" viewBox="0 0 500 330"><defs><radialGradient id="orb"><stop stop-color="#d6c4ff"/><stop offset=".45" stop-color="#9570ff"/><stop offset="1" stop-color="#5525d5"/></radialGradient></defs><g fill="none" stroke="#c3aaff" stroke-width=".7" opacity=".55"><ellipse cx="250" cy="165" rx="205" ry="64" transform="rotate(-28 250 165)"/><ellipse cx="250" cy="165" rx="205" ry="64" transform="rotate(28 250 165)"/><ellipse cx="250" cy="165" rx="205" ry="64" transform="rotate(90 250 165)"/><circle cx="250" cy="165" r="110"/><circle cx="250" cy="165" r="144" stroke-dasharray="2 7"/></g><circle cx="250" cy="165" r="85" fill="url(#orb)"/><g fill="white"><circle cx="69" cy="77" r="4"/><circle cx="411" cy="238" r="4"/><circle cx="250" cy="20" r="3"/></g></svg><div class="ten-x">10<span>x</span><span class="devs">devs</span></div><span class="feature-float float-one">&lt; human + AI /&gt;</span><span class="feature-float float-two"><Icon name="spark" size={13}/> build better.</span></div><div class="feature-copy"><span class="feature-kicker">AI-NATIVE SOFTWARE ENGINEERING</span><h2>Nie nadążaj za zmianą.<br/> Bądź jej częścią.</h2><p>Od pomysłu do wdrożenia. Opanuj świadomą<br/> pracę z AI w całym procesie tworzenia oprogramowania.</p><div class="feature-bottom"><span>Poznaj 10xDevs <Icon name="arrow" size={19}/></span><span class="feature-bottom-note">KODUJ. TWÓRZ. ZMIENIAJ.</span></div></div></a>
 </section>
 <section class="proof container" aria-label="Przeprogramowani w liczbach"><div class="proof-intro"><span class="proof-spark" aria-hidden="true">✳</span><p>Wiedza to początek.<br/> <strong>Praktyka robi różnicę.</strong></p></div><div class="proof-stat"><strong>8 100<span>+</span></strong><span>absolwentów 10xDevs</span></div><div class="proof-stat"><strong>7<span> lat</span></strong><span>edukacji technologicznej</span></div><div class="proof-stat"><strong>2</strong><span>perspektywy. Wspólna misja.</span></div></section>
 <Courses/>
 <section class="section media-home"><div class="container"><div class="section-heading"><div><span class="eyebrow"><span class="tiny-line"></span> OTWIERAMY NOWE PERSPEKTYWY</span><h2>Włącz ciekawość<span>.</span></h2></div><a href="/youtube/" class="text-link">Wszystkie filmy <Icon name="arrow" size={18}/></a></div><div class="home-media-grid">{videos.map((video) => <a class="media-card" href={video.url} target="_blank" rel="noopener noreferrer"><div class="media-image"><img src={video.image} alt="" width="480" height="360" loading="lazy"/><span class="media-play"><Icon name="play" size={20}/></span><span class="video-tag">YOUTUBE</span></div><div class="media-meta"><span>AI & PROGRAMOWANIE</span><Icon name="diagonal" size={18}/></div><h3>{video.title}</h3></a>)}</div><a class="podcast-banner" href="/podcast/"><span class="podcast-icon"><Icon name="headphones" size={27}/></span><div><span class="eyebrow">DOBRE ROZMOWY ZOSTAJĄ NA DŁUŻEJ</span><h3>Wolisz słuchać? Mamy coś dla Ciebie.</h3></div><span class="podcast-banner-cta">Poznaj nasze podcasty <Icon name="arrow"/></span></a></div></section>
 <section class="section about-home"><div class="container about-grid"><div class="founder-collage"><div class="founder-photo photo-przemek"><img src="/images/przemek.webp" alt="Przemek Smyrdek" loading="lazy"/><span>Przemek Smyrdek <Icon name="code" size={18}/></span></div><div class="founder-photo photo-marcin"><img src="/images/marcin.webp" alt="Marcin Czarkowski" loading="lazy"/><span>Marcin Czarkowski <Icon name="code" size={18}/></span></div><span class="collage-spark" aria-hidden="true">✳</span><span class="collage-note">Dwie perspektywy.<br/> Jeden kierunek.</span></div><div class="about-copy"><span class="eyebrow"><span class="tiny-line"></span> CZEŚĆ, TU PRZEPROGRAMOWANI</span><h2>Programowanie<br/> to dopiero początek<span>.</span></h2><p>Jesteśmy Przemek i Marcin. Łączymy doświadczenie z tworzenia oprogramowania z pasją do dzielenia się wiedzą.</p><p>Wierzymy, że dobry programista patrzy szerzej: na technologię, biznes i ludzi. Dlatego tworzymy miejsce, w którym rozwój nie kończy się na kolejnej linijce kodu.</p><a href="/o-nas/" class="text-link">Poznaj ludzi za projektem <Icon name="arrow" size={19}/></a></div></div></section>
 <Newsletter/>
</Layout>
