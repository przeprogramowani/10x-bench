---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'center' | 'left';
}

const { eyebrow, title, lead, align = 'center' } = Astro.props;
---

<div class:list={['mx-auto max-w-3xl', align === 'center' ? 'text-center' : 'text-left']}>
  {eyebrow && (
    <p class="text-sm font-semibold uppercase tracking-widest text-brand-300">
      {eyebrow}
    </p>
  )}
  <h2 class="mt-2 font-display text-3xl font-bold text-white sm:text-4xl md:text-5xl">
    {title}
  </h2>
  {lead && (
    <p class="mt-4 text-lg leading-relaxed text-slate-400">
      {lead}
    </p>
  )}
</div>
