{
  "name": "przeprogramowani-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Nowoczesna strona projektu Przeprogramowani.pl — Astro + React + Tailwind, gotowa na Cloudflare Pages",
  "scripts": {
