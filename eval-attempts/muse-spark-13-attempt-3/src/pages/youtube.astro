---
import Layout from '../layouts/Layout.astro';
import VideoGrid from '../components/VideoGrid.tsx';
import { videos } from '../data/content.ts';
---
<Layout current="/youtube" title="YouTube — Przeprogramowani" description="Ostatnie filmy Przeprogramowanych: AI, 10xDevs Demo Day, workflow i benchmarki.">
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-red-300">YouTube</p>
    <h1 class="font-display mt-2 text-4xl font-extrabold sm:text-5xl">Rozwój nowoczesnego programisty na wideo</h1>
    <p class="mt-3 max-w-2xl text-white/65">
      Kliknij miniaturę, aby odtworzyć film bez opuszczania strony. Pełne archiwum na kanale{' '}
      <a href="https://youtube.com/c/przeprogramowani/videos" target="_blank" rel="noreferrer" class="font-semibold text-white underline">youtube.com/c/przeprogramowani</a>.
    </p>
    <div class="mt-8">
      <VideoGrid videos={videos} client:load />
    </div>
  </section>
</Layout>
