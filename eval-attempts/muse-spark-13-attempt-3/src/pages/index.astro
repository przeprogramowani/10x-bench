---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.tsx';
import Courses from '../components/Courses.tsx';
import NewsletterForm from '../components/NewsletterForm.tsx';
import { episodesOpanujAI, videos, partners } from '../data/content.ts';
---
<Layout current="/">
  <Hero client:load />
  <Courses client:visible />

  <section class="border-y border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 class="font-display text-2xl font-bold sm:text-3xl">Ostatnie filmy na YouTube</h2>
        <a href="/youtube" class="text-sm font-semibold text-red-300 hover:text-white">Wszystkie filmy →</a>
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {videos.slice(0, 3).map((v) => (
          <a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noreferrer" class="glass card-hover overflow-hidden rounded-2xl">
            <img src={`https://i3.ytimg.com/vi/${v.id}/maxresdefault.jpg`} alt="" loading="lazy" class="aspect-video w-full object-cover" />
            <p class="p-4 text-sm font-semibold leading-snug">{v.title}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 class="font-display text-2xl font-bold sm:text-3xl">Ostatnie odcinki podcastu</h2>
      <a href="/podcast" class="text-sm font-semibold text-violet-300 hover:text-white">Wszystkie odcinki →</a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {episodesOpanujAI.slice(0, 3).map((e) => (
        <article class="glass card-hover rounded-2xl p-5">
          <p class="text-xs font-medium text-cyan-300">{e.meta}</p>
          <h3 class="font-display mt-2 text-sm font-bold leading-snug">{e.title}</h3>
          <p class="mt-2 text-xs text-white/60">{e.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6">
    <NewsletterForm client:visible />
    <div class="mt-10 overflow-hidden" aria-label="Zaufali nam">
      <p class="text-center text-xs font-semibold uppercase tracking-widest text-white/40">Zaufali nam • 7 lat na rynku</p>
      <div class="relative mt-4">
        <div class="marquee flex w-max gap-3">
          {[...partners, ...partners].map((p, i) => (
            <span key={i} class="rounded-full border border-white/10 bg-white/5 px-5 py-2 text-sm text-white/70">{p}</span>
          ))}
        </div>
      </div>
      <p class="mt-8 text-center text-sm text-white/60">Współpraca: <a href="mailto:kontakt@przeprogramowani.pl" class="font-semibold text-white">kontakt@przeprogramowani.pl</a></p>
    </div>
  </section>
</Layout>
