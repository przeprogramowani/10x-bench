---
import '../styles/global.css';
import Navbar from '../components/Navbar.tsx';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}
const { title = 'Przeprogramowani — Szersze spojrzenie na programowanie', description = 'Kursy 10xDevs, Opanuj Frontend, Opanuj TypeScript. Podcasty i YouTube dla programistów.', current = '/' } = Astro.props;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💻</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="#main" class="sr-only">Przejdź do treści</a>
    <Navbar current={current} client:load />
    <main id="main">
      <slot />
    </main>
    <footer class="border-t border-white/10 py-10">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 md:grid-cols-4">
        <div>
          <p class="font-display font-bold"><span class="text-violet-400">&lt;/&gt;</span> Przeprogramowani</p>
          <p class="mt-2 text-sm text-white/60">Szersze spojrzenie na programowanie. Edukacja, podcasty, kursy.</p>
        </div>
        <nav aria-label="Stopka">
          <p class="text-sm font-semibold">Mapa strony</p>
          <ul class="mt-2 space-y-1 text-sm text-white/65">
            <li><a href="/" class="hover:text-white">Start</a></li>
            <li><a href="/o-nas" class="hover:text-white">O nas</a></li>
            <li><a href="/podcast" class="hover:text-white">Podcast</a></li>
            <li><a href="/youtube" class="hover:text-white">YouTube</a></li>
          </ul>
        </nav>
        <div>
          <p class="text-sm font-semibold">Kursy</p>
          <ul class="mt-2 space-y-1 text-sm text-white/65">
            <li><a href="https://10xdevs.pl" class="hover:text-white">10xDevs</a></li>
            <li><a href="https://www.opanujfrontend.pl" class="hover:text-white">Opanuj Frontend</a></li>
            <li><a href="https://www.opanujtypescript.pl" class="hover:text-white">Opanuj TypeScript</a></li>
            <li><a href="https://opanuj.ai" class="hover:text-white">Opanuj AI</a></li>
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold">Kontakt</p>
          <ul class="mt-2 space-y-1 text-sm text-white/65">
            <li><a href="mailto:kontakt@przeprogramowani.pl" class="hover:text-white">kontakt@przeprogramowani.pl</a></li>
            <li><a href="https://youtube.com/c/przeprogramowani" class="hover:text-white">YouTube</a></li>
            <li><a href="https://open.spotify.com/show/4qHUZJpeBK8Ij9e2wTVm2o" class="hover:text-white">Spotify</a></li>
          </ul>
        </div>
      </div>
      <p class="mx-auto mt-8 max-w-7xl px-4 text-xs text-white/40 sm:px-6">© 2026 Przeprogramowani.pl — wersja koncepcyjna (Astro + React + Tailwind, Cloudflare Pages).</p>
    </footer>
  </body>
</html>
