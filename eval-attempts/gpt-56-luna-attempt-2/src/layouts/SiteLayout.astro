---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Przeprogramowani.pl — Szersze spojrzenie na programowanie',
  description = 'Edukacja technologiczna dla ambitnych programistów. Frontend, TypeScript, AI, podcasty i rozmowy o rozwoju.',
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101512" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%23d8ff54%22/><text x=%2250%22 y=%2270%22 text-anchor=%22middle%22 font-size=%2265%22 font-family=%22Arial%22 fill=%22%23101512%22>%26lt;%26gt;</text></svg>" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
