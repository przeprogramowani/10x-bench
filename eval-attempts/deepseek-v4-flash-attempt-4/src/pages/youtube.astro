---
import Layout from '../layouts/Layout.astro';
---

<Layout title="YouTube" description="Oglądaj filmy Przeprogramowanych na YouTube. Materiały o programowaniu, AI i nowoczesnych technologiach.">
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="mb-8 text-sm text-slate-500">
        <a href="/" class="hover:text-white">Strona główna</a>
        <span class="mx-2">/</span>
        <span class="text-slate-300">YouTube</span>
      </nav>
      <div class="flex items-center justify-between">
        <div class="max-w-2xl">
          <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">YouTube</h1>
          <p class="mt-4 text-lg text-slate-400">Materiały o programowaniu, AI i nowoczesnych technologiach</p>
        </div>
        <a href="https://youtube.com/c/przeprogramowani" target="_blank" class="hidden items-center gap-2 rounded-xl bg-red-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-red-700 sm:inline-flex">
          Subskrybuj
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" /></svg>
        </a>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { id: 'c5HVzK-tclM', title: 'Poznaj AI Workflow, które działa na produkcji - LIVE 10xDevs' },
          { id: 'B4t6w4QsD24', title: 'Darmowe AI na każdym Maku - jak działa Apple Foundational Models na macOS 27' },
          { id: '0JOszZXqKaM', title: 'Byliśmy na Google I/O 2026 - wrażenia na gorąco! | Opanuj.AI LIVE - Maj 2026' },
          { id: 'XgyH-HSzKRQ', title: 'Byłem na Google I/O 2026. Nie tego się spodziewałem.' },
          { id: '03y826SVjG0', title: 'Jak wybrać najlepszego Agenta AI do programowania?' },
          { id: 'S-iNbyLSisE', title: '5 Agent Skills do jakościowego programowania z AI - Claude Code LIVE DEMO' },
        ].map(video => (
          <a key={video.id} href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" class="group overflow-hidden rounded-xl border border-white/5 bg-surface-light/50 transition hover:border-red-500/30 hover:bg-surface-light">
            <div class="relative aspect-video overflow-hidden">
              <img src={`https://img.youtube.com/vi/${video.id}/maxresdefault.jpg`} alt={video.title} class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="flex h-14 w-14 items-center justify-center rounded-full bg-red-600/90 transition group-hover:bg-red-600">
                  <svg class="ml-0.5 h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                </div>
              </div>
            </div>
            <div class="p-4">
              <h3 class="text-sm font-medium text-slate-200 line-clamp-2 group-hover:text-red-400">{video.title}</h3>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="https://youtube.com/c/przeprogramowani" target="_blank" class="inline-flex items-center gap-2 rounded-xl bg-red-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-red-700 sm:hidden">
          Subskrybuj kanał →
        </a>
      </div>
    </div>
  </section>
</Layout>
