---
import Layout from '../layouts/Layout.astro';
import YouTubeVideos from '../components/YouTubeVideos';
import PodcastEpisodes from '../components/PodcastEpisodes';
---

<Layout title="Przeprogramowani" description="Szersze spojrzenie na programowanie — kursy, podcasty i społeczność dla ambitnych programistów.">
  <!-- Hero: 10xDevs -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-brand/20 via-surface to-accent/10" />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-brand/10 via-transparent to-transparent" />
    <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="mb-4 inline-block rounded-full bg-brand/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-light">
            Nowość — Wrzesień 2026
          </p>
          <h1 class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            <span class="bg-gradient-to-r from-white via-white to-slate-400 bg-clip-text text-transparent">10xDevs</span>
            <br />
            <span class="bg-gradient-to-r from-brand-light to-accent bg-clip-text text-transparent">4.0</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">
            Nowe oblicze programowania z wykorzystaniem Generatywnego AI. Techniki i narzędzia pozwalające świadomie stosować AI w całym cyklu wytwarzania oprogramowania.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="https://10xdevs.pl" target="_blank" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-brand to-accent px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand/25 transition hover:opacity-90 hover:shadow-xl hover:shadow-brand/30">
              Sprawdź szczegóły
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
            <a href="/o-nas" class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold text-slate-200 backdrop-blur-sm transition hover:bg-white/10 hover:text-white">
              Poznaj nas
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <div class="relative">
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-brand/30 to-accent/30 blur-3xl" />
            <div class="relative rounded-2xl border border-white/10 bg-surface-light/50 p-8 backdrop-blur-sm">
              <div class="grid grid-cols-2 gap-4">
                <div class="rounded-xl border border-white/5 bg-white/5 p-4">
                  <div class="text-2xl font-bold text-accent">5</div>
                  <div class="text-xs text-slate-400">tygodni intensywnego programu</div>
                </div>
                <div class="rounded-xl border border-white/5 bg-white/5 p-4">
                  <div class="text-2xl font-bold text-emerald-400">3700+</div>
                  <div class="text-xs text-slate-400">zadowolonych absolwentów</div>
                </div>
                <div class="rounded-xl border border-white/5 bg-white/5 p-4">
                  <div class="text-2xl font-bold text-brand-light">7</div>
                  <div class="text-xs text-slate-400">lat na rynku edukacji</div>
                </div>
                <div class="rounded-xl border border-white/5 bg-white/5 p-4">
                  <div class="text-2xl font-bold text-amber-400">AI-Native</div>
                  <div class="text-xs text-slate-400">od researchu po produkcję</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section class="border-y border-white/5 bg-surface-light/50 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mb-8 text-center text-xs font-semibold uppercase tracking-widest text-slate-500">Zaufali nam</p>
      <div class="flex flex-wrap items-center justify-center gap-8 opacity-50 grayscale">
        {['Huuuge Games', 'SmartRecruiters', 'Future Processing', 'Callstack', 'Autodesk', 'Strabag'].map(name => (
          <span key={name} class="text-sm font-semibold text-slate-400">{name}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Courses -->
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Topowe programy edukacyjne</h2>
        <p class="mt-4 text-slate-400">Dla ambitnych programistów, którzy chcą świadomie korzystać z potencjału nowoczesnych technologii</p>
      </div>
      <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <a href="https://opanujfrontend.pl" target="_blank" class="group rounded-2xl border border-white/5 bg-surface-light/50 p-6 transition hover:border-brand/30 hover:bg-surface-light">
          <div class="mb-4 inline-flex rounded-lg bg-gradient-to-br from-cyan-500/20 to-blue-500/20 px-3 py-1.5 text-xs font-semibold text-cyan-400">Frontend</div>
          <h3 class="text-xl font-bold text-white group-hover:text-brand-light">Opanuj Frontend: AI Edition</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">Zostań nowoczesnym frontend developerem — 5 obszernych modułów o frontendzie, testowaniu, CI/CD, open source i architekturze aplikacji webowych.</p>
          <div class="mt-4 flex items-center gap-2 text-sm font-medium text-brand-light">
            Sprawdź →
          </div>
        </a>
        <a href="https://opanujtypescript.pl" target="_blank" class="group rounded-2xl border border-white/5 bg-surface-light/50 p-6 transition hover:border-brand/30 hover:bg-surface-light">
          <div class="mb-4 inline-flex rounded-lg bg-gradient-to-br from-blue-500/20 to-indigo-500/20 px-3 py-1.5 text-xs font-semibold text-blue-400">TypeScript</div>
          <h3 class="text-xl font-bold text-white group-hover:text-brand-light">Opanuj TypeScript</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">Szkolenie, które podniesie jakość Twoich projektów. Pracujemy z najnowszymi wersjami TypeScript 5 i React 19!</p>
          <div class="mt-4 flex items-center gap-2 text-sm font-medium text-brand-light">
            Sprawdź →
          </div>
        </a>
        <a href="https://opanuj.ai" target="_blank" class="group rounded-2xl border border-white/5 bg-surface-light/50 p-6 transition hover:border-brand/30 hover:bg-surface-light">
          <div class="mb-4 inline-flex rounded-lg bg-gradient-to-br from-purple-500/20 to-pink-500/20 px-3 py-1.5 text-xs font-semibold text-purple-400">Gen AI</div>
          <h3 class="text-xl font-bold text-white group-hover:text-brand-light">Opanuj AI</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">Warsztaty, podcast, blog i darmowe ebooki o sztucznej inteligencji. Zdobądź praktyczną wiedzę o AI i wdróż ją w codziennej pracy.</p>
          <div class="mt-4 flex items-center gap-2 text-sm font-medium text-brand-light">
            Sprawdź →
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Filmy i podcasty -->
  <section class="border-t border-white/5 bg-surface-light/30 py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Filmy i podcasty</h2>
        <p class="mt-4 text-slate-400">Rozwój nowoczesnego programisty</p>
      </div>
      <div class="mt-16">
        <h3 class="mb-6 text-lg font-semibold text-slate-200">
          <a href="/youtube" class="hover:text-red-400">Ostatnie filmy →</a>
        </h3>
        <YouTubeVideos client:load />
      </div>
      <div class="mt-16">
        <h3 class="mb-6 text-lg font-semibold text-slate-200">
          <a href="/podcast" class="hover:text-amber-400">Ostatnie odcinki podcastu →</a>
        </h3>
        <PodcastEpisodes client:load />
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl border border-white/5 bg-gradient-to-br from-brand/10 via-surface to-accent/5 p-8 sm:p-12 lg:p-16">
        <div class="relative z-10 mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Przeprogramowany Newsletter</h2>
          <p class="mt-4 text-slate-400">Co tydzień w piątek porcja wartościowych treści w formacie 3-2-1:</p>
          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            <div class="rounded-xl border border-white/5 bg-white/5 p-4">
              <div class="text-2xl font-bold text-accent">3</div>
              <div class="text-xs text-slate-400">rekomendacje techniczne</div>
            </div>
            <div class="rounded-xl border border-white/5 bg-white/5 p-4">
              <div class="text-2xl font-bold text-emerald-400">2</div>
              <div class="text-xs text-slate-400">rekomendacje rozwojowe</div>
            </div>
            <div class="rounded-xl border border-white/5 bg-white/5 p-4">
              <div class="text-2xl font-bold text-amber-400">1</div>
              <div class="text-xs text-slate-400">bonus niespodzianka</div>
            </div>
          </div>
          <a href="https://przeprogramowani.substack.com" target="_blank" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-surface transition hover:bg-slate-200">
            Zapisz się za darmo →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-white/5 py-20">
    <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Chcesz nawiązać współpracę?</h2>
      <a href="mailto:kontakt@przeprogramowani.pl" class="mt-4 inline-flex items-center gap-2 text-lg text-brand-light transition hover:text-accent">
        kontakt@przeprogramowani.pl →
      </a>
    </div>
  </section>
</Layout>
