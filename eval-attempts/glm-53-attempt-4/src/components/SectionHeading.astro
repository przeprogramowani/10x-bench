---
type Props = {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
};

const { eyebrow, title, subtitle, align = "center" } = Astro.props;
---

<div class={align === "center" ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}>
  <p class="font-mono text-sm uppercase tracking-widest text-fuchsia-400">{eyebrow}</p>
  <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-base leading-relaxed text-zinc-400">{subtitle}</p>}
</div>
