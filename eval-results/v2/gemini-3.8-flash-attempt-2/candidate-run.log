async function test() {
  const routes = ["/", "/o-nas", "/podcast", "/podcast/opanuj-ai", "/podcast/przeprogramowani", "/youtube", "/kursy"];
  for (const r of routes) {
    const res = await fetch("http://127.0.0.1:8798" + r);
    const text = await res.text();
    const h1Count = (text.match(/<h1[^>]*>[\s\S]*?<\/h1>/gi) || []).length;
    const titleMatch = text.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
    const descMatch = text.match(/<meta\s+name="description"\s+content="([^"]*)"/i);
    const canonicalMatch = text.match(/<link\s+rel="canonical"\s+href="([^"]*)"/i);
    const ogTitleMatch = text.match(/<meta\s+property="og:title"\s+content="([^"]*)"/i);
    const langMatch = text.match(/<html[^>]+lang="([^"]*)"/i);
    
    console.log("=== " + r + " ===");
    console.log("HTTP: " + res.status);
    console.log("H1 count: " + h1Count);
    console.log("Title: " + (titleMatch ? titleMatch[1] : "NONE"));
    console.log("Desc: " + (descMatch ? descMatch[1].slice(0, 50) + "..." : "NONE"));
    console.log("Canonical: " + (canonicalMatch ? canonicalMatch[1] : "NONE"));
    console.log("OG Title: " + (ogTitleMatch ? ogTitleMatch[1] : "NONE"));
    console.log("Lang: " + (langMatch ? langMatch[1] : "NONE"));
  }
}
test();
'

