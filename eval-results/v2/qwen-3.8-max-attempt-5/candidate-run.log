import re, json, html, email.utils, datetime

def clean(s):
    return html.unescape(re.sub(r'\s+',' ', s or '')).strip()

def parse_rss(path, source, maxn=8):
    s=open(path).read()
    ch=re.search(r'<channel>(.*?)</channel>',s,re.S).group(1)
    title=clean(re.sub(r'<!\[CDATA\[|\]\]>','',re.search(r'<title>(.*?)</title>',ch,re.S).group(1)))
    items=[]
    for it in re.findall(r'<item>(.*?)</item>',ch,re.S)[:maxn]:
        t=re.search(r'<title>(.*?)</title>',it,re.S)
        d=re.search(r'<pubDate>(.*?)</pubDate>',it,re.S)
        l=re.search(r'<link>(.*?)</link>',it,re.S)
        e=re.search(r'<enclosure[^>]*url="([^"]*)"',it)
        desc=re.search(r'<description>(.*?)</description>',it,re.S)
        pub=None
        if d:
            try:
                pub=email.utils.parsedate_to_datetime(d.group(1)).isoformat()
            except Exception: pass
        summ=''
        if desc:
            dd=clean(re.sub(r'<!\[CDATA\[|\]\]>','',desc.group(1)))
            dd=clean(re.sub(r'<[^>]+>',' ',dd))
            summ=dd[:220]
        items.append({'id':l.group(1) if l else t.group(1),'title':clean(re.sub(r'<!\[CDATA\[|\]\]>','',t.group(1) if t else '')),'url':l.group(1) if l else '','publishedAt':pub,'audioUrl':e.group(1) if e else None,'summary':summ})
    return {'source':source,'channelTitle':title,'items':items}

def parse_yt(path, source, maxn=8):
    s=open(path).read()
    items=[]
    for e in re.findall(r'<entry>(.*?)</entry>',s,re.S)[:maxn]:
        t=re.search(r'<title>(.*?)</title>',e,re.S)
        d=re.search(r'<published>(.*?)</published>',e,re.S)
        v=re.search(r'<yt:videoId>(.*?)</yt:videoId>',e,re.S)
        g=re.search(r'<media:description>(.*?)</media:description>',e,re.S)
        summ=clean(g.group(1) if g else '')[:220]
        items.append({'id':v.group(1),'title':clean(t.group(1)),'url':'https://www.youtube.com/watch?v='+v.group(1),'publishedAt':d.group(1) if d else None,'audioUrl':None,'summary':summ})
    return {'source':source,'channelTitle':'Przeprogramowani','items':items}

now=datetime.datetime.now(datetime.timezone.utc).isoformat()
for fn,data in [
  ('youtube.json', parse_yt('research/youtube-feed.xml','youtube')),
  ('opanujai.json', parse_rss('research/feed-opanujai.xml','opanujai')),
  ('przeprogramowani.json', parse_rss('research/feed-przeprogramowani.xml','przeprogramowani')),
]:
    data['fetchedAt']=now
    json.dump(data,open('site/src/data/cache/'+fn,'w'),ensure_ascii=False,indent=1)
    print(fn,len(data['items']),'items')
EOF
