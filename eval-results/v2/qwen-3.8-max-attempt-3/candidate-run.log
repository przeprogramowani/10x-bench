import re, glob
files = glob.glob('src/**/*.astro', recursive=True)
def norm(line):
    m = re.match(r"(\s*import\s+\w+\s+from\s+')([^']+)('\s*;?\s*)$", line)
    if not m: return line
    path = m.group(2)
    base = re.sub(r"(?:\.(?:astro|tsx))+'*", "", path)
    base = base.replace("'", "")
    if base.endswith('components/Header'):
        base += '.tsx'
    elif base.endswith('layouts/Base') or '/components/' in base:
        base += '.astro'
    return m.group(1) + base + "';"
for f in files:
    lines = open(f).read().split('\n')
    out = [norm(l) if (l.strip().startswith('import ') and ('components/' in l or 'layouts/' in l)) else l for l in lines]
    txt='\n'.join(out)
    if txt != open(f).read():
        open(f,'w').write(txt); print('fixed',f)
EOF
