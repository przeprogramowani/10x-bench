import re
for f in ['research/podcast-opanujai.xml','research/podcast-przeprogramowani.xml']:
    t=open(f).read()
    ch=t[:t.find('<item>')]
    ti=re.search(r'<title>(?:<!\[CDATA\[)?(.*?)(?:\]\]>)?</title>',ch)
    de=re.search(r'<description>(?:<!\[CDATA\[)?(.*?)(?:\]\]>)?</description>',ch,re.S)
    au=re.search(r'<itunes:author>(?:<!\[CDATA\[)?(.*?)(?:\]\]>)?</itunes:author>',ch)
    print(f); print(' TITLE:',ti.group(1) if ti else None); print(' AUTHOR:',au.group(1) if au else None)
    print(' DESC:',(de.group(1)[:600] if de else None)); print('====')
EOF
