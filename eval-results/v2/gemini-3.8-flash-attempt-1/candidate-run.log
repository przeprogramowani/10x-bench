import { XMLParser } from "fast-xml-parser";

async function test() {
  const p = new XMLParser({ ignoreAttributes: false, attributeNamePrefix: "@_" });
  
  // Test YouTube
  const ytRes = await fetch("https://www.youtube.com/feeds/videos.xml?channel_id=UCb2Y3vMeD6N4WDt5Acw7Arw");
  const ytXml = await ytRes.text();
  const ytData = p.parse(ytXml);
  const ytEntries = ytData.feed?.entry || [];
  console.log("YT entries count:", ytEntries.length);
  if (ytEntries[0]) {
    console.log("YT entry 0:", {
      title: ytEntries[0].title,
      videoId: ytEntries[0]["yt:videoId"],
      published: ytEntries[0].published,
      link: ytEntries[0].link?.["@_href"]
    });
  }

  // Test Opanuj.AI
  const oaiRes = await fetch("https://anchor.fm/s/e2cb03d0/podcast/rss");
  const oaiXml = await oaiRes.text();
  const oaiData = p.parse(oaiXml);
  const oaiItems = oaiData.rss?.channel?.item || [];
  console.log("OAI items count:", oaiItems.length);
  if (oaiItems[0]) {
    console.log("OAI item 0:", {
      title: oaiItems[0].title,
      pubDate: oaiItems[0].pubDate,
      link: oaiItems[0].link,
      enclosure: oaiItems[0].enclosure?.["@_url"]
    });
  }

  // Test Przeprogramowani Podcast
  const ppRes = await fetch("https://anchor.fm/s/c72d808/podcast/rss");
  const ppXml = await ppRes.text();
  const ppData = p.parse(ppXml);
  const ppItems = ppData.rss?.channel?.item || [];
  console.log("PP items count:", ppItems.length);
  if (ppItems[0]) {
    console.log("PP item 0:", {
      title: ppItems[0].title,
      pubDate: ppItems[0].pubDate,
      link: ppItems[0].link,
      enclosure: ppItems[0].enclosure?.["@_url"]
    });
  }
}

test().catch(console.error);
