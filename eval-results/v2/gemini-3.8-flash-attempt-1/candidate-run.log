import urllib.request
import re

routes = [
    "/",
    "/o-nas",
    "/podcast",
    "/podcast/opanuj-ai",
    "/podcast/przeprogramowani",
    "/youtube",
    "/kursy"
]

print(f"{'Route':<25} | {'Code':<4} | {'H1 Count':<8} | {'Title':<45} | {'Canonical'}")
print("-" * 110)

for r in routes:
    url = f"http://localhost:4321{r}"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req) as resp:
        code = resp.getcode()
        html = resp.read().decode("utf-8")
        
        # Check H1
        h1s = re.findall(r'<h1[^>]*>(.*?)</h1>', html, re.DOTALL | re.IGNORECASE)
        h1_count = len(h1s)
        
        # Title
        titles = re.findall(r'<title[^>]*>(.*?)</title>', html, re.IGNORECASE)
        title = titles[0] if titles else "NO TITLE"
        
        # Canonical
        canonicals = re.findall(r'<link[^>]+rel=["\']canonical["\'][^>]+href=["\']([^"\']+)["\']', html, re.IGNORECASE)
        canonical = canonicals[0] if canonicals else "NO CANONICAL"
        
        # Og title
        og_titles = re.findall(r'<meta[^>]+property=["\']og:title["\'][^>]+content=["\']([^"\']+)["\']', html, re.IGNORECASE)
        og_title = og_titles[0] if og_titles else "NO OG:TITLE"
        
        print(f"{r:<25} | {code:<4} | {h1_count:<8} | {title[:43]:<45} | {canonical}")

EOF

