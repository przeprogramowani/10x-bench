import re
for f in ['research/rss-opanujai.xml','research/rss-przeprogramowani.xml','research/yt-feed.xml']:
    s=open(f, encoding='utf-8', errors='replace').read()
    ch=re.search(r'<title>(.*?)</title>', s, re.S)
    items=re.findall(r'<item>(.*?)</item>', s, re.S) or re.findall(r'<entry>(.*?)</entry>', s, re.S)
    print('==',f, '| channel:', ch.group(1)[:60], '| items:', len(items))
    for it in items[:3]:
        t=re.search(r'<title>(?:<!\[CDATA\[)?(.*?)(?:\]\]>)?</title>', it, re.S)
        d=re.search(r'<pubDate>(.*?)</pubDate>', it, re.S) or re.search(r'<published>(.*?)</published>', it, re.S)
        l=re.search(r'<link>(.*?)</link>', it, re.S)
        print('  -', (t.group(1)[:70] if t else '?'), '|', (d.group(1)[:25] if d else 'nodate'), '|', (l.group(1)[:60] if l else '?'))
EOF
