import('child_process').then(cp => {
  const p = cp.spawn('npx', ['wrangler', 'dev', '--config', 'dist/server/wrangler.json', '--port', '8788'], { stdio: 'pipe' });
  let started = false;
  p.stdout.on('data', async d => {
    const s = d.toString();
    if (s.includes('Ready on') || s.includes('http://localhost:8788')) {
      if (!started) {
        started = true;
        const res = await fetch('http://localhost:8788/');
        console.log('Wrangler port 8788 fetch status:', res.status);
        p.kill();
        process.exit(0);
      }
    }
  });
  p.stderr.on('data', d => console.error(d.toString()));
  setTimeout(() => {
    if (!started) {
      console.log('Timed out waiting for wrangler on 8788');
      p.kill();
      process.exit(0);
    }
  }, 6000);
});
"
