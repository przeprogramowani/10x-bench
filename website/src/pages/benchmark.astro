---
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import { readFileSync } from 'node:fs';
import manifest from '../../../benchmark/v2/manifest.json';
const render = async (name: string) => (await marked(readFileSync(new URL(`../../../benchmark/v2/${name}`, import.meta.url), 'utf8'))).replace(/<(\/?)h([1-5])(\b[^>]*)>/g, (_, closing, level, attributes) => `<${closing}h${Number(level) + 1}${attributes}>`);
const prompt = await render('prompt.md');
const assessment = await render('assessment.md');
---
<Layout title="10xBench V2 — Specification and Scoring" description="The complete V2 website task and transparent 100-point assessment: autonomous implementation within 60 minutes, real content and Cloudflare Workers readiness without deployment.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl md:text-4xl font-bold text-slate-100 mb-6">V2 Specification and Scoring</h1>
    <p class="text-slate-300 mb-4">Each candidate receives the full task and assessment below. It chooses its own implementation approach and has up to 60 minutes. Public deployment is not part of the task.</p>
    <p class="text-slate-400 mb-4">Scoring combines evaluator checks with explicit human review. Candidate self-verification is recorded separately. This initial scoring revision can change for future runs; each attempt retains its original specification.</p>
    <p class="text-slate-400 mb-8"><a href="/v1/benchmark" class="text-blue-400 underline">Read the preserved V1 methodology</a></p>
    <section class="mb-10"><h2 class="text-2xl font-bold mb-4">Complete candidate task (Polish)</h2><div class="prose max-w-none p-6 border border-slate-700 rounded-lg"><Fragment set:html={prompt} /></div></section>
    <section><h2 class="text-2xl font-bold mb-4">Public assessment — 100 points</h2><div class="prose max-w-none p-6 border border-slate-700 rounded-lg"><Fragment set:html={assessment} /></div></section>
    <p class="mt-8 text-xs text-slate-500 break-all">Specification revision: {manifest.revision}</p>
  </div>
</Layout>
<style is:global>
  html {
    background-color: #0f172a !important;
    color: #e2e8f0 !important;
  }

  body {
    background-color: #0f172a !important;
    color: #e2e8f0 !important;
  }

  .prose {
    color: #cbd5e1;
    background-color: transparent;
    overflow-wrap: anywhere;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    color: #f1f5f9;
    font-weight: 600;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose h1 {
    font-size: 2em;
  }

  .prose h2 {
    font-size: 1.5em;
  }

  .prose h3 {
    font-size: 1.25em;
  }

  .prose p {
    margin-bottom: 1em;
    line-height: 1.6;
    color: #cbd5e1;
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1em;
    padding-left: 2em;
  }

  .prose li {
    margin-bottom: 0.5em;
    color: #cbd5e1;
  }

  .prose code {
    background-color: #334155;
    border-radius: 0.375rem;
    padding: 0.2em 0.4em;
    font-family: monospace;
    font-size: 0.9em;
    color: #fca5a5;
  }

  .prose pre {
    background-color: #1e293b;
    color: #e2e8f0;
    padding: 1em;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1em;
  }

  .prose pre code {
    color: inherit;
    background-color: transparent;
    padding: 0;
  }

  .prose blockquote {
    border-left: 4px solid #3b82f6;
    padding-left: 1em;
    margin-left: 0;
    color: #cbd5e1;
    font-style: italic;
    background-color: #1e293b;
    padding: 0.5em 0 0.5em 1em;
  }

  .prose strong {
    font-weight: 600;
    color: #f1f5f9;
  }

  .prose em {
    font-style: italic;
    color: #cbd5e1;
  }

  .prose a {
    color: #60a5fa;
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .prose table {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1em;
  }

  .prose th,
  .prose td {
    border: 1px solid #475569;
    padding: 0.75em;
    text-align: left;
    color: #cbd5e1;
  }

  .prose th {
    background-color: #1e293b;
    font-weight: 600;
  }
</style>
