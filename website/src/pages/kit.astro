---
import Layout from '../layouts/Layout.astro';

const title = '10x-bench-kit | Private AI Benchmark';
const description =
  'An open-source template for running reproducible AI-agent evaluations on your own repositories. Compare quality, cost and runtime using tasks from your codebase.';

const problems = [
  {
    index: '01',
    title: 'Training-data overlap',
    body: 'Public benchmark tasks can appear in training data. A higher score may reflect a better model, familiarity with the test, or both.',
  },
  {
    index: '02',
    title: 'Generic tasks',
    body: 'Leaderboards use their own tasks and environments. Your team works in an existing product repo with internal conventions, dependencies and CI checks.',
  },
  {
    index: '03',
    title: 'Limited reproducibility',
    body: 'Published scores do not always include the prompts, environment, rubric and model settings required to reproduce the evaluation.',
  },
];

const values = [
  {
    title: 'A working repository from the start',
    body: 'Run <code>10x bench-kit init</code> to create a repository with tasks, an evaluation pool, configuration and CI workflows. The generated manifest records the template version.',
  },
  {
    title: 'Isolated trials',
    body: 'Each trial runs in a disposable container with a fresh copy of your base repo at a pinned commit. Evaluation assets are mounted only after the agent finishes.',
  },
  {
    title: 'Quality, cost and runtime',
    body: 'Score quality with static checks, hidden tests, e2e tests and an LLM judge, weighted per task. Each trial records its score, cost and wall-clock time in <code>result.json</code>.',
  },
  {
    title: 'Versioned comparisons',
    body: 'Each result records the template version, task hash, judge model and rubric version. Results are compared only within the same evaluation era.',
  },
  {
    title: 'Guided setup',
    body: 'Included skills guide setup and task authoring: <code>bench-wiring</code>, <code>bench-new-task</code>, <code>bench-build</code> and <code>bench-rubric</code>.',
  },
  {
    title: 'Defined update boundaries',
    body: 'The runtime updates atomically, changes to shared skills arrive as a diff for review, and updates do not modify your tasks or evaluation pool.',
  },
];

const lifecycle = [
  {
    step: '01',
    title: 'Workspace',
    body: 'The runner creates a fresh copy of your base repo at a pinned commit, applies the task overlay and starts with empty agent state.',
  },
  {
    step: '02',
    title: 'Execution',
    body: 'The agent runs <code>prompt.md</code> non-interactively under a fixed timeout.',
  },
  {
    step: '03',
    title: 'Metrics',
    body: 'An adapter writes OpenCode data to <code>metrics.json</code>, while the workspace changes are saved as <code>patch.diff</code>.',
  },
  {
    step: '04',
    title: 'Evaluation',
    body: 'The runner mounts the evaluation pool and runs static checks, tests, e2e checks and the LLM judge. Weights come from <code>task.yaml</code>.',
  },
  {
    step: '05',
    title: 'Artifact',
    body: '<code>result.json</code> records the score, metrics and evaluation versions used for the trial.',
  },
];

const requirements = [
  {
    title: 'GitHub Actions',
    body: 'Trials run as a model × task × trial matrix through <code>workflow_dispatch</code>. You select the models, tasks and number of trials for each run.',
  },
  {
    title: '10xCLI',
    body: 'The 10x CLI creates and updates the kit instance with <code>bench-kit init</code> and <code>bench-kit update</code>.',
  },
  {
    title: 'Model API keys',
    body: 'Keys for the models under evaluation, plus one for the judge model that scores rubric-based criteria.',
  },
  {
    title: 'A base repository',
    body: 'The product repository your tasks run against, pinned at a commit. Private repositories require a fine-grained token with read-only access to contents.',
  },
  {
    title: 'OpenCode as the runner',
    body: 'The kit currently runs agents through OpenCode. The template pins the OpenCode version used by each evaluation era.',
  },
  {
    title: 'Your evaluation inputs',
    body: 'Before the first run, add secrets, prepare evaluation assets and calibrate the rubrics. The bench-wiring skill runs the validation checks.',
  },
];

const quickstart = [
  {
    step: '01',
    title: 'Create the instance',
    body: 'Run the installer inside your product repository so it can register that repository as the first benchmark target.',
    code: '10x bench-kit init my-benchmark',
  },
  {
    step: '02',
    title: 'Open it in your coding agent',
    body: 'The installer places the benchmark skills where your selected agent can use them.',
  },
  {
    step: '03',
    title: 'Use bench-wiring',
    body: 'Ask the agent to configure model keys, the judge, repository access and the container image. The skill runs the validation checks.',
  },
  {
    step: '04',
    title: 'Add real tasks',
    body: 'Use bench-new-task and bench-build to turn representative work into tasks with hidden evaluation assets.',
  },
  {
    step: '05',
    title: 'Run the matrix',
    body: 'Start the bench-run workflow in GitHub Actions and select the models, tasks and number of trials.',
  },
];
---

<Layout title={title} description={description}>
  <div class="kit-backdrop" aria-hidden="true">
    <div class="kit-grid"></div>
    <div class="kit-glow"></div>
  </div>

  <div class="kit-page relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <section class="grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[1.08fr_0.92fr] lg:gap-16 lg:py-28">
      <div>
        <p class="kit-badge mb-7">
          <span class="h-1.5 w-1.5 rounded-full bg-lime-300"></span>
          Open source template
        </p>
        <h1 class="max-w-3xl text-4xl font-bold leading-[1.02] tracking-[-0.04em] text-stone-50 sm:text-5xl md:text-7xl">
          Compare AI coding models <span class="kit-accent-text">on your codebase.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-stone-300 md:text-xl">
          <strong class="font-semibold text-stone-100">10x-bench-kit</strong> creates a private, reproducible benchmark
          for your repositories, tasks and rubrics. Run the same work across models and compare quality, cost and runtime.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="https://github.com/przeprogramowani/10x-bench-kit"
            target="_blank"
            rel="noopener noreferrer"
            class="kit-btn-primary inline-flex items-center justify-center gap-2 rounded-md px-6 py-3 font-semibold"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.25 10.25 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
            </svg>
            View on GitHub
          </a>
          <a href="#how-it-works" class="kit-btn-secondary inline-flex items-center justify-center rounded-md px-6 py-3 font-semibold">
            See how a trial runs
          </a>
        </div>
      </div>

      <div class="kit-terminal overflow-hidden rounded-xl border border-stone-700/70 text-left">
        <div class="flex items-center justify-between border-b border-stone-700/70 bg-black/20 px-5 py-3.5">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-stone-600"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-stone-600"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-lime-400"></span>
          </div>
          <span class="text-xs font-mono text-stone-500">acme-bench / main</span>
        </div>
        <div class="overflow-x-auto p-5 font-mono text-sm leading-7 md:p-7">
          <p><span class="text-lime-300">$</span> <span class="text-stone-100">10x bench-kit init acme-bench</span></p>
          <p class="mt-3 text-stone-400"><span class="text-emerald-400">✓</span> benchmark instance created</p>
          <p class="text-stone-400"><span class="text-emerald-400">✓</span> base repository registered</p>
          <p class="text-stone-400"><span class="text-emerald-400">✓</span> agent skills installed</p>
          <p class="text-stone-400"><span class="text-emerald-400">✓</span> runner dependencies installed</p>
          <p class="mt-3 text-stone-500">Next: open acme-bench in your coding agent</p>
          <p class="text-stone-500">Ask it to use bench-wiring</p>
        </div>
      </div>
    </section>

    <div class="kit-proof-grid grid grid-cols-1 border-y border-stone-800 sm:grid-cols-3">
      <div><strong>Pinned baseline</strong><span>Same repository commit</span></div>
      <div><strong>Hidden checks</strong><span>Mounted after execution</span></div>
      <div><strong>Versioned output</strong><span>Comparable within an era</span></div>
    </div>

    <section class="py-20 md:py-28">
      <p class="kit-eyebrow">Why test locally</p>
      <h2 class="max-w-3xl text-3xl font-bold tracking-tight text-stone-50 md:text-5xl">Public benchmarks don't show which model fits your team</h2>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-400">
        A public leaderboard ranks models on its own tasks and environment. Your decision depends on how those models
        perform in your repositories, under your constraints.
      </p>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {problems.map((p) => (
          <article class="kit-card rounded-lg p-6 md:p-7">
            <span class="font-mono text-xs text-lime-300">{p.index}</span>
            <h3 class="mt-8 text-lg font-semibold text-stone-100">{p.title}</h3>
            <p class="mt-3 text-sm leading-6 text-stone-400">{p.body}</p>
          </article>
        ))}
      </div>
      <p class="mt-10 max-w-3xl border-l-2 border-lime-300 pl-5 text-lg font-medium leading-8 text-stone-200">
        Shortlist models with public benchmarks, then test the finalists on your own tasks.
      </p>
    </section>

    <section class="border-t border-stone-800 py-20 md:py-28">
      <p class="kit-eyebrow">What's included</p>
      <h2 class="max-w-3xl text-3xl font-bold tracking-tight text-stone-50 md:text-5xl">Start with the benchmark infrastructure in place</h2>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-400">
        We built 10x-bench-kit from the infrastructure behind <a href="/" class="text-lime-300 underline decoration-lime-300/30 hover:text-lime-200">10xBench</a>.
        The template includes the runner, evaluation flow, versioning and CI setup. Add tasks and criteria from your own work.
      </p>
      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-stone-800 bg-stone-800 md:grid-cols-2 lg:grid-cols-3">
        {values.map((v) => (
          <article class="bg-[#101513] p-6 md:p-7">
            <h3 class="text-base font-semibold text-stone-100">{v.title}</h3>
            <p class="mt-3 text-sm leading-6 text-stone-400" set:html={v.body} />
          </article>
        ))}
      </div>
    </section>

    <section id="how-it-works" class="scroll-mt-24 border-t border-stone-800 py-20 md:py-28">
      <p class="kit-eyebrow">How it works</p>
      <h2 class="text-3xl font-bold tracking-tight text-stone-50 md:text-5xl">What happens in each trial</h2>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-400">
        Each <span class="font-mono text-sm text-lime-300">model × task × trial</span> combination runs as a separate
        matrix job. Evaluation assets are added only after the agent has finished its work.
      </p>
      <ol class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-5">
        {lifecycle.map((s) => (
          <li class="kit-step rounded-lg border border-stone-800 p-5">
            <span class="font-mono text-xs text-lime-300">{s.step}</span>
            <h3 class="mt-8 text-base font-semibold text-stone-100">{s.title}</h3>
            <p class="mt-3 text-sm leading-6 text-stone-400" set:html={s.body} />
          </li>
        ))}
      </ol>
    </section>

    <section class="border-t border-stone-800 py-20 md:py-28">
      <p class="kit-eyebrow">Quickstart</p>
      <h2 class="text-3xl font-bold tracking-tight text-stone-50 md:text-5xl">Five steps to your first run</h2>
      <ol class="mt-12 grid overflow-hidden rounded-lg border border-stone-800 bg-stone-800 lg:grid-cols-5 lg:gap-px">
        {quickstart.map((item) => (
          <li class="border-b border-stone-800 bg-[#101513] p-6 last:border-b-0 lg:min-h-64 lg:border-b-0">
            <span class="font-mono text-xs text-lime-300">{item.step}</span>
            <h3 class="mt-7 text-base font-semibold text-stone-100">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-stone-400">{item.body}</p>
            {item.code && <code class="mt-5 block overflow-x-auto whitespace-nowrap">{item.code}</code>}
          </li>
        ))}
      </ol>
    </section>

    <section class="border-t border-stone-800 py-20 md:py-28">
      <p class="kit-eyebrow">Updates</p>
      <h2 class="text-3xl font-bold tracking-tight text-stone-50 md:text-5xl">Engine separated from execution</h2>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-400">
        The instance separates kit-owned files, shared skills and company-owned evaluation assets.
        <code>bench-kit update</code> handles each group differently:
      </p>
      <div class="mt-12 overflow-hidden rounded-lg border border-stone-800 bg-[#101513]">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-stone-800 bg-white/[0.02] text-left">
                <th class="px-6 py-4 font-semibold text-stone-300">Zone</th>
                <th class="px-6 py-4 font-semibold text-stone-300">Owner</th>
                <th class="px-6 py-4 font-semibold text-stone-300">On update</th>
              </tr>
            </thead>
            <tbody class="text-stone-400">
              <tr class="border-b border-stone-800">
                <td class="whitespace-nowrap px-6 py-5 font-mono text-lime-300">.bench-kit/</td>
                <td class="px-6 py-4">the kit</td>
                <td class="px-6 py-4">replaced atomically with the updated runner, container and workflows</td>
              </tr>
              <tr class="border-b border-stone-800">
                <td class="whitespace-nowrap px-6 py-5 font-mono text-lime-300">.agents/skills/</td>
                <td class="px-6 py-4">shared</td>
                <td class="px-6 py-4">proposed as a diff for your team to review</td>
              </tr>
              <tr>
                <td class="whitespace-nowrap px-6 py-5 font-mono text-lime-300">tasks/ · evaluation-pool/ · bench.config.yaml</td>
                <td class="px-6 py-4">your company</td>
                <td class="px-6 py-4">left unchanged by the updater</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="grid gap-12 border-t border-stone-800 py-20 md:py-28 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="kit-eyebrow">What you need</p>
        <h2 class="text-3xl font-bold tracking-tight text-stone-50 md:text-5xl">Before you run the kit</h2>
        <p class="mt-5 max-w-md text-lg leading-8 text-stone-400">Prepare the repository, credentials and evaluation inputs once. The validation command checks them before the first run.</p>
      </div>
      <div class="grid gap-x-10 gap-y-8 md:grid-cols-2">
        {requirements.map((r) => (
          <div class="flex gap-4">
            <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-lime-300/40 bg-lime-300/10 text-[10px] text-lime-300" aria-hidden="true">✓</span>
            <div>
              <h3 class="font-semibold text-stone-100">{r.title}</h3>
              <p class="mt-2 text-sm leading-6 text-stone-400" set:html={r.body} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12 flex flex-col gap-8 rounded-xl border border-stone-700 bg-[#141a17] p-8 md:mb-20 md:flex-row md:items-center md:justify-between md:p-12">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-stone-50 md:text-4xl">Run your first comparison</h2>
        <p class="mt-3 max-w-xl text-base leading-7 text-stone-400">Create an instance, add one representative task and compare the models your team is considering.</p>
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
        <a href="https://github.com/przeprogramowani/10x-bench-kit" target="_blank" rel="noopener noreferrer" class="kit-btn-primary inline-flex items-center justify-center rounded-md px-6 py-3 font-semibold">Get the kit</a>
        <a href="https://10xdevs.pl" target="_blank" rel="noopener noreferrer" class="kit-btn-secondary inline-flex items-center justify-center rounded-md px-6 py-3 font-semibold">10xDevs &#8599;</a>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
  html,
  body {
    background-color: #0b0f0e !important;
    color: #e7e5e4 !important;
  }

  main {
    background-color: transparent !important;
    padding-bottom: 0 !important;
    padding-top: 0 !important;
    position: relative;
  }

  nav,
  #mobile-menu,
  footer {
    background-color: rgba(11, 15, 14, 0.94) !important;
    border-color: rgba(120, 113, 108, 0.25) !important;
    position: relative;
    z-index: 20;
  }

  .kit-page code {
    background-color: rgba(190, 242, 100, 0.09);
    color: #bef264;
    border-radius: 0.25rem;
    padding: 0.15em 0.4em;
    font-size: 0.85em;
  }

  .kit-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .kit-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(231, 229, 228, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(231, 229, 228, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 38%);
  }

  .kit-glow {
    position: absolute;
    top: -28rem;
    left: 50%;
    height: 48rem;
    width: 72rem;
    transform: translateX(-50%);
    border-radius: 9999px;
    background: rgba(52, 211, 153, 0.09);
    filter: blur(110px);
  }

  .kit-accent-text {
    color: #bef264;
  }

  .kit-badge {
    align-items: center;
    background: rgba(190, 242, 100, 0.06);
    border: 1px solid rgba(190, 242, 100, 0.22);
    border-radius: 9999px;
    color: #d9f99d;
    display: inline-flex;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 600;
    gap: 0.5rem;
    letter-spacing: 0.06em;
    padding: 0.45rem 0.75rem;
    text-transform: uppercase;
  }

  .kit-eyebrow {
    color: #a3e635;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .kit-card {
    background: #101513;
    border: 1px solid rgba(120, 113, 108, 0.25);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .kit-card:hover {
    background: #131a17;
    border-color: rgba(190, 242, 100, 0.35);
  }

  .kit-proof-grid > div {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.4rem 1.5rem;
  }

  .kit-proof-grid > div + div {
    border-top: 1px solid rgb(41 37 36);
  }

  .kit-proof-grid strong {
    color: #e7e5e4;
    font-size: 0.875rem;
  }

  .kit-proof-grid span {
    color: #78716c;
    font-size: 0.75rem;
  }

  .kit-step {
    background: rgba(16, 21, 19, 0.7);
  }

  .kit-terminal {
    background: rgba(13, 18, 16, 0.94);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
  }

  .kit-btn-primary {
    background: #bef264;
    color: #17200e;
    transition: background-color 0.2s ease;
  }

  .kit-btn-primary:hover {
    background: #d9f99d;
  }

  .kit-btn-secondary {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(168, 162, 158, 0.35);
    color: #d6d3d1;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .kit-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(214, 211, 209, 0.55);
  }

  @media (min-width: 640px) {
    .kit-proof-grid > div + div {
      border-left: 1px solid rgb(41 37 36);
      border-top: 0;
    }
  }
</style>
