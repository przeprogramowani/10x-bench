{
  "name": "10x-bench",
  "version": "1.0.0",
  "description": "Benchmark for various LLMs vibe coding Przeprogramowani.pl website",
  "type": "module",
  "scripts": {
    "process-results": "npm run verify:v1 && npm run verify:benchmark && tsx scripts/process-results.ts",
    "calculate-cost": "tsx scripts/calculate-cost.ts",
    "dev": "npm run process-results && cd website && npm run dev",
    "build": "npm run process-results && cd website && npm run build",
    "screenshots": "tsx scripts/take-screenshots.ts",
    "verify:v1": "node --import tsx scripts/verify-v1.ts",
    "verify:benchmark": "node --import tsx scripts/verify-benchmark.ts",
    "sync:benchmark": "node --import tsx scripts/sync-benchmark.ts",
    "test:v2": "node --import tsx --test scripts/process-v2.test.ts scripts/workflow-v2.test.ts"
  },
  "keywords": [
    "benchmark",
    "llm",
    "przeprogramowani"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "25.2.2",
    "autoprefixer": "^10.5.0",
    "playwright": "^1.50.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/tailwind": "^6.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
